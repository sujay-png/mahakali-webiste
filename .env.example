# =============================================================================
# Mahakali Home Furnitures — environment placeholders
# Copy this file to `.env` and fill in real values. Never commit secrets.
# =============================================================================

# --- Site ---
PUBLIC_SITE_URL=
PUBLIC_WHATSAPP_NUMBER=

# --- WooCommerce store ---
# Base URL of the WordPress/WooCommerce site (no trailing slash).
# Used server-side to fetch catalog data.
WOOCOMMERCE_URL=

# WooCommerce REST API v3 credentials
# WooCommerce → Settings → Advanced → REST API → Add key
# Permissions: Read
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=

# Optional public alias if the storefront URL differs from the API host
# (usually leave blank — WOOCOMMERCE_URL is enough).
PUBLIC_WOOCOMMERCE_URL=

# Cache WooCommerce responses in memory (seconds). 0 disables caching.
WOOCOMMERCE_CACHE_SECONDS=120

# Request timeout for WooCommerce fetches (milliseconds)
WOOCOMMERCE_TIMEOUT_MS=15000

# --- Email Option 1: Web3Forms (Recommended - No DNS records required) ---
# Create free access key at https://web3forms.com
WEB3FORMS_ACCESS_KEY=
# --- Email Option 2: Resend (Requires verified custom domain or matching signup email) ---
RESEND_API_KEY=
CONTACT_EMAIL_TO=
CONTACT_EMAIL_FROM=
