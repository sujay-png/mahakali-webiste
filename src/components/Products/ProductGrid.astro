---
import ProductCard from "./ProductCard.astro";

export interface Props {
  products: {
    name: string;
    price: string;
    stars: number;
    image: string;
    link: string;
  }[];
}

const { products } = Astro.props;
---

<section class="product-grid-section">
  <div class="wrap grid-container" id="product-grid">
    {products.map((product) => <ProductCard {...product} />)}
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const grid = document.getElementById('product-grid');
      if (!grid) return;
      
      const cards = Array.from(grid.querySelectorAll('.product-card')) as HTMLElement[];
      const searchInput = document.getElementById('product-search-input') as HTMLInputElement;
      const sortSelect = document.getElementById('product-sort-select') as HTMLSelectElement;
      const sidebarCategories = document.querySelectorAll('#sidebar-categories .category-item');
      const toolbarCategories = document.querySelectorAll('#toolbar-categories .pill');
      const resultsCount = document.querySelector('.results-count');
      
      let currentCategory = 'all';
      let currentSearch = '';
      let currentSort = 'default';
      
      // Store original order
      cards.forEach((card, i) => card.dataset.order = i.toString());
      
      function filterAndSort() {
        let visibleCount = 0;
        
        const filteredCards = cards.filter(card => {
          const name = card.dataset.name || '';
          const category = card.dataset.category || '';
          
          const matchesSearch = name.includes(currentSearch.toLowerCase());
          const matchesCategory = currentCategory === 'all' || category.includes(currentCategory);
          
          const isVisible = matchesSearch && matchesCategory;
          
          if (isVisible) {
            card.style.display = 'flex';
            visibleCount++;
          } else {
            card.style.display = 'none';
          }
          return isVisible;
        });
        
        // Sorting
        if (currentSort === 'price-asc') {
          filteredCards.sort((a, b) => parseFloat(a.dataset.price || '0') - parseFloat(b.dataset.price || '0'));
        } else if (currentSort === 'price-desc') {
          filteredCards.sort((a, b) => parseFloat(b.dataset.price || '0') - parseFloat(a.dataset.price || '0'));
        } else {
          // default order
          filteredCards.sort((a, b) => parseInt(a.dataset.order || '0') - parseInt(b.dataset.order || '0'));
        }
        
        // Re-append to grid
        filteredCards.forEach(card => grid?.appendChild(card));
        
        if (resultsCount) {
          resultsCount.textContent = `(${visibleCount} Results)`;
        }
      }
      
      if (searchInput) {
        searchInput.addEventListener('input', (e) => {
          currentSearch = (e.target as HTMLInputElement).value;
          filterAndSort();
        });
      }
      
      if (sortSelect) {
        sortSelect.addEventListener('change', (e) => {
          currentSort = (e.target as HTMLSelectElement).value;
          filterAndSort();
        });
      }
      
      function handleCategoryClick(catElement: Element, allElements: NodeListOf<Element>, isSidebar: boolean) {
        catElement.addEventListener('click', () => {
          const cat = (catElement as HTMLElement).dataset.category || 'all';
          
          if (currentCategory === cat && !isSidebar) {
             currentCategory = 'all';
             allElements.forEach(el => el.classList.remove('active'));
          } else {
             currentCategory = cat;
             allElements.forEach(el => {
               if (el === catElement) {
                 el.classList.add('active');
               } else {
                 el.classList.remove('active');
               }
             });
             
             const otherList = isSidebar ? toolbarCategories : sidebarCategories;
             otherList.forEach(el => {
               if ((el as HTMLElement).dataset.category === cat) {
                 el.classList.add('active');
               } else {
                 el.classList.remove('active');
               }
             });
          }
          
          filterAndSort();
        });
      }
      
      sidebarCategories.forEach(cat => handleCategoryClick(cat, sidebarCategories, true));
      toolbarCategories.forEach(cat => handleCategoryClick(cat, toolbarCategories, false));
    });
  </script>

  <div class="pagination-container">
    <button class="load-more-btn">Load More Products</button>
  </div>
</section>

<style>
  .product-grid-section {
    padding-block: 4rem; /* section-gap */
  }

  .grid-container {
    display: grid;
    grid-template-columns: 1fr;
    gap: 4rem 2rem; /* gap-y-16 gap-x-8 */
  }

  @media (min-width: 768px) {
    .grid-container {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1280px) {
    .grid-container {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .pagination-container {
    display: flex;
    justify-content: center;
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(226, 191, 185, 0.4);
  }

  .load-more-btn {
    color: #570000;
    font-family: var(--font-nav);
    font-size: 0.875rem;
    font-weight: 600;
    background: none;
    border: none;
    border-bottom: 1px solid #570000;
    padding-bottom: 0.25rem;
    cursor: pointer;
    transition: opacity 0.2s ease;
  }

  .load-more-btn:hover {
    opacity: 0.8;
  }
</style>
