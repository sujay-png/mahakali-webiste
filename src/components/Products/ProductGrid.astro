---
import ProductCard from "./ProductCard.astro";
import type { ProductCardModel } from "../../lib/woocommerce/types";

export interface Props {
  products: ProductCardModel[];
  emptyTitle?: string;
  emptyCopy?: string;
}

const {
  products,
  emptyTitle = "This collection is between seasons",
  emptyCopy = "Add your WooCommerce keys in .env and the live catalog will appear here automatically.",
} = Astro.props;
---

<section class="product-grid-section">
  {products.length === 0 ? (
    <div class="empty">
      <p class="empty-kicker">Showroom note</p>
      <h3 class="font-display">{emptyTitle}</h3>
      <p>{emptyCopy}</p>
      <a href="/contact" class="btn btn-primary">Talk to the showroom</a>
    </div>
  ) : (
    <div class="grid-container" id="product-grid">
      {products.map((product) => <ProductCard {...product} />)}
    </div>
  )}
</section>

<script>
  function bindCatalogFilters() {
    const grid = document.getElementById("product-grid");
    if (!grid) return;

    const cards = Array.from(grid.querySelectorAll(".product-card")) as HTMLElement[];
    const searchInput = document.getElementById("product-search-input") as HTMLInputElement | null;
    const sortSelect = document.getElementById("product-sort-select") as HTMLSelectElement | null;
    const resultsCount = document.querySelector(".results-count");

    cards.forEach((card, i) => (card.dataset.order = String(i)));

    function apply() {
      const query = (searchInput?.value || "").toLowerCase();
      const sort = sortSelect?.value || "default";
      let visible = 0;

      const filtered = cards.filter((card) => {
        const match = (card.dataset.name || "").includes(query);
        card.hidden = !match;
        if (match) visible += 1;
        return match;
      });

      filtered.sort((a, b) => {
        const pa = parseFloat(a.dataset.price || "0");
        const pb = parseFloat(b.dataset.price || "0");
        if (sort === "price-asc") return pa - pb;
        if (sort === "price-desc") return pb - pa;
        return parseInt(a.dataset.order || "0", 10) - parseInt(b.dataset.order || "0", 10);
      });

      filtered.forEach((card) => grid.appendChild(card));
      if (resultsCount) resultsCount.textContent = `(${visible} pieces)`;
    }

    searchInput?.addEventListener("input", apply);
    sortSelect?.addEventListener("change", apply);
  }

  bindCatalogFilters();
  document.addEventListener("astro:page-load", bindCatalogFilters);
</script>

<style>
  .product-grid-section { padding-block: 1.5rem 4rem; }

  .grid-container {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem 1.6rem;
    padding-inline: 0;
  }

  @media (min-width: 768px) {
    .grid-container { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1200px) {
    .grid-container { grid-template-columns: repeat(3, 1fr); }
  }

  .empty {
    text-align: center;
    padding: 3.5rem 1.5rem;
    background: #fff;
    border: 1px solid rgba(226, 191, 185, 0.35);
    border-radius: 20px;
  }
  .empty-kicker {
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-size: 0.75rem;
    font-weight: 700;
    color: #7c5730;
    margin-bottom: 0.6rem;
  }
  .empty h3 { margin-bottom: 0.7rem; color: #570000; }
  .empty p { color: #5a413d; max-width: 36rem; margin: 0 auto 1.5rem; }
</style>
