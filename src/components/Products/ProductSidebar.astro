---
import Icon from "../global/UI/Icon.astro";

const categories = [
  { name: "UPHOLSTERED", count: 61, uppercase: true },
  { name: "WOODEN SOFA", count: 15, uppercase: true },
  { name: "WOODEN COT", count: 20, uppercase: true },
  { name: "WOODEN JOOLA", count: 2, uppercase: true },
  { name: "WOODEN DINING 5/3", count: 1, uppercase: true },
  { name: "TEPOY", count: 36, uppercase: true },
  { name: "CUSHION CHAIRS", count: 10, uppercase: true },
  { name: "Wooden furniture", count: 1, uppercase: false }
];
---

<aside class="product-sidebar">
  <!-- Search Widget -->
  <div class="widget">
    <h4 class="widget-title">Search</h4>
    <div class="search-input-wrap">
      <input type="text" placeholder="Search" class="search-input" id="product-search-input" />
      <Icon name="search" class="search-icon" />
    </div>
  </div>

  <!-- Category Widget -->
  <div class="widget">
    <h4 class="widget-title">Category</h4>
    <ul class="category-list" id="sidebar-categories">
      {categories.map((cat) => (
        <li class="category-item group" data-category={cat.name.toLowerCase()}>
          <span class={`cat-name ${cat.uppercase ? 'uppercase' : ''}`}>{cat.name}</span>
          <span class="cat-count">({cat.count})</span>
        </li>
      ))}
    </ul>
  </div>
</aside>

<style>
  .product-sidebar {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 768px) and (max-width: 1023px) {
    .product-sidebar {
      grid-template-columns: 1fr 1fr;
      gap: 1.5rem;
    }
  }

  .widget {
    background-color: #ffffff; /* surface-container-lowest */
    padding: 1.5rem;
    border-radius: 0.75rem;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
    border: 1px solid rgba(226, 191, 185, 0.2); /* outline-variant */
  }

  .widget-title {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1.33;
    color: #1c1b1b;
    margin-bottom: 1rem;
  }

  .search-input-wrap {
    position: relative;
  }

  .search-input {
    width: 100%;
    background: transparent;
    border: 1px solid rgba(226, 191, 185, 0.3);
    border-radius: 0.5rem;
    padding: 0.75rem 1rem;
    padding-right: 2.5rem;
    font-family: var(--font-body);
    font-size: 1rem;
    color: #1c1b1b;
    outline: none;
    transition: border-color 0.2s ease;
  }

  .search-input:focus {
    border-color: #570000;
  }

  :global(.search-icon) {
    position: absolute;
    right: 0.75rem;
    top: 50%;
    transform: translateY(-50%);
    width: 20px;
    height: 20px;
    color: #570000; /* primary */
    pointer-events: none;
    stroke-width: 2;
  }

  .category-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .category-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
  }

  .cat-name {
    font-family: var(--font-body); /* Manrope */
    font-size: 0.875rem; /* 14px */
    font-weight: 600;
    letter-spacing: 0.05em;
    color: #5a413d; /* on-surface-variant */
    transition: color 0.2s ease;
    line-height: 1.4;
  }
  
  .cat-name.uppercase {
    text-transform: uppercase;
  }

  .category-item:hover .cat-name {
    color: #570000; /* primary */
  }

  .cat-count {
    font-family: var(--font-body);
    font-size: 0.875rem;
    color: rgba(90, 65, 61, 0.6); /* on-surface-variant */
    flex-shrink: 0;
  }
</style>
