---
import Icon from "../global/UI/Icon.astro";
import { CATALOG_CATEGORIES, categoryPath } from "../../lib/woocommerce/categories";

export interface Props {
  counts?: Record<number, number>;
  activeSlug?: string;
}

const { counts = {}, activeSlug } = Astro.props;
---

<button class="filter-toggle" type="button" aria-expanded="false" aria-controls="product-filter-panel">
  <Icon name="filter" />
  <span>Filter</span>
</button>

<aside class="product-sidebar" id="product-filter-panel">
  <button class="filter-close" type="button" aria-label="Close filters">Close</button>
  <div class="widget">
    <p class="eyebrow">Look up</p>
    <h4 class="widget-title font-display">Search this page</h4>
    <div class="search-input-wrap">
      <input type="text" placeholder="Search by name" class="search-input" id="product-search-input" />
      <Icon name="search" class="search-icon" />
    </div>
  </div>

  <div class="widget">
    <p class="eyebrow">Atelier</p>
    <h4 class="widget-title font-display">Collections</h4>
    <ul class="category-list">
      <li>
        <a href="/products" class={`category-item ${!activeSlug ? "is-active" : ""}`}>
          <span class="cat-name">All collections</span>
        </a>
      </li>
      {CATALOG_CATEGORIES.map((cat) => (
        <li>
          <a
            href={categoryPath(cat.slug)}
            class={`category-item ${activeSlug === cat.slug ? "is-active" : ""}`}
          >
            <span class="cat-name">{cat.navLabel}</span>
            <span class="cat-count">{counts[cat.id] ?? "—"}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</aside>

<style>
  .product-sidebar { display: grid; gap: 3rem; }
  .filter-toggle, .filter-close { display: none; }
  .widget-title { font-size: 1.7rem; margin: 0.7rem 0 1.2rem; }
  .search-input-wrap { position: relative; }
  .search-input {
    width: 100%;
    background: transparent;
    border: none;
    border-bottom: 1px solid var(--color-line);
    padding: 0.75rem 2rem 0.75rem 0;
    outline: none;
  }
  .search-input:focus { border-bottom-color: var(--color-ink); }
  :global(.search-icon) {
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 16px;
    height: 16px;
    color: var(--color-gold);
    pointer-events: none;
  }
  .category-list { display: flex; flex-direction: column; }
  .category-item {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem;
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--color-line);
    color: var(--color-ink-soft);
  }
  .category-item:hover,
  .category-item.is-active { color: var(--color-ink); }
  .category-item.is-active .cat-name { font-style: italic; font-family: var(--font-display); font-size: 1.15rem; }
  .cat-name { font-size: 0.92rem; }
  .cat-count { font-size: 0.72rem; letter-spacing: 0.12em; }

  @media (max-width: 1023px) {
    .filter-toggle {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.55rem;
      width: 100%;
      padding: 0.85rem 1rem;
      border: 1px solid var(--color-line);
      background: var(--color-surface);
      color: var(--color-ink);
      font-size: 0.72rem;
      font-weight: 500;
      letter-spacing: 0.14em;
      text-transform: uppercase;
    }
    :global(.filter-toggle svg) { width: 16px; height: 16px; }
    .product-sidebar {
      display: none;
      position: fixed;
      inset: 0 auto 0 0;
      z-index: 90;
      width: min(88vw, 360px);
      overflow-y: auto;
      padding: 1.5rem;
      background: var(--color-surface);
      box-shadow: 12px 0 40px rgba(36,28,24,0.16);
    }
    .product-sidebar.is-open { display: grid; align-content: start; }
    .filter-close {
      display: block;
      justify-self: end;
      margin-bottom: 0.5rem;
      padding: 0.4rem 0;
      color: var(--color-ink-soft);
      font-size: 0.68rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
    }
  }
</style>

<script>
  function bindProductFilters() {
    const toggle = document.querySelector<HTMLButtonElement>(".filter-toggle");
    const panel = document.querySelector<HTMLElement>("#product-filter-panel");
    const close = document.querySelector<HTMLButtonElement>(".filter-close");
    if (!toggle || !panel || toggle.dataset.bound === "true") return;
    toggle.dataset.bound = "true";
    const setOpen = (open: boolean) => {
      panel.classList.toggle("is-open", open);
      toggle.setAttribute("aria-expanded", String(open));
      document.body.style.overflow = open ? "hidden" : "";
    };
    toggle.addEventListener("click", () => setOpen(true));
    close?.addEventListener("click", () => setOpen(false));
  }

  bindProductFilters();
  document.addEventListener("astro:page-load", bindProductFilters);
</script>
