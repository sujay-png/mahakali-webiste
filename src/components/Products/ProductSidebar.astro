---
import Icon from "../global/UI/Icon.astro";
import { CATALOG_CATEGORIES, categoryPath } from "../../lib/woocommerce/categories";

export interface Props {
  counts?: Record<number, number>;
  activeSlug?: string;
}

const { counts = {}, activeSlug } = Astro.props;
---

<aside class="product-sidebar">
  <div class="widget">
    <h4 class="widget-title">Search this page</h4>
    <div class="search-input-wrap">
      <input type="text" placeholder="Search by name" class="search-input" id="product-search-input" />
      <Icon name="search" class="search-icon" />
    </div>
  </div>

  <div class="widget">
    <h4 class="widget-title">Collections</h4>
    <ul class="category-list">
      <li>
        <a href="/products" class={`category-item ${!activeSlug ? "is-active" : ""}`}>
          <span class="cat-name">All collections</span>
        </a>
      </li>
      {CATALOG_CATEGORIES.map((cat) => (
        <li>
          <a
            href={categoryPath(cat.slug)}
            class={`category-item ${activeSlug === cat.slug ? "is-active" : ""}`}
          >
            <span class="cat-name">{cat.navLabel}</span>
            <span class="cat-count">({counts[cat.id] ?? "—"})</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</aside>

<style>
  .product-sidebar { display: grid; gap: 1.25rem; }

  .widget {
    background: #fff;
    padding: 1.4rem;
    border-radius: 16px;
    border: 1px solid rgba(226, 191, 185, 0.28);
    box-shadow: 0 8px 24px rgba(44, 22, 0, 0.04);
  }

  .widget-title {
    font-family: var(--font-display);
    font-size: 1.35rem;
    margin-bottom: 0.9rem;
  }

  .search-input-wrap { position: relative; }

  .search-input {
    width: 100%;
    background: transparent;
    border: 1px solid rgba(226, 191, 185, 0.45);
    border-radius: 10px;
    padding: 0.75rem 1rem;
    padding-right: 2.5rem;
    outline: none;
  }
  .search-input:focus { border-color: #570000; }

  :global(.search-icon) {
    position: absolute;
    right: 0.75rem;
    top: 50%;
    transform: translateY(-50%);
    width: 18px;
    height: 18px;
    color: #570000;
    pointer-events: none;
  }

  .category-list { display: flex; flex-direction: column; gap: 0.15rem; }

  .category-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 0.4rem;
    border-radius: 8px;
    color: #5a413d;
  }
  .category-item:hover,
  .category-item.is-active {
    background: rgba(87, 0, 0, 0.05);
    color: #570000;
  }

  .cat-name {
    font-size: 0.86rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }
  .cat-count { font-size: 0.8rem; opacity: 0.7; }
</style>
