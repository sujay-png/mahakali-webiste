---
export interface Props {
  label: string;
  title: string;
  description: string;
  image: string;
}

const { label, title, description, image } = Astro.props;
---

<section class="collection-hero" style={`background-image: url('${image}')`}>
  <div class="overlay"></div>
  <div class="wrap hero-content">
    <span class="hero-label">{label}</span>
    <h1 class="font-display hero-title">{title}</h1>
    <p class="hero-description">{description}</p>
  </div>
</section>

<style>
  .collection-hero {
    position: relative;
    height: 60vh;
    min-height: 400px;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-size: cover;
    background-position: center;
    overflow: hidden;
    background-color: #f0eded; /* surface-container fallback */
  }

  @media (min-width: 768px) {
    .collection-hero {
      height: 70vh;
      min-height: 500px;
    }
  }

  .overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.6), rgba(0, 0, 0, 0.2), transparent);
    z-index: 1;
  }

  .hero-content {
    position: relative;
    z-index: 10;
    text-align: center;
    padding-inline: 1.5rem;
    max-width: 56rem;
    margin: 0 auto;
    margin-top: 3rem;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero-label {
    display: block;
    font-family: var(--font-nav);
    font-size: 0.875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #eae7e7; /* surface-container-high */
    margin-bottom: 1rem;
  }

  .hero-title {
    font-size: 2.5rem;
    line-height: 1.2;
    color: #ffffff;
    margin-bottom: 1.5rem;
    text-shadow: 0 4px 6px rgba(0, 0, 0, 0.3);
  }

  @media (min-width: 768px) {
    .hero-title {
      font-size: 3.5rem;
    }
  }

  .hero-description {
    font-family: var(--font-body);
    font-size: 1.125rem;
    line-height: 1.6;
    color: #f0eded; /* surface-container */
    max-width: 42rem;
    margin: 0 auto;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.2);
  }
</style>
