---
export interface Props {
  label: string;
  title: string;
  description: string;
  image: string;
}
const { label, title, description, image } = Astro.props;
---

<section class="page-hero" aria-label={title}>
  <img src={image} alt="" />
  <div class="veil"></div>
  <div class="wrap copy">
    <p class="eyebrow light">{label}</p>
    <h1>{title}</h1>
    <p>{description}</p>
  </div>
</section>
