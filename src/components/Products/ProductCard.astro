---
import Icon from "../global/UI/Icon.astro";

export interface Props {
  name: string;
  price: string;
  stars: number;
  image: string;
  link: string;
  category?: string;
  regularPrice?: string;
  onSale?: boolean;
}

const {
  name,
  price,
  stars,
  image,
  link,
  category = "",
  regularPrice,
  onSale = false,
} = Astro.props;

const fullStars = Math.floor(stars);
const hasHalfStar = stars % 1 !== 0;
const emptyStars = Math.max(0, 5 - Math.ceil(stars));
const numericPrice = Number(String(price).replace(/[^0-9.-]+/g, "")) || 0;
---

<a
  href={link}
  class="product-card"
  data-name={name.toLowerCase()}
  data-price={numericPrice}
  data-category={category.toLowerCase()}
>
  <div class="card-image-container" data-media>
    <img src={image} alt={name} class="card-image" loading="lazy" />
    {onSale && <span class="sale-chip">Sale</span>}
    <span class="quick-view-btn">View piece</span>
  </div>

  <div class="card-info">
    <div class="card-details">
      {category && <p class="product-cat">{category}</p>}
      <h3 class="product-name font-display">{name}</h3>
      <div class="star-rating" aria-label={`${stars} out of 5`}>
        {
          Array.from({ length: fullStars }).map(() => (
            <Icon name="star-filled" class="star-icon" />
          ))
        }
        {hasHalfStar && <Icon name="star-half" class="star-icon" />}
        {
          Array.from({ length: emptyStars }).map(() => (
            <Icon name="star" class="star-icon" />
          ))
        }
      </div>
    </div>
    <div class="price-stack">
      <span class="product-price">{price}</span>
      {regularPrice && onSale && <s class="was">{regularPrice}</s>}
    </div>
  </div>
</a>

<style>
  .product-card {
    display: flex;
    flex-direction: column;
    color: inherit;
  }
  .product-card:hover .quick-view-btn {
    opacity: 1;
    transform: translateY(0);
  }

  .card-image-container {
    position: relative;
    aspect-ratio: 4/5;
    background: var(--color-cream);
    margin-bottom: 1.25rem;
    overflow: hidden;
  }

  .sale-chip {
    position: absolute;
    top: 1rem;
    left: 1rem;
    z-index: 2;
    background: var(--color-primary);
    color: #fff;
    font-size: 0.62rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    padding: 0.35rem 0.7rem;
  }

  .quick-view-btn {
    position: absolute;
    bottom: 1.1rem;
    left: 1.1rem;
    opacity: 0;
    transform: translateY(8px);
    background: var(--color-surface);
    color: var(--color-ink);
    padding: 0.65rem 1.1rem;
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    transition:
      opacity 0.45s var(--ease),
      transform 0.45s var(--ease);
  }

  .card-info {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
  }

  .product-cat {
    font-size: 0.66rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-gold);
    margin-bottom: 0.4rem;
  }

  .product-name {
    font-size: 1.55rem;
    color: var(--color-ink);
    margin-bottom: 0.4rem;
    max-width: 16ch;
  }

  .star-rating {
    display: flex;
    color: var(--color-gold);
    gap: 2px;
  }
  :global(.star-icon) {
    width: 13px;
    height: 13px;
  }

  .price-stack {
    text-align: right;
  }
  .product-price {
    display: block;
    font-size: 0.82rem;
    letter-spacing: 0.06em;
    font-weight: 500;
    color: var(--color-primary);
  }
  .was {
    display: block;
    margin-top: 0.15rem;
    font-size: 0.75rem;
    color: var(--color-ink-soft);
  }
</style>
