---
import Icon from "../global/UI/Icon.astro";

export interface Props {
  name: string;
  price: string;
  stars: number;
  image: string;
  link: string;
  category?: string;
  regularPrice?: string;
  onSale?: boolean;
}

const {
  name,
  price,
  stars,
  image,
  link,
  category = "",
  regularPrice,
  onSale = false,
} = Astro.props;

const fullStars = Math.floor(stars);
const hasHalfStar = stars % 1 !== 0;
const emptyStars = Math.max(0, 5 - Math.ceil(stars));
const numericPrice = Number(String(price).replace(/[^0-9.-]+/g, "")) || 0;
---

<a
  href={link}
  class="product-card"
  data-name={name.toLowerCase()}
  data-price={numericPrice}
  data-category={category.toLowerCase()}
>
  <div class="card-image-container">
    <img src={image} alt={name} class="card-image" loading="lazy" />
    <div class="hover-overlay"></div>
    {onSale && <span class="sale-chip">Sale</span>}
    <span class="quick-view-btn">View piece</span>
  </div>

  <div class="card-info">
    <div class="card-details">
      {category && <p class="product-cat">{category}</p>}
      <h3 class="product-name font-display">{name}</h3>
      <div class="star-rating" aria-label={`${stars} out of 5`}>
        {Array.from({ length: fullStars }).map(() => (
          <Icon name="star-filled" class="star-icon" />
        ))}
        {hasHalfStar && <Icon name="star-half" class="star-icon" />}
        {Array.from({ length: emptyStars }).map(() => (
          <Icon name="star" class="star-icon" />
        ))}
      </div>
    </div>
    <div class="price-stack">
      <span class="product-price">{price}</span>
      {regularPrice && onSale && <s class="was">{regularPrice}</s>}
    </div>
  </div>
</a>

<style>
  .product-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
  }
  .product-card:hover .card-image { transform: scale(1.06); }
  .product-card:hover .hover-overlay { background: rgba(44, 22, 0, 0.18); }
  .product-card:hover .quick-view-btn {
    opacity: 1;
    transform: translate(-50%, 0);
  }
  .product-card:hover .product-name { color: #570000; }

  .card-image-container {
    position: relative;
    aspect-ratio: 4/3;
    background: #f3eee4;
    margin-bottom: 1.15rem;
    overflow: hidden;
    border-radius: 14px;
  }

  .card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .hover-overlay {
    position: absolute;
    inset: 0;
    transition: background 0.35s ease;
  }

  .sale-chip {
    position: absolute;
    top: 0.85rem;
    left: 0.85rem;
    z-index: 2;
    background: #570000;
    color: #fff;
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 700;
    padding: 0.28rem 0.6rem;
    border-radius: 999px;
  }

  .quick-view-btn {
    position: absolute;
    bottom: 1rem;
    left: 50%;
    transform: translate(-50%, 1rem);
    opacity: 0;
    background: rgba(252, 249, 248, 0.92);
    backdrop-filter: blur(10px);
    color: #1c1b1b;
    padding: 0.55rem 1.35rem;
    border-radius: 999px;
    font-family: var(--font-nav);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    white-space: nowrap;
    transition: all 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .card-info {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
  }

  .product-cat {
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #7c5730;
    font-weight: 700;
    margin-bottom: 0.35rem;
  }

  .product-name {
    font-size: 1.45rem;
    font-weight: 500;
    color: var(--color-ink);
    margin-bottom: 0.45rem;
  }

  .star-rating {
    display: flex;
    color: #7c5730;
    gap: 2px;
  }
  :global(.star-icon) { width: 14px; height: 14px; }

  .price-stack { text-align: right; }
  .product-price {
    display: block;
    font-family: var(--font-nav);
    font-size: 0.92rem;
    font-weight: 700;
    color: #570000;
  }
  .was {
    display: block;
    margin-top: 0.15rem;
    font-size: 0.78rem;
    color: #8a746f;
  }
</style>
