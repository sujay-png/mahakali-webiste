---
export interface Props {
  features: string[];
  specifications: { label: string; value: string }[];
  descriptionHtml?: string;
  productCodeRef: string;
}

const { features, specifications, descriptionHtml = "", productCodeRef } = Astro.props;
---

<div class="product-specs-container" data-tabs>
  <div class="tabs-header">
    <button class="tab-btn active" type="button" data-tab="desc">Description</button>
    <button class="tab-btn" type="button" data-tab="info">Details</button>
  </div>

  <div class="tab-panel" data-panel="desc">
    {descriptionHtml ? (
      <div class="rich-text" set:html={descriptionHtml} />
    ) : (
      <ul class="features-list">
        {features.map((feature) => (
          <li class="feature-item"><span class="bullet"></span>{feature}</li>
        ))}
      </ul>
    )}
  </div>

  <div class="tab-panel" data-panel="info" hidden>
    <div class="specs-list">
      {specifications.map((spec) => (
        <div class="spec-row">
          <span class="spec-label">{spec.label}</span>
          <span class="spec-value">{spec.value}</span>
        </div>
      ))}
    </div>
    <p class="ref-text">Product code {productCodeRef}</p>
  </div>
</div>

<script>
  function bindTabs() {
    document.querySelectorAll("[data-tabs]").forEach((root) => {
      const buttons = root.querySelectorAll<HTMLButtonElement>("[data-tab]");
      const panels = root.querySelectorAll<HTMLElement>("[data-panel]");
      buttons.forEach((button) => {
        button.addEventListener("click", () => {
          const id = button.dataset.tab;
          buttons.forEach((b) => b.classList.toggle("active", b === button));
          panels.forEach((panel) => {
            panel.hidden = panel.dataset.panel !== id;
          });
        });
      });
    });
  }
  bindTabs();
  document.addEventListener("astro:page-load", bindTabs);
</script>

<style>
  .product-specs-container { margin-bottom: 1.6rem; }
  .tabs-header {
    display: flex;
    gap: 1.5rem;
    border-bottom: 1px solid rgba(226, 191, 185, 0.3);
    margin-bottom: 1.1rem;
  }
  .tab-btn {
    padding-bottom: 0.55rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-size: 0.78rem;
    font-weight: 700;
    color: #8a746f;
    border-bottom: 2px solid transparent;
  }
  .tab-btn.active { color: #570000; border-bottom-color: #570000; }

  .rich-text :global(p) { margin-bottom: 0.8rem; color: #5a413d; line-height: 1.7; }
  .rich-text :global(ul) { padding-left: 1.1rem; color: #5a413d; }
  .features-list { display: grid; gap: 0.45rem; }
  .feature-item { display: flex; gap: 0.5rem; color: #5a413d; }
  .bullet {
    width: 6px; height: 6px; border-radius: 50%; background: #570000; margin-top: 0.55rem; flex-shrink: 0;
  }
  .specs-list { display: grid; gap: 0.55rem; }
  .spec-row {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid rgba(226, 191, 185, 0.18);
    padding-bottom: 0.4rem;
  }
  .spec-label { font-size: 0.75rem; letter-spacing: 0.08em; text-transform: uppercase; color: #8a746f; }
  .ref-text { margin-top: 1rem; font-size: 0.75rem; letter-spacing: 0.1em; text-transform: uppercase; color: #8a746f; }
</style>
