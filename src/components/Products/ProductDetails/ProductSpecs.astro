---
export interface Props {
  features: string[];
  specifications: { label: string; value: string }[];
  productCodeRef: string;
}

const { features, specifications, productCodeRef } = Astro.props;
---

<div class="product-specs-container">
  <div class="tabs-header">
    <button class="tab-btn active">Description</button>
    <button class="tab-btn">Additional Info</button>
  </div>

  <div class="tab-content">
    <div class="specs-grid">
      <div class="features-column">
        <h4 class="column-title font-display">Features</h4>
        <ul class="features-list">
          {features.map(feature => (
            <li class="feature-item">
              <span class="bullet"></span>
              {feature}
            </li>
          ))}
        </ul>
      </div>

      <div class="specs-column">
        <h4 class="column-title font-display">Specifications</h4>
        <div class="specs-list">
          {specifications.map(spec => (
            <div class="spec-row">
              <span class="spec-label">{spec.label}</span>
              <span class="spec-value">{spec.value}</span>
            </div>
          ))}
        </div>
      </div>
    </div>

    <div class="product-code-ref">
      <span class="ref-text">Product Code: {productCodeRef}</span>
    </div>
  </div>
</div>

<style>
  .product-specs-container {
    display: flex;
    flex-direction: column;
    gap: 1.5rem; /* gap-6 */
    margin-bottom: 2rem; /* mb-8 */
  }

  .tabs-header {
    display: flex;
    gap: 2rem; /* gap-8 */
    border-bottom: 1px solid rgba(226, 191, 185, 0.3);
  }

  .tab-btn {
    font-family: var(--font-nav);
    font-size: 0.875rem; /* text-label-lg */
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #5a413d; /* on-surface-variant */
    padding-bottom: 0.5rem;
    cursor: pointer;
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    transition: color 0.2s ease;
  }

  .tab-btn:hover {
    color: #570000; /* primary */
  }

  .tab-btn.active {
    color: #570000;
    border-bottom-color: #570000;
  }

  .tab-content {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .specs-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .specs-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .features-column, .specs-column {
    display: flex;
    flex-direction: column;
    gap: 0.75rem; /* gap-3 */
  }

  .column-title {
    font-size: 1.125rem; /* text-[18px] */
    color: #1c1b1b;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .features-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .feature-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-body);
    font-size: 1rem;
    color: #5a413d;
  }

  .bullet {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: #570000; /* primary */
  }

  .specs-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .spec-row {
    display: flex;
    justify-content: space-between;
    border-bottom: 1px solid rgba(226, 191, 185, 0.1);
    padding-bottom: 0.25rem;
  }

  .spec-label {
    font-family: var(--font-nav);
    font-size: 0.75rem;
    color: #5a413d;
    text-transform: uppercase;
  }

  .spec-value {
    font-family: var(--font-body);
    font-size: 1rem;
    color: #1c1b1b;
  }

  .product-code-ref {
    padding-top: 1rem;
    border-top: 1px solid rgba(226, 191, 185, 0.3);
  }

  .ref-text {
    font-family: var(--font-nav);
    font-size: 0.75rem;
    color: #5a413d;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
</style>
