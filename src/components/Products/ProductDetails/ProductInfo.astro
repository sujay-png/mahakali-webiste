---
import Icon from "../../global/UI/Icon.astro";
import { stripHtml } from "../../../lib/woocommerce/format";

export interface Props {
  title: string;
  rating: number;
  stars: number;
  ratingCount?: number;
  currentPrice: string;
  originalPrice?: string;
  discountText?: string;
  discountLabel?: string;
  sku: string;
  stockStatus: string;
  categoryName: string;
  categoryHref: string;
  whatsappHref: string;
  contactHref?: string;
  excerptHtml?: string;
}

const {
  title,
  rating,
  stars,
  ratingCount = 0,
  currentPrice,
  originalPrice,
  discountText,
  discountLabel = "Showroom price",
  sku,
  stockStatus,
  categoryName,
  categoryHref,
  whatsappHref,
  contactHref = "/contact",
  excerptHtml = "",
} = Astro.props;

const fullStars = Math.max(1, Math.min(5, Math.round(stars || rating || 5)));
const excerpt = stripHtml(excerptHtml);
---

<div class="product-info-wrapper">
  <a class="collection-chip" href={categoryHref}>{categoryName}</a>

  <div class="info-header">
    <h1 class="product-title font-display">{title}</h1>
    <div class="rating-container">
      {Array.from({ length: fullStars }).map(() => (
        <Icon name="star-filled" class="star-icon" />
      ))}
      <span class="rating-text">
        {rating.toFixed(1)}{ratingCount ? ` · ${ratingCount} reviews` : ""}
      </span>
    </div>
  </div>

  <div class="pricing-container">
    <div class="price-details">
      <span class="discount-label">{discountLabel}</span>
      <div class="price-row">
        <span class="current-price font-display">{currentPrice}</span>
        {originalPrice && <span class="original-price">{originalPrice}</span>}
      </div>
    </div>
    {discountText && <span class="discount-badge">{discountText}</span>}
  </div>

  {excerpt && <p class="excerpt">{excerpt}</p>}

  <div class="meta-container">
    <p class="product-codes">SKU {sku}</p>
    <p class="stock-status">
      <Icon name="info" class="info-icon" /> {stockStatus}
    </p>
  </div>

  <slot />

  <div class="cta-row">
    <a class="btn btn-primary" href={whatsappHref}>
      Enquire on WhatsApp
      <Icon name="arrow-right" class="cart-icon" />
    </a>
    <a class="btn btn-secondary" href={contactHref}>Visit a showroom</a>
  </div>
</div>

<style>
  .product-info-wrapper { display: flex; flex-direction: column; }

  .collection-chip {
    align-self: flex-start;
    font-size: 0.66rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-gold);
    margin-bottom: 1rem;
  }

  .info-header {
    border-bottom: 1px solid var(--color-line);
    padding-bottom: 1.4rem;
    margin-bottom: 1.4rem;
  }

  .product-title {
    font-size: clamp(2.4rem, 4vw, 4rem);
    margin-bottom: 0.7rem;
    max-width: 14ch;
  }

  .rating-container {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--color-ink-soft);
    font-size: 0.82rem;
  }
  :global(.star-icon) { width: 14px; height: 14px; color: var(--color-gold); }

  .pricing-container {
    display: flex;
    align-items: flex-end;
    gap: 1rem;
    margin-bottom: 1.3rem;
  }
  .discount-label {
    font-size: 0.66rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-ink-soft);
  }
  .price-row { display: flex; align-items: baseline; gap: 0.7rem; }
  .current-price { font-size: 2.4rem; }
  .original-price { color: var(--color-ink-soft); text-decoration: line-through; }
  .discount-badge {
    margin-left: auto;
    color: var(--color-primary);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-size: 0.7rem;
  }

  .excerpt {
    color: var(--color-ink-soft);
    font-weight: 300;
    line-height: 1.75;
    margin-bottom: 1.4rem;
    max-width: 42ch;
  }

  .meta-container { display: grid; gap: 0.4rem; margin-bottom: 1.6rem; color: var(--color-ink-soft); font-size: 0.88rem; }
  .stock-status { display: flex; align-items: center; gap: 0.35rem; }
  :global(.info-icon) { width: 16px; height: 16px; }

  .cta-row { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  :global(.cart-icon) { width: 14px; height: 14px; }
</style>
