---
import Icon from "../../global/UI/Icon.astro";

export interface BreadcrumbItem {
  label: string;
  link?: string;
}

export interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
---

<nav class="breadcrumb-nav" aria-label="Breadcrumb">
  {items.map((item, index) => (
    <>
      {item.link ? (
        <a href={item.link} class="breadcrumb-link">{item.label}</a>
      ) : (
        <span class="breadcrumb-current">{item.label}</span>
      )}
      {index < items.length - 1 && (
        <Icon name="chevron-right" class="breadcrumb-separator" />
      )}
    </>
  ))}
</nav>

<style>
  .breadcrumb-nav {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.45rem;
    padding-block: 1rem 1.4rem;
    font-size: 0.875rem;
    color: #5a413d;
  }
  .breadcrumb-link:hover { color: #570000; }
  .breadcrumb-current { color: #570000; font-weight: 600; }
  :global(.breadcrumb-separator) { width: 14px; height: 14px; }
</style>
