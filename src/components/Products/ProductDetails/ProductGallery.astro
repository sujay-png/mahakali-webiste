---
export interface Props {
  image: string;
  alt: string;
  dataAlt?: string;
}

const { image, alt, dataAlt } = Astro.props;
---

<div class="product-gallery">
  <div class="gallery-main-image">
    <img src={image} alt={alt} data-alt={dataAlt} />
  </div>
</div>

<style>
  .product-gallery {
    display: flex;
    flex-direction: column;
    gap: 1rem; /* gap-gutter */
  }

  .gallery-main-image {
    width: 100%;
    aspect-ratio: 4 / 3;
    background-color: #f6f3f2; /* surface-container-low */
    border-radius: 0.5rem; /* rounded-lg */
    overflow: hidden;
    border: 1px solid rgba(226, 191, 185, 0.3); /* border-outline-variant/30 */
  }

  .gallery-main-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
