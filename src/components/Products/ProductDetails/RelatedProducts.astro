---
import type { ProductCardModel } from "../../../lib/woocommerce/types";
import { getRelatedProducts } from "../../../lib/woocommerce/catalog";

export interface Props {
  products?: ProductCardModel[];
  product?: any;
}

const { products: passedProducts, product } = Astro.props;
const products = passedProducts || (product ? await getRelatedProducts(product) : []);
---

{
  products.length > 0 && (
    <section class="related-masterpieces">
      <p class="eyebrow">Continue looking</p>
      <h2 class="font-display section-title">From the same workshop</h2>
      <div class="related-grid">
        {products.map((product) => (
          <a href={product.link} class="related-card">
            <div class="image-wrapper" data-media>
              <span class="stock-badge">{product.stockStatus}</span>
              <img
                src={product.image}
                alt={product.name}
                class="related-img"
                loading="lazy"
              />
            </div>
            <div class="related-info">
              <h3 class="font-display product-title">{product.name}</h3>
              <span class="product-price">{product.price}</span>
            </div>
          </a>
        ))}
      </div>
    </section>
  )
}

<style>
  .related-masterpieces {
    margin-top: 5.5rem;
    padding-top: 3.5rem;
    border-top: 1px solid var(--color-line);
  }
  .section-title {
    font-size: clamp(2rem, 4vw, 3.2rem);
    margin: 0.7rem 0 2.2rem;
    max-width: 12ch;
  }
  .related-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem 1rem;
  }
  @media (min-width: 768px) {
    .related-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.6rem;
    }
  }
  .related-card {
    display: grid;
    gap: 0.9rem;
  }
  .image-wrapper {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--color-cream);
  }
  .stock-badge {
    position: absolute;
    top: 0.8rem;
    right: 0.8rem;
    z-index: 1;
    background: var(--color-walnut);
    color: #fff;
    font-size: 0.6rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 0.3rem 0.55rem;
  }
  .related-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .product-title {
    font-size: 1.4rem;
    max-width: 14ch;
  }
  .product-price {
    color: var(--color-primary);
    font-size: 0.82rem;
    letter-spacing: 0.04em;
  }
</style>
