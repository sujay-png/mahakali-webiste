---
import type { RelatedProduct } from "../../../data/products/alen-gold-sofa/related";

export interface Props {
  products: RelatedProduct[];
}

const { products } = Astro.props;
---

<section class="related-masterpieces">
  <h2 class="font-display section-title">Related Masterpieces</h2>
  <div class="related-grid">
    {products.map((product) => (
      <div class="related-card group">
        <div class="image-wrapper">
          <div class="stock-badge">{product.stockStatus}</div>
          <img src={product.image} alt={product.title} class="related-img" />
        </div>
        <div class="related-info">
          <h3 class="font-display product-title">{product.title}</h3>
          <span class="product-price">{product.price}</span>
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .related-masterpieces {
    margin-top: 4rem; /* mt-section-gap */
    padding-top: 4rem; /* pt-section-gap */
    border-top: 1px solid rgba(226, 191, 185, 0.3);
  }

  .section-title {
    font-size: 2rem; /* text-headline-lg */
    color: #570000; /* primary */
    margin-bottom: 2rem; /* mb-8 */
  }

  .related-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem; /* gap-gutter */
  }

  @media (min-width: 768px) {
    .related-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .related-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    cursor: pointer;
  }

  .image-wrapper {
    width: 100%;
    aspect-ratio: 1.5;
    background-color: #f6f3f2;
    overflow: hidden;
    border-radius: 0.25rem;
    border: 1px solid rgba(226, 191, 185, 0.3);
    position: relative;
  }

  .stock-badge {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    background-color: #ba1a1a; /* error */
    color: #ffffff;
    font-family: var(--font-nav);
    font-size: 10px;
    text-transform: uppercase;
    padding: 0.25rem 0.5rem;
    border-radius: 0.25rem;
    z-index: 10;
  }

  .related-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .related-card:hover .related-img {
    transform: scale(1.05);
  }

  .related-info {
    display: flex;
    flex-direction: column;
  }

  .product-title {
    font-size: 1.25rem; /* text-[20px] */
    color: #1c1b1b;
    margin-bottom: 0.25rem;
  }

  .product-price {
    font-family: var(--font-nav);
    font-size: 0.875rem; /* text-label-lg */
    color: #570000;
  }
</style>
