---
import type { ProductCardModel } from "../../../lib/woocommerce/types";

export interface Props {
  products: ProductCardModel[];
}

const { products } = Astro.props;
---

{products.length > 0 && (
  <section class="related-masterpieces">
    <h2 class="font-display section-title">From the same workshop</h2>
    <div class="related-grid">
      {products.map((product) => (
        <a href={product.link} class="related-card">
          <div class="image-wrapper">
            <span class="stock-badge">{product.stockStatus}</span>
            <img src={product.image} alt={product.name} class="related-img" loading="lazy" />
          </div>
          <div class="related-info">
            <h3 class="font-display product-title">{product.name}</h3>
            <span class="product-price">{product.price}</span>
          </div>
        </a>
      ))}
    </div>
  </section>
)}

<style>
  .related-masterpieces {
    margin-top: 4.5rem;
    padding-top: 3rem;
    border-top: 1px solid rgba(226, 191, 185, 0.3);
  }
  .section-title { font-size: 2rem; color: #570000; margin-bottom: 1.6rem; }
  .related-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }
  @media (min-width: 768px) {
    .related-grid { grid-template-columns: repeat(3, 1fr); }
  }
  .related-card { display: grid; gap: 0.8rem; }
  .image-wrapper {
    position: relative;
    aspect-ratio: 1.4;
    overflow: hidden;
    border-radius: 14px;
    background: #f3eee4;
  }
  .stock-badge {
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    background: rgba(44, 22, 0, 0.78);
    color: #fff;
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.28rem 0.5rem;
    border-radius: 999px;
  }
  .related-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .related-card:hover .related-img { transform: scale(1.05); }
  .product-title { font-size: 1.15rem; }
  .product-price { color: #570000; font-weight: 700; font-size: 0.9rem; }
</style>
