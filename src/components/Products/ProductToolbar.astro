---
import Icon from "../global/UI/Icon.astro";

export interface Props {
  categoryName: string;
  totalResults: number;
}

const { categoryName, totalResults } = Astro.props;
---

<section class="toolbar-section">
  <div class="toolbar-inner">
    <div class="toolbar-breadcrumb">
      <a href="/">Home</a>
      <Icon name="chevron-right" class="icon-14" />
      <a href="/products">Collections</a>
      <Icon name="chevron-right" class="icon-14" />
      <span class="current-category">{categoryName}</span>
      <span class="results-count">({totalResults} pieces)</span>
    </div>

    <div class="sort-dropdown">
      <select id="product-sort-select" aria-label="Sort products">
        <option value="default">Featured</option>
        <option value="price-asc">Price: Low to High</option>
        <option value="price-desc">Price: High to Low</option>
      </select>
      <Icon name="chevron-down" class="icon-16 sort-icon" />
    </div>
  </div>
</section>

<style>
  .toolbar-section {
    border-bottom: 1px solid var(--color-line);
    background: rgba(244, 239, 232, 0.92);
    position: sticky;
    top: 4.5rem;
    z-index: 40;
    backdrop-filter: blur(16px);
  }

  .toolbar-inner {
    padding-block: 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }

  @media (min-width: 768px) {
    .toolbar-inner {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  .toolbar-breadcrumb {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.45rem;
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-soft);
  }
  .toolbar-breadcrumb a:hover { color: var(--color-ink); }
  .current-category { color: var(--color-ink); }
  .results-count { letter-spacing: 0; text-transform: none; }
  :global(.icon-14) { width: 14px; height: 14px; }

  .sort-dropdown { position: relative; min-width: 180px; }
  .sort-dropdown select {
    width: 100%;
    appearance: none;
    background: transparent;
    border: none;
    border-bottom: 1px solid var(--color-line);
    padding: 0.5rem 2rem 0.5rem 0;
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
    outline: none;
  }
  :global(.sort-icon) {
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    pointer-events: none;
    width: 16px;
    height: 16px;
  }
</style>
