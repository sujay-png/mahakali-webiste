---
import Icon from "../global/UI/Icon.astro";

export interface Props {
  categoryName: string;
  totalResults: number;
  categories: string[];
}

const { categoryName, totalResults, categories } = Astro.props;
---

<section class="toolbar-section">
  <div class="wrap toolbar-inner">
    <!-- Breadcrumb & Results -->
    <div class="toolbar-breadcrumb">
      <a href="/">Home</a>
      <Icon name="chevron-right" class="icon-14" />
      <span class="current-category">{categoryName}</span>
      <span class="results-count">({totalResults} Results)</span>
    </div>

    <!-- Filters & Sort -->
    <div class="toolbar-actions hide-scrollbar">
      <button class="filter-btn group">
        <Icon name="filter" class="icon-20 group-hover" />
        Filter
      </button>
      
      <div class="divider hidden-mobile"></div>
      
      <div class="category-pills" id="toolbar-categories">
        {categories.map((cat, i) => (
          <button class="pill" data-category={cat.toLowerCase()}>{cat}</button>
        ))}
      </div>
      
      <div class="divider hidden-mobile"></div>
      
      <div class="sort-dropdown">
        <select id="product-sort-select" aria-label="Sort products">
          <option value="default">Default Sorting</option>
          <option value="price-asc">Price: Low to High</option>
          <option value="price-desc">Price: High to Low</option>
          <option value="newest">Newest Arrivals</option>
        </select>
        <Icon name="chevron-down" class="icon-16 sort-icon" />
      </div>
    </div>
  </div>
</section>

<style>
  .toolbar-section {
    border-bottom: 1px solid rgba(226, 191, 185, 0.3); /* outline-variant */
    background: #fcf9f8; /* surface */
    position: sticky;
    top: 5rem; /* height of header */
    z-index: 40;
  }

  .toolbar-inner {
    padding-block: 1rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  @media (min-width: 768px) {
    .toolbar-inner {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  .toolbar-breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-nav);
    font-size: 0.875rem;
    color: #5a413d; /* on-surface-variant */
  }

  .toolbar-breadcrumb a {
    transition: color 0.2s ease;
  }
  .toolbar-breadcrumb a:hover {
    color: #570000; /* primary */
  }
  .current-category {
    color: #1c1b1b; /* on-surface */
  }
  .results-count {
    margin-left: 0.5rem;
    color: #c8c6c3; /* tertiary-fixed-dim */
  }
  :global(.icon-14) {
    width: 14px;
    height: 14px;
  }

  .toolbar-actions {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    width: 100%;
    overflow-x: auto;
    padding-bottom: 0.5rem;
  }
  
  @media (min-width: 768px) {
    .toolbar-actions {
      width: auto;
      padding-bottom: 0;
    }
  }

  .hide-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .hide-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  .filter-btn {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-nav);
    font-size: 0.875rem;
    font-weight: 600;
    color: #1c1b1b;
    white-space: nowrap;
    transition: color 0.2s ease;
    cursor: pointer;
    background: none;
    border: none;
  }
  .filter-btn:hover {
    color: #570000;
  }
  :global(.icon-20) {
    width: 20px;
    height: 20px;
  }
  .group:hover .group-hover {
    color: #570000;
  }

  .divider {
    height: 1.5rem;
    width: 1px;
    background: rgba(226, 191, 185, 0.5);
  }
  .hidden-mobile {
    display: none;
  }
  @media (min-width: 768px) {
    .hidden-mobile {
      display: block;
    }
  }

  .category-pills {
    display: flex;
    gap: 0.5rem;
  }

  .pill {
    padding: 0.375rem 1rem;
    border-radius: 9999px;
    border: 1px solid #e2bfb9; /* outline-variant */
    background: #fcf9f8;
    color: #5a413d;
    font-family: var(--font-nav);
    font-size: 0.875rem;
    font-weight: 500;
    white-space: nowrap;
    transition: all 0.2s ease;
    cursor: pointer;
  }
  .pill:hover {
    border-color: #7c5730; /* secondary */
    color: #7c5730;
  }
  .pill.active {
    border-color: #7c5730;
    color: #7c5730;
    background: #fcf9f8;
  }

  .sort-dropdown {
    position: relative;
    min-width: 160px;
  }
  .sort-dropdown select {
    width: 100%;
    appearance: none;
    background: transparent;
    border: none;
    border-bottom: 1px solid #e2bfb9;
    padding: 0.5rem 2rem 0.5rem 0;
    font-family: var(--font-nav);
    font-size: 0.875rem;
    font-weight: 600;
    color: #1c1b1b;
    cursor: pointer;
    outline: none;
  }
  .sort-dropdown select:focus {
    border-color: #570000;
  }
  :global(.sort-icon) {
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    pointer-events: none;
    color: #5a413d;
    width: 16px;
    height: 16px;
  }
</style>
