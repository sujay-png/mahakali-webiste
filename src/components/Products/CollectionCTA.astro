---
import Icon from "../global/UI/Icon.astro";
---

<section class="cta">
  <div class="wrap">
    <p class="eyebrow">Bespoke</p>
    <h2>Commission a piece made for your room.</h2>
    <p>If the collection is close but not exact, our workshop can tailor upholstery, timber and dimensions.</p>
    <a href="/contact" class="btn btn-primary">Bespoke consultation <Icon name="arrow-right" /></a>
  </div>
</section>

<style>
  .cta {
    padding-block: clamp(5rem, 9vw, 8rem);
    background: var(--color-walnut);
    color: #f4efe8;
  }
  h2 { color: #fff; max-width: 14ch; margin: 1rem 0 1.2rem; }
  p { max-width: 38ch; color: rgba(244,239,232,0.72); font-weight: 300; margin-bottom: 2rem; }
</style>
