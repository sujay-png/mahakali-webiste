---
import Icon from "../global/UI/Icon.astro";
import type { promoStrip as PromoStripType } from "../../data/home";
export interface Props { data: typeof PromoStripType; }
const { data } = Astro.props;
---

<section class="band">
  <div class="wrap wrap--wide grid" data-reveal-group>
    {data.map((promo) => (
      <a href={promo.cta.href} class="tile" data-reveal="fade">
        <span data-media class="tile__media">
          <img src={promo.image} alt={promo.title} loading="lazy" />
        </span>
        <span class="tile__copy">
          <small>{promo.tag}</small>
          <strong class="font-display">{promo.title}</strong>
          <em class="link-arrow">{promo.cta.label} <Icon name="arrow-right" /></em>
        </span>
      </a>
    ))}
  </div>
</section>

<style>
  .band { padding-bottom: clamp(4rem, 8vw, 7rem); }
  .grid {
    display: grid;
    grid-template-columns: 1.2fr 0.9fr 0.9fr;
    gap: 1.1rem;
  }
  .tile { display: grid; gap: 1.1rem; }
  .tile:first-child { grid-row: span 1; }
  .tile__media { aspect-ratio: 4 / 5; }
  .tile:first-child .tile__media { aspect-ratio: 4 / 5; }
  .tile__copy { display: grid; gap: 0.35rem; }
  .tile__copy small {
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-size: 0.66rem;
    color: var(--color-gold);
  }
  .tile__copy strong { font-size: 1.8rem; font-weight: 400; }
  @media (max-width: 860px) {
    .grid { grid-template-columns: 1fr; }
    .tile__media { aspect-ratio: 16 / 10; }
  }
</style>
