---
import Icon from "../global/UI/Icon.astro";
import type { promoStrip as PromoStripType } from "../../data/home";
export interface Props {
  data: typeof PromoStripType;
}
const { data } = Astro.props;
---

<section class="section section--tight promo-strip">
  <div class="wrap promo-strip__grid" data-reveal-group>
    {
      data.map((promo) => (
        <a
          href={promo.cta.href}
          class={`promo-card promo-card--${promo.theme}`}
          data-reveal="fade"
        >
          <div class="promo-card__text">
            <span class="promo-card__tag">{promo.tag}</span>
            <h3>{promo.title}</h3>
            <span class="link-arrow">
              {promo.cta.label} <Icon name="arrow-right" />
            </span>
          </div>
          <img
            src={promo.image}
            alt={promo.title}
            width="220"
            height="220"
            loading="lazy"
          />
        </a>
      ))
    }
  </div>
</section>

<style>
  .promo-strip__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }
  .promo-card {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.8rem;
    overflow: hidden;
    min-height: 190px;
    clip-path: polygon(
      var(--chamfer) 0,
      100% 0,
      100% 100%,
      0 100%,
      0 var(--chamfer)
    );
    transition:
      transform 0.3s var(--ease),
      box-shadow 0.3s var(--ease);
  }
  .promo-card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-md);
  }
  .promo-card--blush {
    background: #f6e2da;
  }
  .promo-card--sand {
    background: #f3e6cd;
  }
  .promo-card--sky {
    background: #dbe9f0;
  }

  .promo-card__tag {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    background: var(--color-primary);
    color: #fff;
    padding: 0.25rem 0.6rem;
    margin-bottom: 0.7rem;
  }
  .promo-card h3 {
    font-size: 1.2rem;
    margin-bottom: 0.9rem;
    max-width: 20ch;
  }
  .promo-card img {
    width: 96px;
    height: 96px;
    object-fit: cover;
    border-radius: 50%;
    box-shadow: var(--shadow-sm);
    flex-shrink: 0;
  }

  @media (max-width: 860px) {
    .promo-strip__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
