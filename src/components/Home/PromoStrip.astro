---
import Icon from "../global/UI/Icon.astro";
import type { promoStrip as PromoStripType } from "../../data/home";
export interface Props { data: typeof PromoStripType; }
const { data } = Astro.props;
---

<section class="offers">
  <div class="wrap wrap--wide row">
    {data.map((promo) => (
      <a href={promo.cta.href} class="offer">
        <small>{promo.tag}</small>
        <strong class="font-display">{promo.title}</strong>
        <span class="link-arrow">{promo.cta.label} <Icon name="arrow-right" /></span>
      </a>
    ))}
  </div>
</section>

<style>
  .offers {
    padding-block: 0.5rem 2.5rem;
  }
  .row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--color-line);
  }
  .offer {
    display: grid;
    gap: 0.35rem;
    padding: 1.4rem 1.5rem 1.4rem 0;
    border-right: 1px solid var(--color-line);
  }
  .offer:last-child { border-right: none; padding-right: 0; }
  .offer:first-child { padding-left: 0; }
  small {
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-size: 0.62rem;
    color: var(--color-gold);
  }
  strong { font-size: 1.35rem; font-weight: 500; line-height: 1.2; max-width: 16ch; }
  @media (max-width: 800px) {
    .row { grid-template-columns: 1fr; }
    .offer { border-right: none; border-bottom: 1px solid var(--color-line); padding: 1.2rem 0; }
  }
</style>
