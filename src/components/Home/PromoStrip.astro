---
import Icon from "../global/UI/Icon.astro";
import type { promoStrip as PromoStripType } from "../../data/home";
export interface Props { data: typeof PromoStripType; }
const { data } = Astro.props;
---

<section class="offers section">
  <div class="wrap wrap--wide bento-grid">
    {data.map((promo, i) => (
      <a href={promo.cta.href} class={`bento-card bento-card--${i + 1}`} data-reveal="fade">
        <div class="bg-image" style={`background-image: url('${promo.image}')`}></div>
        <div class="content">
          <small>{promo.tag}</small>
          <strong class="font-display">{promo.title}</strong>
          <span class="link-arrow">{promo.cta.label} <Icon name="arrow-right" /></span>
        </div>
      </a>
    ))}
  </div>
</section>

<style>
  .offers { padding-block: 2rem 4rem; }
  .bento-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-auto-rows: 280px;
    gap: 1.5rem;
  }
  .bento-card {
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    text-decoration: none;
    color: var(--color-ink);
    display: flex;
    align-items: flex-end;
    padding: 2rem;
    background: var(--color-cream);
    box-shadow: 0 4px 20px rgba(0,0,0,0.04);
  }
  .bento-card--1 {
    grid-column: span 2;
  }
  .bento-card--2, .bento-card--3 {
    grid-column: span 1;
  }
  .bg-image {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    filter: brightness(0.9) saturate(0.96);
    transition: transform 0.6s var(--ease);
    z-index: 1;
  }
  .bento-card::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.75) 0%, rgba(0, 0, 0, 0.2) 50%, rgba(255, 255, 255, 0.05) 100%);
    pointer-events: none;
    z-index: 2;
  }
  .content {
    position: relative;
    z-index: 3;
    color: var(--color-ink);
    transform: translateY(10px);
    transition: transform 0.4s var(--ease);
  }
  .content small {
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-size: 0.65rem;
    color: #e4c9a4;
    display: block;
    margin-bottom: 0.5rem;
  }
  .content strong {
    font-size: clamp(1.6rem, 2.5vw, 2.2rem);
    font-weight: 500;
    line-height: 1.1;
    display: block;
    color: #fff;
    margin-bottom: 1rem;
    max-width: 14ch;
  }
  .link-arrow {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    color: #e4c9a4; /* Light brown/gold for visibility */
    background-color: transparent;
    padding: 0;
    border-radius: 0;
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    opacity: 0.95;
    transition: transform var(--dur-fast) var(--ease), opacity var(--dur-fast) var(--ease);
  }
  .bento-card:hover .bg-image { transform: scale(1.05); }
  .bento-card:hover .content { transform: translateY(0); }
  .bento-card:hover .link-arrow { opacity: 1; transform: translateX(3px); }
  
  @media (max-width: 900px) {
    .bento-grid {
      grid-template-columns: 1fr;
      grid-auto-rows: 240px;
    }
    .bento-card--1 { grid-column: span 1; }
  }
  @media (max-width: 480px) {
    .bento-card--3 .bg-image {
      background-size: 105% auto;
      background-position: center -7rem;
      background-repeat: no-repeat;
      background-color: var(--color-cream);
    }
    .bento-card--3 .content { transform: translateY(-0.75rem); }
  }
</style>
