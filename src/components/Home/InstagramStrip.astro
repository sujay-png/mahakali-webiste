---
import Icon from "../global/UI/Icon.astro";
import type { instagramStrip as InstagramStripType } from "../../data/home";
export interface Props {
  data: typeof InstagramStripType;
}
const { data } = Astro.props;
const loop = [...data.images, ...data.images];
---

<section class="section section--tight instagram">
  <div class="wrap">
    <h2 class="instagram__title" data-reveal="fade">
      {data.eyebrow}
      <a
        href="https://instagram.com"
        target="_blank"
        rel="noopener noreferrer"
        class="accent">{data.handle}</a
      >
    </h2>
  </div>

  <div class="marquee" data-reveal="fade">
    <div class="marquee__track">
      {
        loop.map((src, i) => (
          <a
            class="insta-tile"
            href="https://instagram.com"
            target="_blank"
            rel="noopener noreferrer"
            aria-hidden={i >= data.images.length}
          >
            <img src={src} alt="" width="200" height="200" loading="lazy" />
            <span class="insta-tile__icon">
              <Icon name="instagram" class="icon-20" />
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .instagram__title {
    text-align: center;
    margin-bottom: 2rem;
  }
  .instagram__title a {
    text-decoration: none;
  }

  .insta-tile {
    position: relative;
    flex: 0 0 clamp(140px, 18vw, 200px);
    aspect-ratio: 1;
    margin-right: 1rem;
    overflow: hidden;
  }
  .insta-tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s var(--ease);
  }
  .insta-tile__icon {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: #fff;
    background: rgba(74, 46, 31, 0.45);
    opacity: 0;
    transition: opacity 0.3s var(--ease);
  }
  .icon-20 {
    width: 22px;
    height: 22px;
  }
  .insta-tile:hover img {
    transform: scale(1.08);
  }
  .insta-tile:hover .insta-tile__icon {
    opacity: 1;
  }
</style>
