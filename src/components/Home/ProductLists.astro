---
import Icon from "../global/UI/Icon.astro";
import StarRating from "../global/UI/StarRating.astro";

type ShelfItem = {
  name: string;
  rating: number;
  price: string;
  oldPrice?: string;
  image: string;
  href?: string;
};

type Column = {
  title: string;
  items: ShelfItem[];
  emptyMessage?: string;
};

export interface Props {
  data: {
    onSale: Column;
    bestSeller: Column;
    topRated: Column;
  };
}

const { data } = Astro.props;
const columns = [data.onSale, data.bestSeller, data.topRated];
---

<section class="section section--tight product-lists">
  <div class="wrap product-lists__grid" data-reveal-group>
    {
      columns.map((col) => (
        <div class="product-col" data-reveal="fade">
          <div class="product-col__head">
            <h3>{col.title}</h3>
          </div>
          {col.items.length > 0 ? (
            <ul class="product-col__list">
              {col.items.map((item) => (
                <li>
                  <a href={item.href || "/products"} class="product-mini">
                    <img
                      src={item.image}
                      alt={item.name}
                      width="70"
                      height="70"
                      loading="lazy"
                    />
                    <span>
                      <strong>{item.name}</strong>
                      <StarRating rating={item.rating} />
                      <span class="product-mini__price">
                        {item.price}
                        {item.oldPrice && <s>{item.oldPrice}</s>}
                      </span>
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          ) : (
            <p class="product-col__empty">
              <Icon name="tag" class="icon-16" />
              {col.emptyMessage || "No products available."}
            </p>
          )}
        </div>
      ))
    }
  </div>
</section>

<style>
  .product-lists__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }
  .product-col {
    border-top: 3px solid var(--color-primary);
    padding-top: 1.3rem;
  }
  .product-col__head h3 {
    font-size: 1.05rem;
    margin-bottom: 1.1rem;
  }
  .product-col__list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .product-mini {
    display: flex;
    gap: 0.9rem;
    align-items: center;
  }
  .product-mini img {
    width: 62px;
    height: 62px;
    object-fit: cover;
    flex-shrink: 0;
    clip-path: polygon(10% 0, 100% 0, 100% 90%, 90% 100%, 0 100%, 0 10%);
  }
  .product-mini strong {
    display: block;
    font-size: 0.9rem;
    font-weight: 600;
    transition: color 0.2s;
  }
  .product-mini:hover strong { color: var(--color-primary); }
  .product-mini__price {
    display: block;
    margin-top: 0.25rem;
    font-weight: 700;
    color: var(--color-primary);
    font-size: 0.88rem;
  }
  .product-mini__price s {
    margin-left: 0.4rem;
    color: var(--color-ink-soft);
    font-weight: 400;
  }
  .product-col__empty {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-ink-soft);
    font-size: 0.9rem;
  }
  :global(.icon-16) { width: 15px; height: 15px; }
  @media (max-width: 860px) {
    .product-lists__grid { grid-template-columns: 1fr; gap: 2.5rem; }
  }
</style>
