---
import StarRating from "../global/UI/StarRating.astro";

type ShelfItem = {
  name: string;
  rating: number;
  price: string;
  oldPrice?: string;
  image: string;
  href?: string;
};
type Column = { title: string; items: ShelfItem[]; emptyMessage?: string; };
export interface Props {
  data: { onSale: Column; bestSeller: Column; topRated: Column };
}
const { data } = Astro.props;
const columns = [data.onSale, data.bestSeller, data.topRated];
---

<section class="section shelves">
  <div class="wrap wrap--wide grid">
    {columns.map((col) => (
      <div>
        <p class="eyebrow">{col.title}</p>
        {col.items.length > 0 ? (
          <ul>
            {col.items.map((item) => (
              <li>
                <a href={item.href || "/products"}>
                  <span data-media class="thumb">
                    <img src={item.image} alt={item.name} loading="lazy" />
                  </span>
                  <span>
                    <strong>{item.name}</strong>
                    <StarRating rating={item.rating} />
                    <em>{item.price}{item.oldPrice && <s>{item.oldPrice}</s>}</em>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p class="empty">{col.emptyMessage}</p>
        )}
      </div>
    ))}
  </div>
</section>

<style>
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 3.5rem; }
  ul { margin-top: 1.8rem; display: grid; gap: 1.4rem; }
  a { display: grid; grid-template-columns: 92px 1fr; gap: 1.1rem; align-items: center; }
  .thumb { aspect-ratio: 1; }
  strong {
    display: block;
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 400;
    margin-bottom: 0.25rem;
  }
  em { display: block; font-style: normal; margin-top: 0.3rem; font-size: 0.88rem; }
  s { margin-left: 0.5rem; color: var(--color-ink-soft); }
  .empty { margin-top: 1.4rem; color: var(--color-ink-soft); font-weight: 300; }
  @media (max-width: 860px) { .grid { grid-template-columns: 1fr; gap: 3rem; } }
</style>
