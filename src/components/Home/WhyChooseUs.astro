---
import type { whyChooseUs as WhyChooseUsType } from "../../data/home";
export interface Props { data: typeof WhyChooseUsType; }
const { data } = Astro.props;
---

<section class="section why">
  <div class="wrap wrap--wide why__grid">
    <div data-reveal="fade">
      <p class="eyebrow">{data.eyebrow}</p>
      <h2>Crafted for everyday living.</h2>
      <p class="lead">{data.copy}</p>
    </div>
    <ol data-reveal-group>
      {data.points.map((point, i) => (
        <li data-reveal="fade">
          <span>0{i + 1}</span>
          <div>
            <h3>{point.title}</h3>
            <p>{point.copy}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .why { background: var(--color-surface); }
  .why__grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(2.5rem, 6vw, 7rem);
    align-items: start;
  }
  h2 { max-width: 10ch; margin: 1rem 0 1.4rem; }
  .lead { color: var(--color-ink-soft); max-width: 38ch; font-weight: 300; }
  ol { display: grid; gap: 2.4rem; }
  li {
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    gap: 1.2rem;
    padding-top: 1.6rem;
    border-top: 1px solid var(--color-line);
  }
  li span {
    font-family: var(--font-display);
    font-size: 1.4rem;
    color: var(--color-gold);
  }
  h3 { font-size: 1.8rem; margin-bottom: 0.5rem; }
  li p { color: var(--color-ink-soft); font-weight: 300; max-width: 46ch; }
  @media (max-width: 860px) {
    .why__grid { grid-template-columns: 1fr; }
  }
</style>
