---
import type { testimonials as TestimonialsType } from "../../data/home";
export interface Props { data: typeof TestimonialsType; }
const { data } = Astro.props;
const loop = [...data.items, ...data.items];
---

<section class="section quotes">
  <div class="wrap wrap--wide">
    <p class="eyebrow">{data.eyebrow}</p>
    <h2>{data.title} <em class="accent">{data.titleAccent}</em></h2>
  </div>

  <div class="quote-marquee marquee marquee--slow" aria-label="Client testimonials">
    <div class="marquee__track">
      {loop.map((t, i) => (
        <blockquote class="card" aria-hidden={i >= data.items.length ? "true" : undefined}>
          <p>“{t.quote}”</p>
          <footer>
            <strong>{t.name}</strong>
            <span>{t.role}, Udupi</span>
          </footer>
        </blockquote>
      ))}
    </div>
  </div>
</section>

<style>
  .quotes {
    background: var(--color-surface);
    overflow: hidden;
  }
  h2 { max-width: 12ch; margin: 0.7rem 0 2.8rem; }
  .quote-marquee { padding-bottom: 0.5rem; }
  .card {
    flex: 0 0 auto;
    width: min(78vw, 520px);
    margin: 0;
    padding: 0 2.4rem 0 0;
    border-right: 1px solid var(--color-line);
  }
  .card p {
    font-family: var(--font-display);
    font-size: clamp(1.55rem, 2.4vw, 2.15rem);
    font-weight: 500;
    font-style: italic;
    line-height: 1.28;
    letter-spacing: -0.015em;
    max-width: 22ch;
  }
  footer {
    margin-top: 1.6rem;
    display: grid;
    gap: 0.15rem;
  }
  footer strong { font-size: 0.92rem; font-weight: 500; }
  footer span { color: var(--color-ink-soft); font-size: 0.82rem; }
</style>
