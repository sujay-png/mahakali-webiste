---
import type { testimonials as TestimonialsType } from "../../data/home";
export interface Props { data: typeof TestimonialsType; }
const { data } = Astro.props;
const featured = data.items[0];
---

<section class="section quotes">
  <div class="wrap">
    <p class="eyebrow">{data.eyebrow}</p>
    {featured && (
      <blockquote data-reveal="fade">
        <p>“{featured.quote}”</p>
        <footer>
          <strong>{featured.name}</strong>
          <span>{featured.role}, Udupi</span>
        </footer>
      </blockquote>
    )}
    <ul>
      {data.items.slice(1).map((t) => (
        <li>
          <strong>{t.name}</strong>
          <p>“{t.quote}”</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .quotes { background: var(--color-surface); }
  blockquote { margin: 1.4rem 0 4rem; max-width: 18ch; }
  blockquote p {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 5vw, 4rem);
    line-height: 1.08;
    font-weight: 400;
  }
  footer { margin-top: 1.8rem; display: grid; gap: 0.15rem; }
  footer strong { font-size: 0.95rem; }
  footer span { color: var(--color-ink-soft); font-size: 0.85rem; }
  ul {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem 4rem;
    border-top: 1px solid var(--color-line);
    padding-top: 2.5rem;
  }
  li strong { display: block; margin-bottom: 0.6rem; font-size: 0.9rem; }
  li p { color: var(--color-ink-soft); font-weight: 300; max-width: 48ch; }
  @media (max-width: 700px) {
    ul { grid-template-columns: 1fr; }
    blockquote { max-width: none; }
  }
</style>
