---
import Icon from "../global/UI/Icon.astro";
import StarRating from "../global/UI/StarRating.astro";
import type { testimonials as TestimonialsType } from "../../data/home";
export interface Props {
  data: typeof TestimonialsType;
}
const { data } = Astro.props;
---

<section class="section section--cream testimonials">
  <div class="wrap">
    <div
      class="section-heading"
      style="margin-inline:auto; text-align:center;"
      data-reveal="fade"
    >
      <p class="eyebrow" style="justify-content:center;">{data.eyebrow}</p>
      <h2>{data.title} <span class="accent">{data.titleAccent}</span></h2>
    </div>

    <div class="carousel" data-autoplay="6500">
      <div class="carousel__viewport">
        {
          data.items.map((t) => (
            <article class="testimonial-card chamfer-card">
              <Icon name="quote" class="testimonial-card__quote" />
              <StarRating rating={t.rating} />
              <p>{t.quote}</p>
              <footer>
                <span class="testimonial-card__avatar">{t.name.charAt(0)}</span>
                <span>
                  <strong>{t.name}</strong>
                  <em>{t.role}</em>
                </span>
              </footer>
            </article>
          ))
        }
      </div>
      <div class="carousel__controls">
        <div class="testi-dots">
          <button class="testi-dot active" aria-label="Go to slide 1"></button>
          <button class="testi-dot" aria-label="Go to slide 2"></button>
          <button class="testi-dot" aria-label="Go to slide 3"></button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .testi-dots {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 2rem;
  }
  .testi-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #e2bfb9;
    border: none;
    cursor: pointer;
    padding: 0;
    transition: all 0.3s ease;
  }
  .testi-dot.active, .testi-dot:hover {
    background: var(--color-primary, #6b1414);
    transform: scale(1.2);
  }
  .testimonial-card {
    flex: 0 0 calc(33.333% - 0.833rem); /* Display exactly 3 cards per row */
    padding: 2rem;
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }
  @media (max-width: 960px) {
    .testimonial-card {
      flex: 0 0 calc(50% - 0.625rem); /* 2 cards on tablet */
    }
  }
  @media (max-width: 600px) {
    .testimonial-card {
      flex: 0 0 84vw; /* 1 card on mobile */
    }
  }
  :global(.testimonial-card__quote) {
    position: absolute;
    top: 1.5rem;
    right: 1.6rem;
    width: 34px;
    height: 34px;
    color: var(--color-cream);
  }
  .testimonial-card p {
    color: var(--color-ink-soft);
    font-size: 0.96rem;
    line-height: 1.7;
  }
  .testimonial-card footer {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin-top: 0.4rem;
  }
  .testimonial-card__avatar {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: var(--color-primary);
    color: #fff;
    display: grid;
    place-items: center;
    font-family: var(--font-display);
    font-weight: 700;
    flex-shrink: 0;
  }
  .testimonial-card footer strong {
    display: block;
    font-size: 0.92rem;
  }
  .testimonial-card footer em {
    font-style: normal;
    font-size: 0.78rem;
    color: var(--color-ink-soft);
  }
</style>
