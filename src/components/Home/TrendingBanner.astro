---
import Icon from "../global/UI/Icon.astro";
import type { trendingBanner as TrendingBannerType } from "../../data/home";
export interface Props { data: typeof TrendingBannerType; }
const { data } = Astro.props;
---

<section class="show">
  <div class="show__media" data-media>
    <img src={data.image} alt="" />
  </div>
  <div class="show__veil"></div>
  <div class="wrap show__copy" data-reveal="fade">
    <p class="eyebrow light">{data.eyebrow}</p>
    <h2>{data.title}</h2>
    <p>{data.copy}</p>
    <a class="btn btn-ghost-light" href={data.cta.href}>{data.cta.label} <Icon name="arrow-right" /></a>
  </div>
</section>

<style>
  .show {
    position: relative;
    min-height: 78vh;
    display: grid;
    align-items: end;
    overflow: hidden;
    color: #fff;
  }
  .show__media { position: absolute; inset: 0; }
  .show__veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(36,28,24,0.05), rgba(36,28,24,0.72));
  }
  .show__copy {
    position: relative;
    z-index: 1;
    padding-block: 6rem;
    max-width: 38rem;
  }
  .eyebrow.light, .eyebrow.light::before { color: #e4c9a4; background: transparent; }
  .eyebrow.light::before { background: #e4c9a4; }
  h2 { color: #fff; max-width: 10ch; margin: 1rem 0 1.2rem; }
  p { color: rgba(255,255,255,0.8); margin-bottom: 2rem; max-width: 36ch; }
</style>
