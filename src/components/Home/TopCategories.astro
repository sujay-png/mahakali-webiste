---
import Icon from "../global/UI/Icon.astro";
import type { topCategories as TopCategoriesType } from "../../data/home";

export interface Props {
  data: typeof TopCategoriesType;
}

const { data } = Astro.props;
---

<section class="section categories">
  <div class="wrap">
    <div class="row-head">
      <div>
        <p class="eyebrow">{data.eyebrow}</p>
        <h2>{data.title}</h2>
      </div>
      <a href={data.viewAllHref} class="link-arrow">
        All collections <Icon name="arrow-right" />
      </a>
    </div>

    <div class="category-track" data-reveal-group>
      {
        data.items.map((item) => (
          <a href={item.href} class="cat-card" data-reveal="fade">
            <span class="cat-card__media">
              <img src={item.image} alt={item.name} loading="lazy" />
            </span>
            <span class="cat-card__meta">
              <strong>{item.name}</strong>
              <em>View collection</em>
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .category-track {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.75rem 1.4rem;
  }

  .cat-card {
    display: grid;
    gap: 1rem;
    text-decoration: none;
  }

  .cat-card__media {
    display: block;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--color-cream);
  }
  .cat-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s var(--ease);
  }
  .cat-card:hover .cat-card__media img { transform: scale(1.06); }

  .cat-card__meta {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }
  .cat-card__meta strong {
    font-family: var(--font-display);
    font-size: 1.45rem;
    font-weight: 500;
  }
  .cat-card__meta em {
    font-style: normal;
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-ink-soft);
  }

  @media (max-width: 900px) {
    .category-track { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 560px) {
    .category-track { grid-template-columns: 1fr; }
  }
</style>
