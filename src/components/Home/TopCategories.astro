---
import Icon from "../global/UI/Icon.astro";
import type { topCategories as TopCategoriesType } from "../../data/home";

export interface Props { data: typeof TopCategoriesType; }
const { data } = Astro.props;
const [featured, ...rest] = data.items;
---

<section class="section collections">
  <div class="wrap wrap--wide">
    <div class="row-head">
      <div>
        <p class="eyebrow">{data.eyebrow}</p>
        <h2 data-reveal="fade">{data.title}</h2>
      </div>
      <a href={data.viewAllHref} class="link-arrow">All collections <Icon name="arrow-right" /></a>
    </div>

    <div class="layout">
      {featured && (
        <a href={featured.href} class="featured" data-reveal="fade">
          <span class="featured__media" data-media>
            <img src={featured.image} alt={featured.name} loading="lazy" />
          </span>
          <span class="featured__copy">
            <small>Featured</small>
            <strong class="font-display">{featured.name}</strong>
            <em>Explore collection</em>
          </span>
        </a>
      )}
      <div class="rail" data-reveal-group>
        {rest.map((item) => (
          <a href={item.href} class="rail-item" data-reveal="fade">
            <span class="rail-item__media" data-media>
              <img src={item.image} alt={item.name} loading="lazy" />
            </span>
            <span>
              <strong>{item.name}</strong>
              <em>View</em>
            </span>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .row-head h2 { max-width: 14ch; }
  .layout {
    display: grid;
    grid-template-columns: 1.35fr 0.9fr;
    gap: 1.25rem;
    align-items: stretch;
  }
  .featured {
    position: relative;
    min-height: 72vh;
    color: #fff;
    overflow: hidden;
    display: block;
  }
  .featured__media { position: absolute; inset: 0; }
  .featured__copy {
    position: absolute;
    left: 2rem;
    bottom: 2rem;
    display: grid;
    gap: 0.4rem;
    z-index: 1;
  }
  .featured__copy small {
    letter-spacing: 0.2em;
    text-transform: uppercase;
    font-size: 0.68rem;
    color: #e4c9a4;
  }
  .featured__copy strong { font-size: clamp(2.4rem, 4vw, 4rem); color: #fff; }
  .featured__copy em { font-style: normal; letter-spacing: 0.16em; text-transform: uppercase; font-size: 0.7rem; }

  .rail { display: grid; gap: 1.25rem; }
  .rail-item {
    display: grid;
    grid-template-columns: 42% 1fr;
    gap: 1.2rem;
    align-items: center;
  }
  .rail-item__media { aspect-ratio: 4/3; }
  .rail-item strong {
    display: block;
    font-family: var(--font-display);
    font-size: 1.7rem;
    font-weight: 400;
  }
  .rail-item em {
    font-style: normal;
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-ink-soft);
  }

  @media (max-width: 900px) {
    .layout { grid-template-columns: 1fr; }
    .featured { min-height: 62vh; }
    .rail-item { grid-template-columns: 38% 1fr; }
  }
</style>
