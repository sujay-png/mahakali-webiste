---
import Icon from "../global/UI/Icon.astro";
import type { topCategories as TopCategoriesType } from "../../data/home";

export interface Props { data: typeof TopCategoriesType; }
const { data } = Astro.props;
---

<section class="collections">
  <div class="wrap wrap--wide">
    <div class="head">
      <div>
        <p class="eyebrow">{data.eyebrow}</p>
        <h2>{data.title}</h2>
      </div>
      <a href={data.viewAllHref} class="link-arrow">All collections <Icon name="arrow-right" /></a>
    </div>

    <ul class="index">
      {data.items.map((item, i) => (
        <li>
          <a href={item.href} class="item">
            <span class="media" data-media>
              <img src={item.image} alt={item.name} loading="lazy" />
            </span>
            <span class="meta">
              <small>{String(i + 1).padStart(2, "0")}</small>
              <strong class="font-display">{item.name}</strong>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .collections {
    padding-block: clamp(3rem, 6vw, 4.75rem);
  }
  .head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
    margin-bottom: 1.75rem;
  }
  h2 {
    max-width: 18ch;
    font-size: clamp(1.7rem, 2.6vw, 2.35rem);
    line-height: 1.15;
    font-weight: 500;
  }
  .index {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 0.85rem 1rem;
  }
  .item {
    display: grid;
    gap: 0.7rem;
    color: inherit;
  }
  .media {
    aspect-ratio: 5 / 4;
    background: var(--color-cream);
  }
  .meta {
    display: grid;
    gap: 0.15rem;
    padding-bottom: 0.35rem;
    border-bottom: 1px solid var(--color-line);
  }
  small {
    font-size: 0.62rem;
    letter-spacing: 0.16em;
    color: var(--color-gold);
  }
  strong {
    font-size: 1.05rem;
    font-weight: 500;
    line-height: 1.2;
  }
  .item:hover strong { color: var(--color-primary); }

  @media (max-width: 1100px) {
    .index { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 640px) {
    .index { grid-template-columns: repeat(2, 1fr); gap: 1rem 0.75rem; }
    h2 { font-size: 1.65rem; }
  }
</style>
