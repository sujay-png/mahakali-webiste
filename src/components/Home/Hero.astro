---
import Icon from "../global/UI/Icon.astro";

interface Slide {
  eyebrow: string;
  title: string;
  titleAccent: string;
  copy: string;
  ctaPrimary: { label: string; href: string };
  ctaSecondary: { label: string; href: string };
  image: { src: string; alt: string };
}

interface Props { slides: Slide[]; }
const { slides } = Astro.props;
---

<section class="hero" id="hero-section">
  <div class="panel">
    {slides.map((slide, index) => (
      <article class={`slide ${index === 0 ? "is-active" : ""}`} data-index={index}>
        <div class="copy">
          <span class="badge">{slide.eyebrow}</span>
          <h1>
            {slide.title} <em>{slide.titleAccent}</em>
          </h1>
          <p class="lede">{slide.copy}</p>
          <div class="actions">
            <a href={slide.ctaPrimary.href} class="btn btn-primary">
              {slide.ctaPrimary.label} <Icon name="arrow-right" />
            </a>
            <a href={slide.ctaSecondary.href} class="btn btn-ghost-light">
              {slide.ctaSecondary.label} <Icon name="arrow-right" />
            </a>
          </div>
        </div>
        <div class="stage">
          <span class="blob" aria-hidden="true"></span>
          <img
            class="product"
            src={slide.image.src}
            alt={slide.image.alt}
            fetchpriority={index === 0 ? "high" : "low"}
          />
        </div>
      </article>
    ))}

    <div class="pager">
      {slides.map((_, index) => (
        <button class={index === 0 ? "is-active" : ""} data-index={index} aria-label={`Slide ${index + 1}`}></button>
      ))}
    </div>
    <div class="arrows">
      <button type="button" data-dir="-1" aria-label="Previous slide"><Icon name="chevron-left" /></button>
      <button type="button" data-dir="1" aria-label="Next slide"><Icon name="chevron-right" /></button>
    </div>
  </div>
</section>

<style>
  .hero {
    background: var(--color-bg);
    padding: 6.5rem var(--gutter) 1.5rem;
  }
  .panel {
    position: relative;
    max-width: var(--max-wide);
    margin: 0 auto;
    min-height: min(72vh, 640px);
    background: linear-gradient(105deg, #6e3a2c 0%, #4c261d 58%, #3a1d16 100%);
    color: #f7f3ee;
    overflow: hidden;
    border-radius: 1.75rem;
  }
  .slide {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.55s ease;
  }
  .slide.is-active { opacity: 1; pointer-events: auto; z-index: 2; }

  .copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 3.5rem 2.5rem 5.5rem 4rem;
    max-width: 38rem;
  }
  .badge {
    align-self: flex-start;
    background: #e4c9a4;
    color: #4c261d;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 0.45rem 1.1rem 0.45rem 0.9rem;
    clip-path: polygon(0 0, calc(100% - 12px) 0, 100% 50%, calc(100% - 12px) 100%, 0 100%);
  }
  h1 {
    color: #fff;
    font-size: clamp(2.4rem, 4.6vw, 4.4rem);
    max-width: 100%;
    margin: 1.2rem 0 1rem;
    line-height: 1.05;
  }
  h1 em { font-style: italic; color: #e4c9a4; }
  .lede {
    color: rgba(247, 243, 238, 0.82);
    font-weight: 300;
    max-width: 42ch;
    margin-bottom: 1.8rem;
  }
  .actions { display: flex; flex-wrap: wrap; gap: 0.7rem; }

  .stage {
    position: relative;
    display: grid;
    place-items: center;
    perspective: 900px;
  }
  .blob {
    position: absolute;
    width: 78%;
    height: 78%;
    right: 4%;
    background: #e8d7a8;
    border-radius: 58% 42% 48% 52% / 48% 52% 48% 52%;
  }
  .product {
    position: relative;
    z-index: 1;
    max-width: min(78%, 460px);
    max-height: 72%;
    width: auto;
    height: auto;
    object-fit: contain;
    filter: drop-shadow(18px 32px 28px rgba(36, 28, 24, 0.38));
    transform: translate3d(0, 18px, 0) rotateY(-12deg);
    opacity: 0;
    transition: transform 0.8s var(--ease), opacity 0.6s ease;
    will-change: transform;
  }
  .slide.is-active .product {
    opacity: 1;
    transform: translate3d(0, 0, 0) rotateY(0deg);
    animation: float-product 5.5s ease-in-out 0.8s infinite;
  }

  .pager {
    position: absolute;
    left: 4rem;
    bottom: 2rem;
    z-index: 4;
    display: flex;
    gap: 0.45rem;
  }
  .pager button {
    width: 8px;
    height: 8px;
    border-radius: 99px;
    background: rgba(255,255,255,0.35);
    padding: 0;
  }
  .pager button.is-active { width: 26px; background: #fff; }

  .arrows {
    position: absolute;
    right: 1.4rem;
    bottom: 1.4rem;
    z-index: 4;
    display: flex;
    gap: 0.5rem;
  }
  .arrows button {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: #fff;
    color: var(--color-primary);
    display: grid;
    place-items: center;
  }
  .arrows button:hover { background: #e4c9a4; }

  @keyframes float-product {
    0%, 100% { transform: translate3d(0, 0, 0) rotateY(0deg); }
    50% { transform: translate3d(0, -10px, 0) rotateY(4deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .product, .slide.is-active .product {
      animation: none;
      transform: none;
      opacity: 1;
    }
  }

  @media (max-width: 900px) {
    .hero { padding-top: 5.5rem; }
    .panel { min-height: auto; border-radius: 1.15rem; }
    .slide {
      position: relative;
      grid-template-columns: 1fr;
      opacity: 1;
      pointer-events: none;
      display: none;
    }
    .slide.is-active { display: grid; pointer-events: auto; }
    .copy { padding: 2.2rem 1.5rem 1rem; }
    .stage { min-height: 280px; padding-bottom: 4.5rem; }
    .product { max-height: 240px; }
    .pager { left: 1.5rem; }
  }
</style>

<script>
  function initHero() {
    const root = document.getElementById("hero-section");
    if (!root || root.dataset.bound === "true") return;
    root.dataset.bound = "true";
    const slides = root.querySelectorAll(".slide");
    const dots = root.querySelectorAll(".pager button");
    const arrows = root.querySelectorAll(".arrows button");
    if (slides.length < 2) return;
    let current = 0;
    let timer: number;
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    function productEl(i: number) {
      return slides[i]?.querySelector(".product") as HTMLElement | null;
    }

    function go(i: number) {
      const next = ((i % slides.length) + slides.length) % slides.length;
      slides.forEach((s, n) => s.classList.toggle("is-active", n === next));
      dots.forEach((d, n) => d.classList.toggle("is-active", n === next));
      current = next;
    }
    function start() {
      window.clearInterval(timer);
      timer = window.setInterval(() => go(current + 1), 7000);
    }

    dots.forEach((dot) => {
      dot.addEventListener("click", () => {
        go(Number(dot.getAttribute("data-index")));
        start();
      });
    });
    arrows.forEach((btn) => {
      btn.addEventListener("click", () => {
        go(current + Number(btn.getAttribute("data-dir")));
        start();
      });
    });

    if (!reduce) {
      root.querySelectorAll(".stage").forEach((stage, index) => {
        stage.addEventListener("mousemove", (e) => {
          if (!slides[index].classList.contains("is-active")) return;
          const el = productEl(index);
          if (!el) return;
          const r = (stage as HTMLElement).getBoundingClientRect();
          const x = ((e as MouseEvent).clientX - r.left) / r.width - 0.5;
          const y = ((e as MouseEvent).clientY - r.top) / r.height - 0.5;
          el.style.animation = "none";
          el.style.transform = `translate3d(0, 0, 40px) rotateY(${(x * 18).toFixed(2)}deg) rotateX(${(-y * 10).toFixed(2)}deg)`;
        });
        stage.addEventListener("mouseleave", () => {
          const el = productEl(index);
          if (!el) return;
          el.style.transform = "";
          el.style.animation = "";
        });
      });
    }

    start();
  }
  initHero();
  document.addEventListener("astro:page-load", initHero);
</script>
