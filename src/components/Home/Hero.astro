---
import Icon from "../global/UI/Icon.astro";

interface Slide {
  eyebrow: string;
  title: string;
  titleAccent: string;
  copy: string;
  ctaPrimary: { label: string; href: string };
  ctaSecondary: { label: string; href: string };
  image: { src: string; alt: string };
}

interface Props { slides: Slide[]; }
const { slides } = Astro.props;
---

<section class="hero" id="hero-section">
  <div class="scene">
    <div class="slides">
      {slides.map((slide, index) => (
        <article class={`slide ${index === 0 ? "is-active" : ""}`} data-index={index}>
          <div class="slide__visual">
            <img class="slide__img" src={slide.image.src} alt={slide.image.alt} fetchpriority={index === 0 ? "high" : "low"} />
            <div class="slide__veil"></div>
          </div>
          <div class="wrap slide__copy">
            <p class="eyebrow light">{slide.eyebrow}</p>
            <h1>
              {slide.title} <em>{slide.titleAccent}</em>
            </h1>
            <p class="lede">{slide.copy}</p>
            <div class="actions">
              <a href={slide.ctaPrimary.href} class="btn btn-primary">
                {slide.ctaPrimary.label} <Icon name="arrow-right" />
              </a>
              <a href={slide.ctaSecondary.href} class="btn btn-ghost-light">
                {slide.ctaSecondary.label}
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
  <div class="pager">
    {slides.map((_, index) => (
      <button class={index === 0 ? "is-active" : ""} data-index={index} aria-label={`Slide ${index + 1}`}></button>
    ))}
  </div>
</section>

<style>
  .hero {
    position: relative;
    height: 100svh;
    min-height: 640px;
    color: #f7f3ee;
    overflow: hidden;
    background: #241c18;
    perspective: 1800px;
  }
  .scene {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
    transition: transform 0.7s var(--ease);
    will-change: transform;
  }
  .slides, .slide { position: absolute; inset: 0; transform-style: preserve-3d; }
  .slide {
    opacity: 0;
    pointer-events: none;
    transform: rotateY(26deg) translateZ(-160px) scale(0.92);
    transition: transform 1.15s var(--ease), opacity 0.85s ease;
  }
  .slide.is-prev {
    transform: rotateY(-26deg) translateZ(-160px) scale(0.92);
  }
  .slide.is-active {
    opacity: 1;
    pointer-events: auto;
    transform: rotateY(0deg) translateZ(24px) scale(1);
    z-index: 2;
  }

  .slide__visual {
    position: absolute;
    inset: 0;
    overflow: hidden;
    transform: translateZ(0);
  }
  .slide__img {
    position: absolute;
    inset: -4%;
    width: 108%;
    height: 108%;
    object-fit: cover;
    transform: scale(1.08);
    animation: ken 14s var(--ease) infinite alternate;
  }
  .slide.is-active .slide__img { animation-play-state: running; }

  .slide__veil {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(36, 28, 24, 0.72) 0%, rgba(36, 28, 24, 0.28) 46%, rgba(36, 28, 24, 0.18) 100%),
      linear-gradient(180deg, rgba(36, 28, 24, 0.25) 0%, transparent 30%, rgba(36, 28, 24, 0.45) 100%);
  }

  .slide__copy {
    position: relative;
    z-index: 3;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding-bottom: 8.5rem;
    max-width: 52rem;
    margin-left: 0;
    transform: translateZ(80px);
  }
  .eyebrow.light { color: #e4c9a4; }
  .eyebrow.light::before { background: #e4c9a4; }
  h1 {
    color: #fff;
    max-width: 14ch;
    margin: 1.2rem 0 1.4rem;
  }
  h1 em { font-style: italic; color: #e8d5bf; font-weight: 500; }
  .lede {
    max-width: 36rem;
    color: rgba(247, 243, 238, 0.82);
    font-weight: 300;
    margin-bottom: 2.2rem;
  }
  .actions { display: flex; flex-wrap: wrap; gap: 0.8rem; }

  .pager {
    position: absolute;
    right: var(--gutter);
    bottom: 3.2rem;
    z-index: 4;
    display: flex;
    gap: 0.5rem;
  }
  .pager button {
    width: 8px;
    height: 8px;
    border-radius: 99px;
    background: rgba(255,255,255,0.35);
    padding: 0;
    transition: width 0.45s var(--ease), background 0.45s var(--ease);
  }
  .pager button.is-active { width: 28px; background: #fff; }

  @keyframes ken {
    from { transform: scale(1.08); }
    to { transform: scale(1); }
  }

  @media (prefers-reduced-motion: reduce) {
    .slide, .scene { transform: none !important; transition: opacity 0.4s ease; }
    .slide__img { animation: none; transform: none; }
  }

  @media (max-width: 800px) {
    .hero { min-height: 100svh; }
    .slide__copy { padding-bottom: 6.5rem; transform: none; }
    h1 { max-width: 12ch; }
  }
</style>

<script>
  function initHero() {
    const root = document.getElementById("hero-section");
    if (!root || root.dataset.bound === "true") return;
    root.dataset.bound = "true";
    const scene = root.querySelector(".scene") as HTMLElement | null;
    const slides = root.querySelectorAll(".slide");
    const dots = root.querySelectorAll(".pager button");
    if (slides.length < 2) return;
    let current = 0;
    let timer: number;
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    function go(i: number) {
      const next = ((i % slides.length) + slides.length) % slides.length;
      slides.forEach((s, n) => {
        s.classList.toggle("is-active", n === next);
        s.classList.toggle("is-prev", n === current && n !== next);
      });
      dots.forEach((d, n) => d.classList.toggle("is-active", n === next));
      current = next;
    }
    function start() {
      window.clearInterval(timer);
      timer = window.setInterval(() => go(current + 1), 7000);
    }
    dots.forEach((dot) => {
      dot.addEventListener("click", () => {
        go(Number(dot.getAttribute("data-index")));
        start();
      });
    });

    if (scene && !reduce) {
      root.addEventListener("mousemove", (e) => {
        const r = root.getBoundingClientRect();
        const x = (e.clientX - r.left) / r.width - 0.5;
        const y = (e.clientY - r.top) / r.height - 0.5;
        scene.style.transform = `rotateX(${(-y * 5).toFixed(2)}deg) rotateY(${(x * 7).toFixed(2)}deg)`;
      });
      root.addEventListener("mouseleave", () => {
        scene.style.transform = "rotateX(0deg) rotateY(0deg)";
      });
    }

    start();
  }
  initHero();
  document.addEventListener("astro:page-load", initHero);
</script>
