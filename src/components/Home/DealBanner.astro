---
import Icon from "../global/UI/Icon.astro";
import type { dealBanner as DealBannerType } from "../../data/home";
export interface Props { data: typeof DealBannerType; }
const { data } = Astro.props;
---

<section class="deal section">
  <div class="deal-container wrap wrap--wide" data-reveal-group>
    <div class="deal-bg" data-reveal="fade"></div>
    
    <div class="content-wrapper">
      <div class="copy" data-reveal="up">
        <p class="eyebrow">{data.eyebrow}</p>
        <h2 class="font-display">{data.title}</h2>
        <p class="desc">{data.copy}</p>
        
        <div class="features">
          {data.features.map(f => (
            <span><Icon name="check" class="icon-sm" /> {f}</span>
          ))}
        </div>
        
        <div class="price-action">
          <div class="price">
            <b>{data.price}</b>
            <s>{data.oldPrice}</s>
          </div>
          <a class="btn btn-primary btn-large" href={data.cta.href}>
            {data.cta.label} <Icon name="arrow-right" />
          </a>
        </div>
      </div>
      
      <div class="visual" data-reveal="fade">
        <div class="image-wrapper">
          <img src={data.productImage} alt={data.title} loading="lazy" />
          <div class="discount-badge">Save<br/>10%</div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .deal {
    padding-block: clamp(4rem, 8vw, 6rem);
  }
  .deal-container {
    position: relative;
    border-radius: 24px;
    padding: clamp(3rem, 6vw, 5rem);
    display: flex;
    align-items: center;
    min-height: 600px;
    overflow: hidden;
  }
  .deal-bg {
    position: absolute;
    inset: 0;
    background: #1b1512;
    z-index: 1;
  }
  .content-wrapper {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
    width: 100%;
  }
  .copy {
    color: #fff;
  }
  .eyebrow {
    color: #e4c9a4;
    margin-bottom: 1.5rem;
  }
  h2 {
    font-size: clamp(2.5rem, 5vw, 4.2rem);
    line-height: 1.1;
    margin-bottom: 1.5rem;
    color: #fff;
  }
  .desc {
    color: rgba(255,255,255,0.7);
    font-size: 1.1rem;
    max-width: 45ch;
    margin-bottom: 2rem;
    line-height: 1.6;
  }
  .features {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    margin-bottom: 3rem;
  }
  .features span {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    color: rgba(255,255,255,0.85);
    font-size: 0.95rem;
  }
  .icon-sm {
    width: 16px;
    height: 16px;
    color: #e4c9a4;
  }
  .price-action {
    display: flex;
    align-items: center;
    gap: 2.5rem;
  }
  .price {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .price b {
    font-family: var(--font-display);
    font-size: 2.2rem;
    font-weight: 500;
    color: #fff;
    line-height: 1;
  }
  .price s {
    color: rgba(255,255,255,0.5);
    font-size: 1rem;
  }
  .btn-large {
    padding: 1.2rem 2.5rem;
    font-size: 0.85rem;
    background: #e4c9a4;
    color: #1b1512;
    border-color: #e4c9a4;
  }
  .btn-large:hover {
    background: #fff;
    border-color: #fff;
  }
  
  .visual {
    position: relative;
    display: flex;
    justify-content: center;
  }
  .image-wrapper {
    position: relative;
    width: 100%;
    max-width: 500px;
    aspect-ratio: 1;
    border-radius: 50%;
    background: rgba(255,255,255,0.03);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
  }
  .image-wrapper::before {
    content: '';
    position: absolute;
    inset: -20px;
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 50%;
    animation: spin 30s linear infinite;
  }
  .image-wrapper img {
    width: 110%;
    max-width: none;
    height: auto;
    object-fit: contain;
    transform: scale(1.1) rotate(-5deg);
    transition: transform 0.8s cubic-bezier(0.2, 0.8, 0.2, 1);
    filter: drop-shadow(0 20px 40px rgba(0,0,0,0.4));
  }
  .deal-container:hover .image-wrapper img {
    transform: scale(1.15) rotate(0deg) translateY(-10px);
  }
  .discount-badge {
    position: absolute;
    top: 10%;
    right: 5%;
    background: #e4c9a4;
    color: #1b1512;
    width: 90px;
    height: 90px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.2rem;
    line-height: 1.1;
    transform: rotate(15deg);
    box-shadow: 0 10px 20px rgba(0,0,0,0.2);
  }
  
  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  @media (max-width: 1024px) {
    .content-wrapper {
      grid-template-columns: 1fr;
      text-align: center;
      gap: 5rem;
    }
    .desc { margin-inline: auto; }
    .features { align-items: center; }
    .price-action { justify-content: center; }
  }
  @media (max-width: 768px) {
    .deal-container { padding: 3rem 1.5rem; border-radius: 16px; }
    h2 { font-size: 2.2rem; }
    .price-action { flex-direction: column; gap: 1.5rem; }
  }
</style>
