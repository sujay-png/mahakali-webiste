---
import Icon from "../global/UI/Icon.astro";
import type { dealBanner as DealBannerType } from "../../data/home";
export interface Props { data: typeof DealBannerType; }
const { data } = Astro.props;
---

<section class="deal">
  <div class="wrap wrap--wide grid">
    <div class="copy" data-reveal="fade">
      <p class="eyebrow">{data.eyebrow}</p>
      <h2>{data.title}</h2>
      <p>{data.copy}</p>
      <div class="price"><b>{data.price}</b> <s>{data.oldPrice}</s></div>
      <a class="btn btn-primary" href={data.cta.href}>{data.cta.label} <Icon name="arrow-right" /></a>
    </div>
    <div class="visual">
      <img src={data.productImage} alt={data.title} />
    </div>
  </div>
</section>

<style>
  .deal { padding-block: clamp(2.5rem, 5vw, 4rem); }
  .grid {
    display: grid;
    grid-template-columns: 1fr 0.85fr;
    gap: 2.5rem;
    align-items: center;
    background: var(--color-cream);
    padding: 2.2rem 2.4rem;
  }
  h2 { max-width: 14ch; margin: 0.7rem 0 0.9rem; font-size: clamp(1.8rem, 3vw, 2.6rem); }
  p { color: var(--color-ink-soft); font-weight: 300; max-width: 42ch; }
  .price { display: flex; gap: 0.9rem; align-items: baseline; margin: 1.2rem 0 1.5rem; }
  .price b { font-family: var(--font-display); font-size: 1.8rem; font-weight: 500; }
  .price s { color: var(--color-ink-soft); }
  .visual {
    background: var(--color-surface);
    min-height: 220px;
    display: grid;
    place-items: center;
    padding: 1.2rem;
  }
  .visual img {
    max-height: 240px;
    width: auto;
    object-fit: contain;
  }
  @media (max-width: 800px) {
    .grid { grid-template-columns: 1fr; padding: 1.5rem; }
  }
</style>
