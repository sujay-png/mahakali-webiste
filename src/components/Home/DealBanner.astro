---
import Icon from "../global/UI/Icon.astro";
import type { dealBanner as DealBannerType } from "../../data/home";
export interface Props { data: typeof DealBannerType; }
const { data } = Astro.props;
---

<section class="deal">
  <div class="media" data-media>
    <img src={data.productImage} alt={data.title} />
  </div>
  <div class="veil"></div>
  <div class="wrap copy" data-reveal="fade">
    <p class="eyebrow light">{data.eyebrow}</p>
    <h2>{data.title}</h2>
    <p>{data.copy}</p>
    <div class="price"><b>{data.price}</b> <s>{data.oldPrice}</s></div>
    <a class="btn btn-ghost-light" href={data.cta.href}>{data.cta.label} <Icon name="arrow-right" /></a>
  </div>
</section>

<style>
  .deal {
    position: relative;
    min-height: 72vh;
    display: grid;
    align-items: center;
    overflow: hidden;
    color: #fff;
  }
  .media, .veil { position: absolute; inset: 0; }
  .veil { background: linear-gradient(90deg, rgba(36,28,24,0.78) 0%, rgba(36,28,24,0.25) 70%); }
  .copy { position: relative; z-index: 1; padding-block: 7rem; max-width: 36rem; }
  .eyebrow.light, .eyebrow.light::before { color: #e4c9a4; }
  .eyebrow.light::before { background: #e4c9a4; }
  h2 { color: #fff; max-width: 12ch; margin: 1rem 0 1.2rem; }
  p { color: rgba(255,255,255,0.8); font-weight: 300; }
  .price { display: flex; gap: 1rem; align-items: baseline; margin: 1.6rem 0 2rem; }
  .price b { font-family: var(--font-display); font-size: 2.2rem; font-weight: 400; }
  .price s { opacity: 0.6; }
</style>
