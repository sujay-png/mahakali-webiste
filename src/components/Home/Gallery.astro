---
import type { gallery as GalleryType } from "../../data/home";
export interface Props { data: typeof GalleryType; }
const { data } = Astro.props;
---

<section class="section gallery">
  <div class="wrap wrap--wide">
    <div class="row-head">
      <div>
        <p class="eyebrow">{data.eyebrow}</p>
        <h2>{data.title} <em class="accent">{data.titleAccent}</em></h2>
      </div>
      <a href="/gallery" class="link-arrow">Open gallery</a>
    </div>
    <div class="mosaic" data-reveal-group>
      {data.images.map((img, i) => (
        <figure class={`cell cell--${i + 1}`} data-reveal="fade" data-media>
          <img src={img.src} alt={img.alt} loading="lazy" />
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  h2 { max-width: 12ch; }
  .mosaic {
    display: grid;
    grid-template-columns: 1.3fr 0.8fr 1fr;
    grid-template-rows: 280px 220px;
    gap: 0.9rem;
  }
  .cell { overflow: hidden; margin: 0; }
  .cell--1 { grid-row: 1 / 3; }
  .cell--4 { grid-column: 2 / 4; }
  @media (max-width: 800px) {
    .mosaic { grid-template-columns: 1fr 1fr; grid-template-rows: auto; }
    .cell--1, .cell--4 { grid-row: auto; grid-column: auto; }
    .cell { aspect-ratio: 4/3; }
  }
</style>
