---
import type { gallery as GalleryType } from "../../data/home";
export interface Props { data: typeof GalleryType; }
const { data } = Astro.props;
const rowA = [...data.images, ...data.images];
const rowB = [...data.images.slice().reverse(), ...data.images.slice().reverse()];
---

<section class="section gallery">
  <div class="wrap wrap--wide">
    <div class="row-head">
      <div>
        <p class="eyebrow">{data.eyebrow}</p>
        <h2>{data.title} <em class="accent">{data.titleAccent}</em></h2>
      </div>
      <a href="/gallery" class="link-arrow">Open gallery</a>
    </div>
  </div>

  <div class="gallery-marquee" aria-label="Photo gallery">
    <div class="marquee marquee--slow">
      <div class="marquee__track">
        {rowA.map((img, i) => (
          <a href="/gallery" class={`frame frame--${(i % 3) + 1}`} aria-hidden={i >= data.images.length ? "true" : undefined} tabindex={i >= data.images.length ? -1 : undefined}>
            <img src={img.src} alt={i >= data.images.length ? "" : img.alt} loading="lazy" />
          </a>
        ))}
      </div>
    </div>
    <div class="marquee marquee--slow marquee--reverse">
      <div class="marquee__track">
        {rowB.map((img, i) => (
          <a href="/gallery" class={`frame frame--${((i + 1) % 3) + 1}`} aria-hidden={i >= data.images.length ? "true" : undefined} tabindex={i >= data.images.length ? -1 : undefined}>
            <img src={img.src} alt="" loading="lazy" />
          </a>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  h2 { max-width: 14ch; }
  .gallery { padding-bottom: clamp(2rem, 4vw, 3rem); }
  .gallery-marquee {
    display: grid;
    gap: 1rem;
    perspective: 1200px;
  }
  .frame {
    position: relative;
    flex: 0 0 auto;
    overflow: hidden;
    background: var(--color-cream);
    transform: rotateY(-8deg) rotateX(2deg);
    transform-style: preserve-3d;
    transition: transform 0.7s var(--ease);
  }
  .frame--1 { width: min(28vw, 320px); aspect-ratio: 4 / 4.5; }
  .frame--2 { width: min(34vw, 400px); aspect-ratio: 16 / 9; }
  .frame--3 { width: min(24vw, 280px); aspect-ratio: 4 / 3; }
  .frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.08);
    transition: transform 1.1s var(--ease);
  }
  .frame:hover {
    transform: rotateY(0deg) rotateX(0deg) translateZ(28px);
    z-index: 2;
  }
  .frame:hover img { transform: scale(1); }
  @media (max-width: 700px) {
    .frame--1, .frame--2, .frame--3 { width: 68vw; }
  }
  @media (prefers-reduced-motion: reduce) {
    .frame { transform: none; }
  }
</style>
