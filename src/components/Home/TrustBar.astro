---
import type { trustBar as TrustBarType } from "../../data/home";
export interface Props { data: typeof TrustBarType; }
const { data } = Astro.props;
---

<section class="trust">
  <div class="wrap line">
    {data.map((item) => (
      <p><strong>{item.title}</strong><span>{item.copy}</span></p>
    ))}
  </div>
</section>

<style>
  .trust {
    border-block: 1px solid var(--color-line);
    background: var(--color-surface);
  }
  .line {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    padding-block: 1.6rem;
  }
  p {
    display: grid;
    gap: 0.15rem;
    padding-inline: 1.2rem;
    border-right: 1px solid var(--color-line);
  }
  p:first-child { padding-left: 0; }
  p:last-child { border-right: none; }
  strong {
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 500;
  }
  span { color: var(--color-ink-soft); font-size: 0.88rem; font-weight: 300; }
  @media (max-width: 800px) {
    .line { grid-template-columns: 1fr 1fr; row-gap: 1.2rem; }
    p { border-right: none; padding-inline: 0; }
  }
  @media (max-width: 480px) {
    .line { grid-template-columns: repeat(2, minmax(0, 1fr)); text-align: center; gap: 1.8rem 1rem; padding-block: 2rem; }
    p { gap: 0.35rem; padding-inline: 0.35rem; }
    p:nth-child(odd) { border-right: 1px solid var(--color-line); }
    strong { font-size: 0.72rem; line-height: 1.25; }
    span { font-size: 0.8rem; line-height: 1.35; }
  }
</style>
