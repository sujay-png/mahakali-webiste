---
import Icon from "../global/UI/Icon.astro";
import type { aboutSection as AboutSectionType } from "../../data/home";
export interface Props { data: typeof AboutSectionType; }
const { data } = Astro.props;
---

<section class="section about">
  <div class="wrap wrap--wide about__grid">
    <div class="copy" data-reveal="fade">
      <p class="eyebrow">{data.eyebrow}</p>
      <h2>Spaces deserve furniture with character.</h2>
      <p class="lead">{data.copy}</p>
      <p class="years">{data.badge}</p>
      <a class="btn btn-primary" href={data.cta.href}>{data.cta.label} <Icon name="arrow-right" /></a>
    </div>
    <div class="visual" data-reveal="right">
      <figure data-media class="main">
        <img src={data.images[0].src} alt={data.images[0].alt} loading="lazy" />
      </figure>
      <figure data-media class="side">
        <img src={data.images[1].src} alt={data.images[1].alt} loading="lazy" />
      </figure>
    </div>
  </div>
</section>

<style>
  .about__grid {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: center;
  }
  h2 { max-width: 11ch; margin: 1rem 0 1.5rem; }
  .lead { color: var(--color-ink-soft); font-weight: 300; max-width: 42ch; }
  .years {
    margin: 2rem 0 2.2rem;
    font-size: 0.72rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-gold);
  }
  .visual {
    display: grid;
    grid-template-columns: 1.4fr 0.8fr;
    gap: 1rem;
    align-items: end;
  }
  .main { aspect-ratio: 4/5; }
  .side { aspect-ratio: 3/4; margin-bottom: 12%; }
  @media (max-width: 900px) {
    .about__grid { grid-template-columns: 1fr; }
    .side { display: none; }
  }
</style>
