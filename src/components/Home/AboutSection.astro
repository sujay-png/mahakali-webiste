---
import Icon from "../global/UI/Icon.astro";
import type { aboutSection as AboutSectionType } from "../../data/home";
export interface Props {
  data: typeof AboutSectionType;
}
const { data } = Astro.props;
---

<section class="section section--cream about">
  <div class="wrap about__grid">
    <div class="about__collage" data-reveal="left">
      <img
        class="about__main"
        src={data.images[0].src}
        alt={data.images[0].alt}
        width="640"
        height="760"
        loading="lazy"
      />
      <img
        class="about__float about__float--1"
        src={data.images[1].src}
        alt={data.images[1].alt}
        width="220"
        height="180"
        loading="lazy"
      />
      <img
        class="about__float about__float--2"
        src={data.images[2].src}
        alt={data.images[2].alt}
        width="240"
        height="200"
        loading="lazy"
      />
      <span class="about__badge">
        <Icon name="medal" class="icon-22" />
        {data.badge}
      </span>
    </div>

    <div class="about__copy" data-reveal="right">
      <p class="eyebrow">{data.eyebrow}</p>
      <h2>
        {data.title} — <span class="accent">{data.titleAccent}</span>
        {data.titleTail}
      </h2>
      <p class="about__lead">{data.copy}</p>

      <ul class="about__bullets">
        {
          data.bullets.map((b) => (
            <li>
              <Icon name="tag" class="icon-16" />
              {b}
            </li>
          ))
        }
      </ul>

      <a class="btn btn-primary" href={data.cta.href}
        >{data.cta.label} <Icon name="arrow-right" /></a
      >
    </div>
  </div>
</section>

<style>
  .about__grid {
    display: grid;
    grid-template-columns: 0.95fr 1.05fr;
    gap: clamp(3rem, 6vw, 5rem);
    align-items: center;
  }

  .about__collage {
    position: relative;
    padding: 1.5rem 2.5rem 2.5rem 0;
  }
  .about__main {
    width: 100%;
    aspect-ratio: 4/5;
    object-fit: cover;
    box-shadow: var(--shadow-lg);
    clip-path: polygon(
      0 0,
      100% 0,
      100% calc(100% - 34px),
      calc(100% - 34px) 100%,
      0 100%
    );
  }
  .about__float {
    position: absolute;
    box-shadow: var(--shadow-md);
    object-fit: cover;
    border: 5px solid var(--color-surface);
  }
  .about__float--1 {
    top: 0;
    right: 0;
    width: 42%;
    aspect-ratio: 5/4;
  }
  .about__float--2 {
    bottom: 0;
    right: 1rem;
    width: 46%;
    aspect-ratio: 6/5;
  }

  .about__badge {
    position: absolute;
    left: -0.5rem;
    top: 2.5rem;
    background: var(--color-gold);
    color: var(--color-walnut);
    font-weight: 700;
    font-size: 0.82rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1rem;
    box-shadow: var(--shadow-md);
  }
  :global(.icon-22) {
    width: 20px;
    height: 20px;
  }

  .about__lead {
    margin-top: 1.1rem;
    color: var(--color-ink-soft);
    max-width: 58ch;
  }
  .about__bullets {
    margin-top: 1.5rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.8rem 1.5rem;
  }
  .about__bullets li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 600;
    font-size: 0.92rem;
    color: var(--color-walnut);
  }
  :global(.icon-16) {
    width: 15px;
    height: 15px;
    color: var(--color-primary);
    flex-shrink: 0;
  }
  .about__copy .btn {
    margin-top: 2.1rem;
  }

  @media (max-width: 900px) {
    .about__grid {
      grid-template-columns: 1fr;
    }
    .about__collage {
      padding: 1rem 1.5rem 2rem 0;
      max-width: 420px;
      margin-inline: auto;
    }
    .about__bullets {
      grid-template-columns: 1fr;
    }
  }
</style>
