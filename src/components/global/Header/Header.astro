---
import Icon from "../UI/Icon.astro";
import { mainNav } from "../../../data/site";
import { CATALOG_CATEGORIES } from "../../../lib/woocommerce/categories";

const isHome = Astro.url.pathname === "/" || Astro.url.pathname === "";
---

<header class={`site-header ${isHome ? "is-overlay" : ""}`}>
  <div class="header__inner">
    <a href="/" class="brand">
      <img src="/images/new-logo.png" alt="Mahakali Home Furnitures" class="brand-logo-img" />
    </a>

    <nav class="desktop-nav" aria-label="Primary">
      <ul>
        {
          mainNav.filter((item) => !["User Dashboard", "Contact Us"].includes(item.label)).map((item) => {
            const isActive =
              Astro.url.pathname === item.href ||
              (item.href !== "/" && Astro.url.pathname.startsWith(item.href));
            return (
              <li class={item.children ? "has-children" : ""}>
                <a href={item.href} class={isActive ? "is-active" : ""}>
                  {item.label}
                  {item.children && <Icon name="chevron-down" class="icon-10 caret" />}
                </a>
                {item.children && (
                  <div class="mega">
                    <div class="mega__head">
                      <p>Collections</p>
                      <a href="/products">View all</a>
                    </div>
                    <ul>
                      {CATALOG_CATEGORIES.map((cat, i) => (
                        <li>
                          <a href={`/products/${cat.slug}`}>
                            <img src={cat.heroImage} alt="" />
                            <span>
                              <small>{String(i + 1).padStart(2, "0")}</small>
                              <strong>{cat.navLabel}</strong>
                            </span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
              </li>
            );
          })
        }
      </ul>
    </nav>

    <div class="header__actions">
      <a href="/contact" class="btn-inquiry">Visit Showroom</a>
      <button
        class="icon-action nav-toggle"
        type="button"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        id="nav-toggle"
      >
        <span class="toggle-bars" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>

<div id="mobile-menu" class="mobile-menu" hidden>
  <div class="mobile-menu__inner">
    <p class="menu-kicker">Menu</p>
    <nav aria-label="Mobile">
      <ul class="menu-links">
        {mainNav.filter((item) => !["User Dashboard", "Contact Us"].includes(item.label)).map((item, i) => (
          <li style={`--d: ${0.08 + i * 0.06}s`}>
            {item.children ? (
              <div class="menu-group">
                <a href={item.href} class="menu-link">
                  <span>{item.label}</span>
                  <Icon name="chevron-down" class="menu-chevron" />
                </a>
                <ul class="menu-sub">
                  {item.children.map((child) => (
                    <li><a href={child.href}>{child.label}</a></li>
                  ))}
                </ul>
              </div>
            ) : (
              <a href={item.href} class="menu-link">{item.label}</a>
            )}
          </li>
        ))}
      </ul>
    </nav>
    <a href="/contact" class="btn btn-primary menu-cta">Visit showroom</a>
  </div>
</div>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 120;
    background: rgba(244, 239, 232, 0.92);
    backdrop-filter: blur(18px);
    border-bottom: 1px solid rgba(36, 28, 24, 0.06);
    transition: background 0.45s var(--ease), border-color 0.45s var(--ease);
  }

  .site-header.is-overlay {
    position: fixed;
    width: 100%;
    background: transparent;
    border-bottom-color: rgba(36, 28, 24, 0.08);
  }

  .site-header.is-scrolled,
  .site-header.is-overlay.is-scrolled {
    background: rgba(244, 239, 232, 0.96);
    border-bottom-color: rgba(36, 28, 24, 0.08);
  }
  .site-header.is-menu-open {
    position: fixed;
    top: 0;
    width: 100%;
    background: rgba(244, 239, 232, 0.96);
    border-bottom-color: rgba(36, 28, 24, 0.08);
  }
  .site-header.is-menu-open .nav-toggle { color: var(--color-ink); }
  .site-header.is-menu-open .brand-logo-img { filter: none; mix-blend-mode: multiply; }
  .site-header.is-menu-open .toggle-bars,
  .site-header.is-menu-open .toggle-bars::before,
  .site-header.is-menu-open .toggle-bars::after { background: var(--color-ink); }

  .header__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding-block: 1.05rem;
    padding-inline: var(--gutter);
    max-width: var(--max-wide);
    margin: 0 auto;
  }
  .brand { justify-self: start; z-index: 130; }
  .desktop-nav { justify-self: center; }
  .header__actions { justify-self: end; display: flex; align-items: center; gap: 0.8rem; z-index: 130; }

  .brand-logo-img {
    height: 63px;
    width: auto;
    object-fit: contain;
    mix-blend-mode: multiply;
  }
  @media (max-width: 900px) {
    .brand-logo-img {
      height: 44px;
    }
  }

  .desktop-nav > ul { display: flex; align-items: center; gap: 1.8rem; }
  .desktop-nav > ul > li { position: relative; }
  .desktop-nav > ul > li > a {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-family: var(--font-nav);
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    padding-block: 0.5rem;
  }
  .desktop-nav > ul > li > a.is-active::after,
  .desktop-nav > ul > li > a:hover::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0.15rem;
    width: 100%;
    height: 1px;
    background: currentColor;
  }
  .caret { transition: transform 0.35s var(--ease); }
  .has-children:hover .caret { transform: rotate(180deg); }
  .has-children::after {
    content: "";
    position: absolute;
    top: 100%;
    left: 0;
    width: 100%;
    height: 18px;
  }

  .mega {
    position: absolute;
    top: calc(100% + 10px);
    left: 50%;
    transform: translate(-50%, 12px);
    width: min(680px, 88vw);
    background: var(--color-bg);
    color: var(--color-ink);
    border: 1px solid var(--color-line);
    padding: 1.2rem 1.3rem 1.1rem;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.35s var(--ease), transform 0.35s var(--ease), visibility 0.35s;
    z-index: 140;
    box-shadow: var(--shadow-md);
  }
  .has-children:hover .mega,
  .has-children:focus-within .mega {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, 0);
    pointer-events: auto;
  }
  .mega__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 0.9rem;
    padding-bottom: 0.7rem;
    border-bottom: 1px solid var(--color-line);
  }
  .mega__head p {
    font-size: 0.66rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-gold);
  }
  .mega__head a { font-size: 0.78rem; color: var(--color-primary); }
  .mega ul {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.15rem 1rem;
  }
  .mega a {
    display: grid;
    grid-template-columns: 46px 1fr;
    gap: 0.75rem;
    align-items: center;
    padding: 0.45rem 0.2rem;
    text-transform: none;
    letter-spacing: 0;
  }
  .mega img {
    width: 46px;
    height: 46px;
    object-fit: cover;
    background: var(--color-cream);
  }
  .mega small {
    display: block;
    font-size: 0.6rem;
    letter-spacing: 0.14em;
    color: var(--color-gold);
  }
  .mega strong {
    display: block;
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 500;
    color: var(--color-ink);
  }
  .mega a:hover strong { color: var(--color-primary); }

  .btn-inquiry {
    border: 1px solid rgba(36, 28, 24, 0.2);
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    padding: 0.75rem 1.2rem;
  }
  .btn-inquiry:hover { background: var(--color-primary); border-color: var(--color-primary); color: #fff; }

  .nav-toggle {
    display: none;
    width: 44px;
    height: 44px;
    place-items: center;
    position: relative;
    z-index: 130;
  }
  .toggle-bars {
    width: 18px;
    height: 1.5px;
    background: var(--color-ink);
    position: relative;
    display: block;
    transition: background 0.3s;
  }
  .toggle-bars::before,
  .toggle-bars::after {
    content: "";
    position: absolute;
    left: 0;
    width: 18px;
    height: 1.5px;
    background: inherit;
    border-radius: 999px;
    transition: transform 0.35s var(--ease), top 0.35s var(--ease);
  }
  .toggle-bars::before { top: -6px; }
  .toggle-bars::after { top: 6px; }
  .site-header.is-menu-open .toggle-bars { background: transparent; }
  .site-header.is-menu-open .toggle-bars::before { top: 0; transform: rotate(45deg); background: var(--color-ink); }
  .site-header.is-menu-open .toggle-bars::after { top: 0; transform: rotate(-45deg); background: var(--color-ink); }

  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 110;
    background: #1b1512;
    color: #f4efe8;
    display: grid;
    align-items: start;
    overflow-y: auto;
    padding: 5.25rem var(--gutter) 1.5rem;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.45s var(--ease), visibility 0.45s;
  }
  .mobile-menu.is-open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }
  .menu-kicker {
    font-size: 0.68rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #e4c9a4;
    margin-bottom: 1rem;
  }
  .menu-links { display: grid; gap: 0.75rem; }
  .menu-link {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    font-family: var(--font-display);
    font-size: clamp(2rem, 8.5vw, 3.1rem);
    line-height: 1.04;
    color: #fff;
    transform: translateY(24px);
    opacity: 0;
  }
  :global(.menu-chevron) {
    width: 1.4rem;
    height: 1.4rem;
    margin-left: 1rem;
    transition: transform 0.35s var(--ease);
  }
  :global(.menu-group.is-open .menu-chevron) { transform: rotate(180deg); }
  .mobile-menu.is-open .menu-link,
  .mobile-menu.is-open .menu-group {
    animation: menu-rise 0.7s var(--ease) both;
    animation-delay: var(--d, 0.1s);
  }
  .menu-sub {
    display: none;
    padding: 0.4rem 0 0.8rem 0.2rem;
    gap: 0.35rem;
  }
  .menu-group.is-open .menu-sub { display: grid; }
  .menu-sub a {
    color: rgba(244,239,232,0.7);
    font-size: 1rem;
  }
  .menu-cta { margin-top: 1.6rem; }

  @keyframes menu-rise {
    from { opacity: 0; transform: translateY(28px); }
    to { opacity: 1; transform: none; }
  }

  @media (max-width: 1080px) {
    .header__inner {
      grid-template-columns: auto 1fr auto;
      gap: 0.75rem;
    }
    .desktop-nav, .btn-inquiry { display: none; }
    .nav-toggle { display: grid; }
  }
  @media (max-width: 480px) {
    .header__inner { padding-block: 0.75rem; }
    .brand-logo-img { height: 38px; }
    .nav-toggle { width: 40px; height: 40px; border-radius: 50%; }
    .mobile-menu { padding-top: 4.75rem; }
  }
  @media (max-width: 360px) {
    .brand-logo-img { height: 32px; }
    .header__inner { gap: 0.5rem; }
  }
</style>

<script>
  function syncHeaderState() {
    const header = document.querySelector(".site-header");
    header?.classList.toggle("is-scrolled", window.scrollY > 24);
  }

  function setMenu(open: boolean) {
    const header = document.querySelector(".site-header");
    const menu = document.getElementById("mobile-menu");
    const toggle = document.getElementById("nav-toggle");
    header?.classList.toggle("is-menu-open", open);
    menu?.classList.toggle("is-open", open);
    if (menu) menu.hidden = !open;
    toggle?.setAttribute("aria-expanded", String(open));
    toggle?.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    document.body.style.overflow = open ? "hidden" : "";
  }

  function initHeader() {
    const toggle = document.getElementById("nav-toggle");
    const menu = document.getElementById("mobile-menu");
    if (toggle instanceof HTMLElement && toggle.dataset.bound !== "true") {
      toggle.dataset.bound = "true";
      toggle.addEventListener("click", (e) => {
        e.stopPropagation();
        const open = !menu?.classList.contains("is-open");
        setMenu(open);
      });
    }

    menu?.querySelectorAll(".menu-group > .menu-link").forEach((link) => {
      if (!(link instanceof HTMLElement) || link.dataset.bound === "true") return;
      link.dataset.bound = "true";
      link.addEventListener("click", (e) => {
        e.preventDefault();
        link.parentElement?.classList.toggle("is-open");
      });
    });

    syncHeaderState();
  }

  if (!window.__mahakaliHeaderScroll) {
    window.__mahakaliHeaderScroll = true;
    window.addEventListener("scroll", syncHeaderState, { passive: true });
  }

  initHeader();
  document.addEventListener("astro:page-load", () => {
    setMenu(false);
    initHeader();
  });
</script>
