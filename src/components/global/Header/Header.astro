---
import Icon from "../UI/Icon.astro";
import { mainNav } from "../../../data/site";
---

<header class="site-header">
  <div class="header__inner">
    <a href="/" class="brand">
      <img src="/images/new-logo.png" alt="Mahakali Furnishing" class="brand-logo-img" />
    </a>

    <nav class="nav" id="primary-nav" aria-label="Primary">
      <ul>
        {
          mainNav.map((item) => {
            const isActive =
              Astro.url.pathname === item.href ||
              (item.href !== "/" && Astro.url.pathname.startsWith(item.href));
            return (
              <li class={item.children ? "has-children" : ""}>
                <a href={item.href} class={isActive ? "is-active" : ""}>
                  {item.label}
                  {item.children && (
                    <Icon name="chevron-down" class="icon-10 caret" />
                  )}
                </a>
                {item.children && (
                  <ul class="dropdown">
                    {item.children.map((child) => (
                      <li>
                        <a href={child.href}>{child.label}</a>
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            );
          })
        }
      </ul>
    </nav>

    <div class="header__actions">
      <a href="/contact/" class="btn-inquiry">Enquire</a>
      <button
        class="icon-action nav-toggle"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="primary-nav"
        id="nav-toggle"
      >
        <Icon name="menu" class="icon-22" />
      </button>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(247, 243, 238, 0.88);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    border-bottom: 1px solid rgba(42, 34, 28, 0.06);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 1.05rem;
    padding-inline: var(--gutter);
    max-width: 1320px;
    margin: 0 auto;
  }

  .brand-logo-img {
    height: 42px;
    width: auto;
    object-fit: contain;
    mix-blend-mode: multiply;
  }

  .nav ul {
    display: flex;
    align-items: center;
    gap: 2.2rem;
  }
  .nav > ul > li { position: relative; }
  .nav > ul > li > a {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-weight: 400;
    font-size: 0.82rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-ink);
    padding-block: 0.35rem;
  }
  .nav > ul > li > a:hover,
  .nav > ul > li > a.is-active { color: var(--color-primary); }

  .caret { transition: transform 0.35s var(--ease); }
  .has-children:hover .caret,
  .has-children:focus-within .caret,
  .has-children.is-open .caret { transform: rotate(180deg); }
  .has-children::after {
    content: "";
    position: absolute;
    top: 100%;
    left: 0;
    width: 100%;
    height: 18px;
  }

  .nav .dropdown {
    position: absolute;
    top: 100%;
    left: 0;
    transform: translateY(12px);
    background: rgba(247, 243, 238, 0.97);
    backdrop-filter: blur(18px);
    border: 1px solid var(--color-line);
    padding: 0.7rem 0;
    min-width: 240px;
    max-height: min(70vh, 480px);
    overflow-y: auto;
    box-shadow: var(--shadow-md);
    opacity: 0;
    visibility: hidden;
    transition: all 0.4s var(--ease);
    pointer-events: none;
    z-index: 1050;
  }
  .has-children:hover .dropdown,
  .has-children:focus-within .dropdown,
  .has-children.is-open .dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateY(6px);
    pointer-events: auto;
  }
  .dropdown li a {
    display: block;
    padding: 0.55rem 1.2rem;
    font-size: 0.82rem;
  }
  .dropdown li a:hover { color: var(--color-primary); }

  .header__actions { display: flex; align-items: center; gap: 0.8rem; }
  .btn-inquiry {
    border: 1px solid rgba(42, 34, 28, 0.18);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    padding: 0.7rem 1.3rem;
    border-radius: 999px;
    transition: background 0.35s var(--ease), color 0.35s var(--ease), border-color 0.35s var(--ease);
  }
  .btn-inquiry:hover {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: #fff;
  }
  .icon-action { display: grid; place-items: center; cursor: pointer; }
  .icon-22 { width: 22px; height: 22px; }
  .nav-toggle { display: none; }

  @media (max-width: 960px) {
    .nav {
      position: fixed;
      inset: 0 0 0 auto;
      width: min(320px, 86vw);
      background: var(--color-bg);
      transform: translateX(100%);
      transition: transform 0.45s var(--ease);
      box-shadow: var(--shadow-lg);
      padding: 5.5rem 1.8rem 2rem;
      overflow-y: auto;
    }
    .nav.is-open { transform: translateX(0); }
    .nav ul { flex-direction: column; align-items: flex-start; gap: 1.1rem; width: 100%; }
    .nav > ul > li { width: 100%; }
    .dropdown {
      position: static;
      box-shadow: none;
      border: none;
      background: transparent;
      opacity: 1;
      visibility: visible;
      transform: none;
      display: none;
    }
    .has-children.is-open .dropdown { display: block; }
    .nav-toggle { display: grid; }
    .btn-inquiry { display: none; }
  }
</style>

<script>
  const toggle = document.getElementById("nav-toggle");
  const nav = document.getElementById("primary-nav");
  const header = document.querySelector(".site-header");

  function syncHeaderState() {
    header?.classList.toggle("is-scrolled", window.scrollY > 12);
  }

  function initHeader() {
    toggle?.addEventListener("click", () => {
      const isOpen = nav?.classList.toggle("is-open");
      toggle.setAttribute("aria-expanded", String(!!isOpen));
    });

    document.querySelectorAll(".nav .has-children > a").forEach((link) => {
      link.addEventListener("click", (e) => {
        if (window.innerWidth <= 960) {
          e.preventDefault();
          (link.parentElement as HTMLElement).classList.toggle("is-open");
        }
      });
    });

    syncHeaderState();
  }

  initHeader();
  document.addEventListener("astro:page-load", () => {
    initHeader();
    syncHeaderState();
  });
  window.addEventListener("scroll", syncHeaderState, { passive: true });
</script>
