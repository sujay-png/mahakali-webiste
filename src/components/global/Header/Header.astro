---
import Icon from "../UI/Icon.astro";
import { siteInfo, mainNav } from "../../../data/site";
---

<header class="site-header">
  <div class="header__inner">
    {/* Logo */}
    <a href="/" class="brand">
      <img src="/images/new-logo.png" alt="Mahakali Furnishing" class="brand-logo-img" />
    </a>

    {/* Navigation */}
    <nav class="nav" id="primary-nav" aria-label="Primary">
      <ul>
        {
          mainNav.map((item) => {
            const isActive =
              Astro.url.pathname === item.href ||
              (item.href !== "/" && Astro.url.pathname.startsWith(item.href));
            return (
              <li class={item.children ? "has-children" : ""}>
                <a href={item.href} class={isActive ? "is-active" : ""}>
                  {item.label}
                  {item.children && (
                    <Icon name="chevron-down" class="icon-10 caret" />
                  )}
                </a>
                {item.children && (
                  <ul class="dropdown">
                    {item.children.map((child) => (
                      <li>
                        <a href={child.href}>{child.label}</a>
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            );
          })
        }
      </ul>
    </nav>

    {/* Actions */}
    <div class="header__actions">
      <button class="icon-action search-btn" aria-label="Search"
        ><Icon name="search" class="icon-22" /></button
      >
      <button class="icon-action cart-btn" aria-label="Cart"
        ><Icon name="bag" class="icon-22" /></button
      >
      <a href="/contact/" class="btn-inquiry"> Inquire </a>
      <button
        class="icon-action nav-toggle"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="primary-nav"
        id="nav-toggle"
      >
        <Icon name="menu" class="icon-22" />
      </button>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
     background: rgba(243, 238, 228, 0.85);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid transparent;
    border-bottom: 1px solid rgba(139, 74, 59, 0.1);
    border-radius: 0;
    transition: all 0.4s cubic-bezier(0.22, 1, 0.36, 1);
    max-width: 100%;
    width: 100%;
    margin: 0 auto;
  }

  .site-header.is-scrolled {
    top: 15px;
    background: rgba(243, 238, 228, 0.85);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(139, 74, 59, 0.15);
    border-radius: 10px;
    max-width: 1450px;
    width: calc(100% - 30px);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 16px; 
    padding-inline: clamp(1.5rem, 3vw, 2.5rem);
    max-width: 1450px;
    margin: 0 auto;
    transition: padding-block 0.4s ease;
  }

  .site-header.is-scrolled .header__inner {
    padding-block: 10px;
  }

  .brand-logo-img {
  height: 59px;
    width: auto;
    object-fit: contain;
    mix-blend-mode: multiply;  /* Helps hide the white background if the header isn't pure white */
  }

  .nav ul {
    display: flex;
    align-items: center;
    gap: 40px; /* evenly spaced ~40px */
  }
  .nav > ul > li {
    position: relative;
  }
  .nav > ul > li > a {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-family: var(--font-nav);
    font-weight: 500;
    font-size: 1.05rem;
    color: #1a1a1a; /* black/near-black */
    padding-block: 0.2rem;
    position: relative;
    text-underline-offset: 6px;
    transition: color 0.2s ease;
    text-decoration: none;
  }

  .nav > ul > li > a:hover {
    color: #8b4a3b;
  }

  .nav > ul > li > a.is-active {
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: #8b4a3b;
    text-decoration-thickness: 1.5px;
  }

  .caret {
    transition: transform 0.3s ease;
    margin-top: -1px;
  }
  .has-children:hover .caret,
  .has-children:focus-within .caret,
  .has-children.is-open .caret {
    transform: rotate(180deg);
  }

  .has-children::after {
    content: "";
    position: absolute;
    top: 100%;
    left: 0;
    width: 100%;
    height: 20px;
  }

  .nav .dropdown {
    position: absolute;
    top: 100%;
    left: 0;
    transform: translateY(10px);
    background: rgba(243, 238, 228, 0.97);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid var(--color-line);
    border-radius: 14px;
    padding: 8px 0;
    min-width: 260px;
    max-height: min(70vh, 480px);
    overflow-y: auto;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
    list-style: none;
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    pointer-events: none;
    z-index: 1050;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
    align-items: stretch;
  }
  .has-children:hover .dropdown,
  .has-children:focus-within .dropdown,
  .has-children.is-open .dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateY(4px);
    pointer-events: auto;
  }

  .dropdown li {
    width: 100%;
  }

  .dropdown li a {
    display: block;
    padding: 10px 20px;
    color: #1a1a1a;
    font-family: var(--font-nav);
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    transition:
      background 0.2s ease,
      color 0.2s ease;
    white-space: nowrap;
  }
  .dropdown li a:hover {
    background: rgba(139, 74, 59, 0.05);
    color: #8b4a3b;
    font-weight: 700;
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: 1.2rem; /* evenly spaced icons */
  }

  .btn-inquiry {
    position: relative;
    background: #8b4a3b; /* solid rust-brown fill */
    color: #ffffff; /* white serif text */
    font-family: var(--font-nav);
    font-size: 0.95rem;
    font-weight: 500;
    padding: 0.65rem 1.8rem; /* generous horizontal padding */
    border-radius: 9999px; /* fully rounded corners (pill) */
    text-decoration: none;
    transition:
      background 0.2s ease,
      transform 0.2s ease,
      box-shadow 0.2s ease;
    margin-left: 0.8rem;
  }
  .btn-inquiry:hover {
    background: #733c30;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(139, 74, 59, 0.3);
  }

  .cart-btn {
    /* removed margin-left since it's no longer the last item */
  }

  .icon-action {
    display: grid;
    place-items: center;
    color: #1a1a1a;
    transition: color 0.2s ease;
    background: transparent;
    border: none;
    cursor: pointer;
  }
  .icon-action:hover {
    color: #8b4a3b;
  }
  .icon-22 {
    width: 22px;
    height: 22px;
  }
  .icon-22 {
    width: 22px;
    height: 22px;
  }
  .nav-toggle {
    display: none;
  }

  @media (max-width: 960px) {
    .nav {
      position: fixed;
      inset: 0 0 0 auto;
      width: min(320px, 85vw);
      background: #f3eee4;
      transform: translateX(100%);
      transition: transform 0.3s var(--ease);
      box-shadow: var(--shadow-lg);
      padding: 5rem 1.5rem 2rem;
      overflow-y: auto;
    }
    .nav.is-open {
      transform: translateX(0);
    }
    .nav ul {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
      width: 100%;
    }
    .nav > ul > li {
      width: 100%;
    }
    .dropdown {
      position: static;
      box-shadow: none;
      border: none;
      background: transparent;
      opacity: 1;
      visibility: visible;
      transform: none;
      display: none;
      padding-left: 1rem;
    }
    .has-children.is-open .dropdown {
      display: block;
    }
    .nav-toggle {
      display: grid;
    }
    .btn-inquiry {
      display: none;
    }
  }
</style>

<script>
  const toggle = document.getElementById("nav-toggle");
  const nav = document.getElementById("primary-nav");
  const header = document.querySelector('.site-header');

  function syncHeaderState() {
    const shouldScroll = window.scrollY > 20;
    header?.classList.toggle('is-scrolled', shouldScroll);
  }

  function initHeader() {
    toggle?.addEventListener("click", () => {
      const isOpen = nav?.classList.toggle("is-open");
      toggle.setAttribute("aria-expanded", String(!!isOpen));
    });

    document.querySelectorAll(".nav .has-children > a").forEach((link) => {
      link.addEventListener("click", (e) => {
        if (window.innerWidth <= 960) {
          e.preventDefault();
          (link.parentElement as HTMLElement).classList.toggle("is-open");
        }
      });
    });

    syncHeaderState();
  }

  initHeader();
  document.addEventListener('astro:page-load', () => {
    window.scrollTo({ top: 0, behavior: 'instant' });
    initHeader();
    syncHeaderState();
  });

  window.addEventListener('scroll', syncHeaderState, { passive: true });
</script>
