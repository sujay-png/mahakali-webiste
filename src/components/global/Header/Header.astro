---
import Icon from "../UI/Icon.astro";
import { mainNav } from "../../../data/site";

const isHome = Astro.url.pathname === "/" || Astro.url.pathname === "";
---

<header class={`site-header ${isHome ? "is-overlay" : ""}`}>
  <div class="header__inner">
    <a href="/" class="brand">
      <img src="/images/new-logo.png" alt="Mahakali Home Furnitures" class="brand-logo-img" />
    </a>

    <nav class="nav" id="primary-nav" aria-label="Primary">
      <ul>
        {
          mainNav.map((item) => {
            const isActive =
              Astro.url.pathname === item.href ||
              (item.href !== "/" && Astro.url.pathname.startsWith(item.href));
            return (
              <li class={item.children ? "has-children" : ""}>
                <a href={item.href} class={isActive ? "is-active" : ""}>
                  {item.label}
                  {item.children && <Icon name="chevron-down" class="icon-10 caret" />}
                </a>
                {item.children && (
                  <ul class="dropdown">
                    {item.children.map((child) => (
                      <li>
                        <a href={child.href}>{child.label}</a>
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            );
          })
        }
      </ul>
    </nav>

    <div class="header__actions">
      <a href="/contact" class="btn-inquiry">Visit Showroom</a>
      <button
        class="icon-action nav-toggle"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="primary-nav"
        id="nav-toggle"
      >
        <Icon name="menu" class="icon-22" />
      </button>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 80;
    background: rgba(244, 239, 232, 0.9);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    border-bottom: 1px solid rgba(36, 28, 24, 0.06);
    transition: background 0.5s var(--ease), border-color 0.5s var(--ease), padding 0.5s var(--ease);
  }

  .site-header.is-overlay {
    position: fixed;
    width: 100%;
    background: transparent;
    border-bottom-color: rgba(255, 255, 255, 0.12);
  }
  .site-header.is-overlay .nav > ul > li > a,
  .site-header.is-overlay .btn-inquiry,
  .site-header.is-overlay .icon-action { color: #f7f3ee; }
  .site-header.is-overlay .btn-inquiry { border-color: rgba(255,255,255,0.35); }
  .site-header.is-overlay .brand-logo-img { filter: brightness(0) invert(1); mix-blend-mode: normal; }

  .site-header.is-scrolled,
  .site-header.is-overlay.is-scrolled {
    background: rgba(244, 239, 232, 0.94);
    border-bottom-color: rgba(36, 28, 24, 0.08);
  }
  .site-header.is-overlay.is-scrolled .nav > ul > li > a,
  .site-header.is-overlay.is-scrolled .btn-inquiry,
  .site-header.is-overlay.is-scrolled .icon-action { color: var(--color-ink); }
  .site-header.is-overlay.is-scrolled .btn-inquiry { border-color: rgba(36, 28, 24, 0.2); }
  .site-header.is-overlay.is-scrolled .brand-logo-img { filter: none; mix-blend-mode: multiply; }

  .header__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding-block: 1.15rem;
    padding-inline: var(--gutter);
    max-width: var(--max-wide);
    margin: 0 auto;
  }
  .site-header.is-scrolled .header__inner { padding-block: 0.8rem; }
  .brand { justify-self: start; }
  .nav { justify-self: center; }
  .header__actions { justify-self: end; display: flex; align-items: center; gap: 0.8rem; }

  .brand-logo-img {
    height: 40px;
    width: auto;
    object-fit: contain;
    mix-blend-mode: multiply;
  }

  .nav ul { display: flex; align-items: center; gap: 1.8rem; }
  .nav > ul > li { position: relative; }
  .nav > ul > li > a {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    padding-block: 0.4rem;
  }
  .nav > ul > li > a.is-active::after,
  .nav > ul > li > a:hover::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 1px;
    background: currentColor;
  }

  .caret { transition: transform 0.4s var(--ease); }
  .has-children:hover .caret,
  .has-children.is-open .caret { transform: rotate(180deg); }
  .has-children::after {
    content: "";
    position: absolute;
    top: 100%;
    left: 0;
    width: 100%;
    height: 16px;
  }

  .nav .dropdown {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translate(-50%, 12px);
    background: var(--color-bg);
    color: var(--color-ink);
    border: 1px solid var(--color-line);
    padding: 0.8rem 0;
    min-width: 240px;
    max-height: min(70vh, 480px);
    overflow-y: auto;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: all 0.4s var(--ease);
    z-index: 1050;
  }
  .has-children:hover .dropdown,
  .has-children:focus-within .dropdown,
  .has-children.is-open .dropdown {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, 6px);
    pointer-events: auto;
  }
  .dropdown li a { display: block; padding: 0.5rem 1.2rem; font-size: 0.86rem; letter-spacing: 0; text-transform: none; color: var(--color-ink); }
  .dropdown li a:hover { color: var(--color-primary); }

  .btn-inquiry {
    border: 1px solid rgba(36, 28, 24, 0.2);
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    padding: 0.75rem 1.2rem;
  }
  .btn-inquiry:hover { background: var(--color-primary); border-color: var(--color-primary); color: #fff; }

  .icon-action { display: grid; place-items: center; cursor: pointer; }
  .icon-22 { width: 22px; height: 22px; }
  .nav-toggle { display: none; }

  @media (max-width: 980px) {
    .header__inner { grid-template-columns: 1fr auto; }
    .nav {
      position: fixed;
      inset: 0 0 0 auto;
      width: min(340px, 88vw);
      background: var(--color-bg);
      color: var(--color-ink);
      transform: translateX(100%);
      transition: transform 0.5s var(--ease);
      padding: 6rem 1.8rem 2rem;
      overflow-y: auto;
      justify-self: stretch;
    }
    .nav.is-open { transform: translateX(0); }
    .nav ul { flex-direction: column; align-items: flex-start; gap: 1.1rem; }
    .nav > ul > li { width: 100%; }
    .nav > ul > li > a { color: var(--color-ink); }
    .dropdown {
      position: static;
      transform: none;
      opacity: 1;
      visibility: visible;
      display: none;
      border: none;
      background: transparent;
      left: 0;
    }
    .has-children:hover .dropdown { transform: none; }
    .has-children.is-open .dropdown { display: block; pointer-events: auto; }
    .nav-toggle { display: grid; }
    .btn-inquiry { display: none; }
    .site-header.is-overlay .brand-logo-img { filter: none; mix-blend-mode: multiply; }
    .site-header.is-overlay .icon-action { color: var(--color-ink); }
    .site-header.is-overlay { background: rgba(244, 239, 232, 0.92); border-bottom-color: rgba(36,28,24,0.06); }
  }
</style>

<script>
  function syncHeaderState() {
    document.querySelector(".site-header")?.classList.toggle("is-scrolled", window.scrollY > 24);
  }

  function initHeader() {
    const toggle = document.getElementById("nav-toggle");
    const nav = document.getElementById("primary-nav");

    if (toggle instanceof HTMLElement && toggle.dataset.bound !== "true") {
      toggle.dataset.bound = "true";
      toggle.addEventListener("click", () => {
        const isOpen = nav?.classList.toggle("is-open");
        toggle.setAttribute("aria-expanded", String(!!isOpen));
      });
    }

    document.querySelectorAll(".nav .has-children > a").forEach((link) => {
      if (!(link instanceof HTMLElement) || link.dataset.bound === "true") return;
      link.dataset.bound = "true";
      link.addEventListener("click", (e) => {
        if (window.innerWidth <= 980) {
          e.preventDefault();
          link.parentElement?.classList.toggle("is-open");
        }
      });
    });

    syncHeaderState();
  }

  if (!window.__mahakaliHeaderScroll) {
    window.__mahakaliHeaderScroll = true;
    window.addEventListener("scroll", syncHeaderState, { passive: true });
  }

  initHeader();
  document.addEventListener("astro:page-load", initHeader);
</script>
