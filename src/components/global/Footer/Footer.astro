---
import Icon from "../UI/Icon.astro";
import { siteInfo, topBar, branches, footerNote, mainNav } from "../../../data/site";

const nav = mainNav.filter((item) => !item.children);
---

<footer class="footer">
  <div class="wrap wrap--wide top">
    <div>
      <img src="/images/new-logo.png" alt={siteInfo.name} class="logo" />
      <p>{siteInfo.description}</p>
    </div>
    <div>
      <p class="label">Navigate</p>
      <ul class="links">
        {nav.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
        <li><a href="/products">Collections</a></li>
        <li><a href="/faq">FAQs</a></li>
        <li><a href="/terms">Terms</a></li>
        <li><a href="/privacy">Privacy</a></li>
      </ul>
    </div>
    <div>
      <p class="label">Visit</p>
      <ul>
        {branches.map((b) => (
          <li>
            <strong>{b.name}</strong>
            <span>{b.lines.join(" ")}</span>
            <a href={`tel:${b.phone.replace(/\s/g, "")}`}>{b.phone}</a>
          </li>
        ))}
      </ul>
    </div>
  </div>
  <div class="wrap wrap--wide bottom">
    <p>{footerNote}</p>
    <div class="social">
      {topBar.social.map((s) => (
        <a href={s.href} aria-label={s.label} target="_blank" rel="noopener noreferrer">
          <Icon name={s.icon} class="icon-16" />
        </a>
      ))}
    </div>
  </div>
</footer>

<style>
  .footer {
    background: #1b1512;
    color: rgba(244, 239, 232, 0.72);
    padding-top: 5.5rem;
  }
  .logo {
    height: 44px;
    width: auto;
    margin-bottom: 1.4rem;
    filter: brightness(0) invert(1);
  }
  .top {
    display: grid;
    grid-template-columns: 1.2fr 0.7fr 1.1fr;
    gap: 3.5rem;
    padding-bottom: 4rem;
  }
  .top p { max-width: 38ch; font-weight: 300; line-height: 1.7; }
  .label {
    font-size: 0.68rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #e4c9a4;
    margin-bottom: 1.3rem;
  }
  ul { display: grid; gap: 1.3rem; }
  .links { gap: 0.55rem; }
  strong { display: block; color: #fff; font-weight: 500; margin-bottom: 0.25rem; }
  span { display: block; font-weight: 300; font-size: 0.92rem; }
  a:hover { color: #fff; }
  .bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding-block: 1.4rem;
    border-top: 1px solid rgba(244,239,232,0.08);
    font-size: 0.8rem;
  }
  .social { display: flex; gap: 0.9rem; }
  @media (max-width: 860px) {
    .top { grid-template-columns: 1fr; gap: 2.5rem; }
    .bottom { flex-direction: column; align-items: flex-start; }
  }
</style>
