---
import Icon from './Icon.astro';
export interface Props {
  rating: number;
  max?: number;
}
const { rating, max = 5 } = Astro.props;
---
<span class="stars" role="img" aria-label={`Rated ${rating} out of ${max}`}>
  {Array.from({ length: max }).map((_, i) => (
    <Icon name="star" class={i < rating ? '' : 'is-empty'} />
  ))}
</span>
