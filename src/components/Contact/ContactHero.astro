---
import type { contactHero } from "../../data/contact/data";

export interface Props {
  data: typeof contactHero;
}

const { data } = Astro.props;
---

<section class="contact-hero section" style={`background-image: url('${data.image}')`}>
  <div class="wrap">
    <div class="hero-overlay-card chamfer-card">
      <nav aria-label="Breadcrumb" class="breadcrumb">
        <ol>
          <li><a href="/">Home</a></li>
          <li class="separator"><span class="material-symbols-outlined">chevron_right</span></li>
          <li class="current">Contact Us</li>
        </ol>
      </nav>
      <h1 class="font-display">{data.title}</h1>
      <p class="hero-subtitle">{data.subtitle}</p>
    </div>
  </div>
</section>

<style>
  .contact-hero {
    position: relative;
    background-size: cover;
    background-position: center;
    min-height: 500px;
    display: flex;
    align-items: center;
    padding-top: 10rem;
    padding-bottom: 8rem;
  }
  @media (min-width: 768px) {
    .contact-hero {
      min-height: 600px;
    }
  }
  
  .wrap {
    width: 100%;
    /* To push the card to the left side */
    display: flex;
    justify-content: flex-start;
  }
  
  .hero-overlay-card {
   background: rgba(250, 243, 243, 0.178);
    backdrop-filter: blur(8px);
    border: 1px solid var(--color-line);
    padding: 2.5rem;
    max-width: 600px;
    width: 100%;
    box-shadow: var(--shadow-md);
  }
  @media (min-width: 768px) {
    .hero-overlay-card {
      padding: 3.5rem;
      margin-left: 2rem;
    }
  }
  
  .breadcrumb {
    margin-bottom: 1rem;
  }
  .breadcrumb ol {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--color-ink-soft);
    font-weight: 500;
  }
  .breadcrumb a:hover {
    color: var(--color-primary);
  }
  .separator span {
    font-size: 1.2rem;
    vertical-align: middle;
  }
  .current {
    color: var(--color-primary);
    font-weight: 600;
  }
  h1 {
    color: var(--color-primary);
    margin-bottom: 1.5rem;
  }
  .hero-subtitle {
   font-size: 1.125rem;
    color: #fbfcfef2;
    line-height: 1.6;
    font-weight: 300;
  }
</style>
