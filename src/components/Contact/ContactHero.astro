---
import type { contactHero } from "../../data/contact/data";

export interface Props {
  data: typeof contactHero;
}

const { data } = Astro.props;
---

<section class="page-hero" aria-label="Contact">
  <img src={data.image} alt="" />
  <div class="veil"></div>
  <div class="wrap copy">
    <p class="eyebrow light">Contact</p>
    <h1>{data.title}</h1>
    <p>{data.subtitle}</p>
  </div>
</section>
