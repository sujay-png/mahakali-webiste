---
import type { showrooms } from "../../data/contact/data";

export interface Props {
  data: typeof showrooms;
}

const { data } = Astro.props;
---

<section class="section wrap wrap--wide">
  <div class="showrooms-header">
    <p class="eyebrow">Visit</p>
    <h2>Our showrooms</h2>
    <p class="lead">Walk the collections in person — timber, fabric and scale are best judged on the floor.</p>
  </div>

  <div class="showrooms-grid">
    {data.map((showroom, index) => (
      <article>
        <span>{String(index + 1).padStart(2, "0")}</span>
        <h3 class="font-display">{showroom.title}</h3>
        <p class="address">{showroom.address}</p>
        <div class="contact-details">
          <a href={`tel:${showroom.phone}`}>{showroom.phone}</a>
          <a href={`mailto:${showroom.email}`}>{showroom.email}</a>
          <p>{showroom.hours}</p>
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .showrooms-header { max-width: 36rem; margin-bottom: 3.5rem; }
  h2 { margin: 0.7rem 0 1rem; max-width: 12ch; }
  .lead { color: var(--color-ink-soft); font-weight: 300; }
  .showrooms-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 3rem;
    border-top: 1px solid var(--color-line);
  }
  article {
    padding-top: 2rem;
    display: grid;
    gap: 0.8rem;
  }
  span { font-size: 0.68rem; letter-spacing: 0.2em; color: var(--color-gold); }
  h3 { font-size: 1.7rem; max-width: 12ch; }
  .address { color: var(--color-ink-soft); font-weight: 300; max-width: 28ch; }
  .contact-details { display: grid; gap: 0.35rem; padding-top: 0.6rem; }
  .contact-details a:hover { color: var(--color-primary); }
  .contact-details p { color: var(--color-ink-soft); font-size: 0.9rem; }
  @media (max-width: 860px) { .showrooms-grid { grid-template-columns: 1fr; gap: 0; } }
</style>
