---
import Icon from "../global/UI/Icon.astro";
---

<section class="wrap wrap--wide section">
  <div class="contact-form-section">
    <div class="form-image">
      <img src="https://images.unsplash.com/photo-1616486338812-3dadae4b4ace?auto=format&fit=crop&w=1400&q=80" alt="" />
      <div class="image-card">
        <p class="eyebrow light">Atelier</p>
        <h3 class="font-display">Design consultation</h3>
        <p>Speak with our designers to bring your room — and its proportions — into focus.</p>
      </div>
    </div>

    <div class="form-content">
      <p class="eyebrow">Write to us</p>
      <h2>Get in touch</h2>

      <form id="contactForm" class="form">
        <div class="form-row">
          <div class="form-group">
            <input type="text" id="name" name="name" class="floating-input" placeholder=" " required />
            <label for="name">Your Name</label>
          </div>
          <div class="form-group">
            <input type="email" id="email" name="email" class="floating-input" placeholder=" " required />
            <label for="email">Your Email</label>
          </div>
        </div>

        <div class="form-group">
          <input type="text" id="subject" name="subject" class="floating-input" placeholder=" " required />
          <label for="subject">Your Subject</label>
        </div>

        <div class="form-group">
          <textarea id="message" name="message" class="floating-input" placeholder=" " required></textarea>
          <label for="message">Write Your Message</label>
        </div>

        <div class="form-actions">
          <button type="submit" class="btn btn-primary">
            Send Message via WhatsApp
            <Icon name="arrow-right" />
          </button>
          <p class="form-hint">This will open WhatsApp to send your inquiry directly to our team.</p>
        </div>
      </form>
    </div>
  </div>
</section>

<style>
  .contact-form-section {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(2rem, 5vw, 5rem);
    align-items: stretch;
  }
  .form-image {
    position: relative;
    min-height: 420px;
    overflow: hidden;
    background: var(--color-cream);
  }
  .form-image::after {
    content: '';
    position: absolute;
    inset: 0;
    /* A mix of dark at the bottom blending to light/transparent at the top */
    background: linear-gradient(to top, rgba(0, 0, 0, 0.75) 0%, rgba(0, 0, 0, 0.2) 50%, rgba(255, 255, 255, 0.05) 100%);
    pointer-events: none;
    z-index: 1;
  }
  .form-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .image-card {
    position: absolute;
    left: 1.5rem;
    right: 1.5rem;
    bottom: 1.5rem;
    color: #fff;
    max-width: 22rem;
    z-index: 2;
  }
  .image-card h3 { color: #fff; margin: 0.6rem 0 0.5rem; }
  .image-card p { color: rgba(255,255,255,0.85); font-weight: 300; }

  .form-content h2 { margin: 0.7rem 0 2.4rem; max-width: 10ch; }
  .form { display: flex; flex-direction: column; gap: 2rem; }
  .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; }
  .form-group { position: relative; }
  .floating-input {
    width: 100%;
    background: transparent;
    border: none;
    border-bottom: 1px solid var(--color-line);
    color: var(--color-ink);
    padding: 0.85rem 0;
    transition: border-color var(--dur-fast) var(--ease);
  }
  .floating-input:focus { outline: none; border-bottom-color: var(--color-ink); }
  textarea.floating-input { min-height: 120px; resize: vertical; }
  .form-group label {
    position: absolute;
    left: 0;
    top: 0.85rem;
    color: var(--color-ink-soft);
    font-size: 0.9rem;
    transition: transform var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease);
    transform-origin: left;
    pointer-events: none;
  }
  .floating-input:focus ~ label,
  .floating-input:not(:placeholder-shown) ~ label {
    transform: translateY(-1.5rem) scale(0.85);
    color: var(--color-gold);
  }
  .form-hint {
    font-size: 0.78rem;
    color: var(--color-ink-soft);
    margin-top: 1rem;
    font-weight: 300;
  }
  @media (max-width: 900px) {
    .contact-form-section,
    .form-row { grid-template-columns: 1fr; }
    .form-image { min-height: 320px; }
  }
</style>

<script>
  function bindContactForm() {
    const form = document.getElementById("contactForm");
    if (!(form instanceof HTMLFormElement) || form.dataset.bound === "true") return;
    form.dataset.bound = "true";

    form.addEventListener("submit", function (e) {
      e.preventDefault();

      const nameInput = document.getElementById("name") as HTMLInputElement;
      const emailInput = document.getElementById("email") as HTMLInputElement;
      const subjectInput = document.getElementById("subject") as HTMLInputElement;
      const messageInput = document.getElementById("message") as HTMLTextAreaElement;

      if (nameInput && emailInput && subjectInput && messageInput) {
        const name = nameInput.value;
        const email = emailInput.value;
        const subject = subjectInput.value;
        const message = messageInput.value;

        const text = `*New Inquiry from Website*%0A%0A*Name:* ${name}%0A*Email:* ${email}%0A*Subject:* ${subject}%0A*Message:* ${message}`;

        const phone = "919148643754";
        const whatsappUrl = `https://wa.me/${phone}?text=${text}`;

        window.open(whatsappUrl, "_blank");
      }
    });
  }

  bindContactForm();
  document.addEventListener("astro:page-load", bindContactForm);
</script>
