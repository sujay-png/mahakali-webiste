---
import type { socialData as AboutSocialType } from "../../data/about/social";

export interface Props {
  data: typeof AboutSocialType;
}

const { data } = Astro.props;
---

<section class="section wrap wrap--wide">
  <div class="social-header">
    <p class="eyebrow">Studio notes</p>
    <h2>{data.title}</h2>
    <p>Follow us on Instagram <a class="social-link" href={data.link}>{data.handle}</a></p>
  </div>
  <div class="social-grid">
    {data.images.map((img) => (
      <a class="social-image-wrapper" href={data.link} data-media>
        <img class="social-image" src={img.src} alt={img.alt} loading="lazy" />
      </a>
    ))}
  </div>
</section>

<style>
  .social-header { margin-bottom: 2.5rem; }
  h2 { max-width: 12ch; margin: 0.7rem 0 0.8rem; }
  .social-header p { color: var(--color-ink-soft); font-weight: 300; }
  .social-link { color: var(--color-primary); }
  .social-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.8rem;
  }
  .social-image-wrapper { aspect-ratio: 1; background: var(--color-cream); }
  .social-image { width: 100%; height: 100%; object-fit: cover; }
  @media (max-width: 800px) { .social-grid { grid-template-columns: 1fr 1fr; } }
</style>
