---
import type { socialData as AboutSocialType } from "../../data/about/social";

export interface Props {
  data: typeof AboutSocialType;
}

const { data } = Astro.props;
---

<section class="wrap">
  <div class="social-section">
    <div class="social-header">
      <h2 class="social-title">{data.title}</h2>
      <p class="social-copy">Follow us on Instagram <a class="social-link" href={data.link}>{data.handle}</a></p>
    </div>
    <div class="social-grid">
      {data.images.map((img) => (
        <div class="social-image-wrapper">
          <img class="social-image" src={img.src} alt={img.alt} loading="lazy" />
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .social-section {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    margin-bottom: 4rem;
  }
  .social-header {
    text-align: center;
  }
  .social-title {
    font-size: 2rem;
    font-family: var(--font-display);
    color: var(--color-walnut);
    margin-bottom: 0.5rem;
  }
  .social-copy {
    font-size: 1rem;
    color: var(--color-ink-soft);
  }
  .social-link {
    color: var(--color-primary);
    font-weight: bold;
    text-decoration: none;
  }
  .social-link:hover {
    text-decoration: underline;
  }
  .social-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }
  @media (min-width: 768px) {
    .social-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .social-image-wrapper {
    aspect-ratio: 1 / 1;
    border-radius: 0.5rem;
    overflow: hidden;
    background-color: var(--color-cream);
    position: relative;
  }
  .social-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s var(--ease);
  }
  .social-image-wrapper:hover .social-image {
    transform: scale(1.05);
  }
</style>
