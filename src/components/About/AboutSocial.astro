---
import type { socialData as AboutSocialType } from "../../data/about/social";

export interface Props {
  data: typeof AboutSocialType;
}

const { data } = Astro.props;
---

<section class="social section wrap wrap--wide" data-reveal-group>
  <div class="social-header" data-reveal="up">
    <p class="eyebrow">Studio notes</p>
    <h2 class="font-display">{data.title}</h2>
    <p>Follow us on Instagram <a class="social-link" href={data.link} target="_blank" rel="noopener">{data.handle}</a></p>
  </div>
  <div class="social-grid">
    {data.images.map((img, i) => (
      <a class="social-image-wrapper" href={data.link} target="_blank" rel="noopener" data-media data-reveal="up" style={`transition-delay: ${i * 0.1}s`}>
        <img class="social-image" src={img.src} alt={img.alt} loading="lazy" />
        <div class="overlay">
          <span>View on Instagram</span>
        </div>
      </a>
    ))}
  </div>
</section>

<style>
  .social {
    padding-block: clamp(4rem, 8vw, 6rem);
  }
  .social-header { margin-bottom: 3.5rem; text-align: center; }
  h2 { margin: 1rem auto 1.2rem; font-size: clamp(2rem, 4vw, 3rem); }
  .social-header p { color: var(--color-ink-soft); font-weight: 300; font-size: 1.1rem; }
  .social-link { color: var(--color-ink); font-weight: 500; border-bottom: 1px solid var(--color-gold); padding-bottom: 2px; }
  .social-link:hover { color: var(--color-gold); }
  
  .social-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }
  .social-image-wrapper { 
    aspect-ratio: 1; 
    background: var(--color-cream); 
    border-radius: 16px;
    overflow: hidden;
    position: relative;
    display: block;
  }
  .social-image { 
    width: 100%; 
    height: 100%; 
    object-fit: cover; 
    transition: transform 0.6s var(--ease);
  }
  
  .overlay {
    position: absolute;
    inset: 0;
    background: rgba(36,28,24,0.4);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.4s var(--ease);
  }
  .overlay span {
    color: #fff;
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transform: translateY(10px);
    transition: transform 0.4s var(--ease);
  }
  
  .social-image-wrapper:hover .social-image {
    transform: scale(1.05);
  }
  .social-image-wrapper:hover .overlay {
    opacity: 1;
  }
  .social-image-wrapper:hover .overlay span {
    transform: translateY(0);
  }
  
  @media (max-width: 900px) { 
    .social-grid { grid-template-columns: 1fr 1fr; gap: 1rem; } 
    .social-image-wrapper { border-radius: 12px; }
  }
</style>
