---
import { heroData } from "../../data/about/hero";

export interface Props {
  data: typeof heroData;
}

const { data } = Astro.props;
---

<section class="about-hero">
  <div class="wrap wrap--wide hero-grid" data-reveal-group>
    <div class="content" data-reveal="up">
      <p class="eyebrow">{data.eyebrow}</p>
      <h1 class="font-display" set:html={data.title}></h1>
      
      <div class="copy-box">
        <p>{data.copy}</p>
        <div class="actions">
          <a href="/contact" class="btn btn-primary">Visit showroom</a>
          <a href="/products" class="btn btn-outline">Products</a>
        </div>
      </div>
    </div>
    
    <figure class="visual" data-reveal="fade">
      <img src={data.image.src} alt={data.image.alt} loading="eager" />
    </figure>
  </div>
</section>

<style>
  .about-hero {
    padding-top: clamp(6rem, 8vw, 8rem);
    padding-bottom: clamp(4rem, 8vw, 6rem);
    background: var(--color-surface);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    align-items: start;
    position: relative;
  }
  
  .content {
    position: relative;
    z-index: 2;
    padding-right: 4rem;
  }
  .eyebrow {
    color: var(--color-gold);
    margin-bottom: 1.5rem;
  }
  h1 {
    font-size: clamp(2.8rem, 4.7vw, 4.8rem);
    line-height: 1.02;
    margin-bottom: 2rem;
  }
  .accent {
    font-style: italic;
    font-weight: 300;
  }
  
  .copy-box {
    background: var(--color-bg);
    padding: 3rem;
    border-radius: 12px;
    box-shadow: 0 20px 40px rgba(0,0,0,0.05);
    margin-left: -2rem;
  }
  .copy-box p {
    color: var(--color-ink-soft);
    font-size: 1.1rem;
    line-height: 1.7;
    margin-bottom: 2.5rem;
  }
  
  .actions {
    display: flex;
    gap: 1rem;
  }
  .btn-outline {
    border: 1px solid var(--color-line);
    padding: 1rem 2rem;
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .btn-outline:hover {
    background: var(--color-ink);
    color: #fff;
    border-color: var(--color-ink);
  }
  
  .visual {
    position: relative;
    z-index: 1;
    margin: 0;
    aspect-ratio: 4 / 5;
    border-radius: 24px;
    overflow: hidden;
    box-shadow: -20px 20px 60px rgba(0,0,0,0.08);
  }
  .visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  
  @media (max-width: 1024px) {
    .content { padding-right: 0; }
    .copy-box { margin-left: 0; padding: 2rem; }
  }
  @media (max-width: 800px) {
    .hero-grid { grid-template-columns: 1fr; }
    h1 {
      font-size: clamp(2.4rem, 10vw, 3rem);
      line-height: 1.06;
    }
    .visual { aspect-ratio: 16 / 9; margin-top: 2rem; }
  }
</style>
