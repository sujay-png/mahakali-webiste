---
---

<section class="section section--cream">
  <div class="wrap wrap--wide notes" data-reveal-group>
    <article data-reveal>
      <span>01</span>
      <h3 class="font-display">Free delivery</h3>
      <p>For qualifying orders across our service area.</p>
    </article>
    <article data-reveal>
      <span>02</span>
      <h3 class="font-display">Made to last</h3>
      <p>Custom and showroom pieces are finished for years of use.</p>
    </article>
    <article data-reveal>
      <span>03</span>
      <h3 class="font-display">Secure payment</h3>
      <p>In-store and online payments through trusted gateways.</p>
    </article>
    <article data-reveal>
      <span>04</span>
      <h3 class="font-display">Showroom hours</h3>
      <p>9:30AM – 7:00PM. Walk in, or call ahead for a consultation.</p>
    </article>
  </div>
</section>

<style>
  .notes {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2.5rem;
    padding-block: 0.5rem 2rem;
  }
  article { display: grid; gap: 0.7rem; }
  span {
    font-size: 0.68rem;
    letter-spacing: 0.2em;
    color: var(--color-gold);
  }
  h3 { font-size: 1.7rem; max-width: 10ch; }
  p { color: var(--color-ink-soft); font-weight: 300; max-width: 28ch; }
  @media (max-width: 900px) { .notes { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .notes { grid-template-columns: 1fr; } }
</style>
