---
import Icon from "../global/UI/Icon.astro";
---

<section class="notes section">
  <div class="wrap wrap--wide list" data-reveal-group>
    <article class="usp-card" data-reveal="up" style="transition-delay: 0s">
      <div class="usp-icon"><Icon name="truck" /></div>
      <div class="usp-content">
        <h3 class="font-display">Free Delivery</h3>
        <p>For Any Orders</p>
      </div>
    </article>
    <article class="usp-card" data-reveal="up" style="transition-delay: 0.1s">
      <div class="usp-icon"><Icon name="refresh" /></div>
      <div class="usp-content">
        <h3 class="font-display">No Refund</h3>
        <p>There Is No Refund</p>
      </div>
    </article>
    <article class="usp-card" data-reveal="up" style="transition-delay: 0.2s">
      <div class="usp-icon"><Icon name="shield" /></div>
      <div class="usp-content">
        <h3 class="font-display">Safe Payment</h3>
        <p>100% Secure Payment</p>
      </div>
    </article>
    <article class="usp-card" data-reveal="up" style="transition-delay: 0.3s">
      <div class="usp-icon"><Icon name="headset" /></div>
      <div class="usp-content">
        <h3 class="font-display">9:30AM -7:00PM Support</h3>
        <p>Feel Free To Call Us</p>
      </div>
    </article>
  </div>
</section>

<style>
  .notes { padding-block: 4rem 6rem; }
  .list {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }
  .usp-card {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding: 2.5rem 2rem;
    background: var(--color-surface);
    border-radius: 12px;
    border: 1px solid rgba(36,28,24,0.05);
    transition: transform 0.4s var(--ease), box-shadow 0.4s var(--ease), border-color 0.4s var(--ease);
  }
  .usp-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 40px rgba(0,0,0,0.06);
    border-color: rgba(36,28,24,0.1);
  }
  .usp-icon {
    width: 48px;
    height: 48px;
    background: var(--color-bg);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-gold);
    transition: background 0.4s var(--ease), color 0.4s var(--ease);
  }
  .usp-icon :global(svg) {
    width: 20px;
    height: 20px;
  }
  .usp-card:hover .usp-icon {
    background: var(--color-gold);
    color: #fff;
  }
  h3 { font-size: 1.45rem; margin-bottom: 0.8rem; }
  p { color: var(--color-ink-soft); font-weight: 300; font-size: 1rem; line-height: 1.5; }
  
  @media (max-width: 900px) { 
    .list { grid-template-columns: 1fr 1fr; } 
  }
  @media (max-width: 500px) { 
    .notes { padding-block: 2.5rem 3.5rem; }
    .list { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.75rem; }
    .usp-card { gap: 0.7rem; padding: 1rem 0.35rem; border-radius: 4px; align-items: center; text-align: center; }
    .usp-icon { width: 32px; height: 32px; }
    .usp-icon :global(svg) { width: 15px; height: 15px; }
    h3 { font-size: 0.78rem; line-height: 1.15; margin-bottom: 0.35rem; }
    p { font-size: 0.65rem; line-height: 1.25; overflow-wrap: anywhere; }
  }
</style>
