---
---

<section class="notes">
  <div class="wrap wrap--wide list">
    <article>
      <span>01</span>
      <div>
        <h3 class="font-display">Free delivery</h3>
        <p>For qualifying orders across our service area.</p>
      </div>
    </article>
    <article>
      <span>02</span>
      <div>
        <h3 class="font-display">Made to last</h3>
        <p>Custom and showroom pieces are finished for years of use.</p>
      </div>
    </article>
    <article>
      <span>03</span>
      <div>
        <h3 class="font-display">Secure payment</h3>
        <p>In-store and online payments through trusted gateways.</p>
      </div>
    </article>
    <article>
      <span>04</span>
      <div>
        <h3 class="font-display">Showroom hours</h3>
        <p>9:30AM – 7:00PM. Walk in, or call ahead.</p>
      </div>
    </article>
  </div>
</section>

<style>
  .notes { padding-block: 2.5rem 1rem; }
  .list {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }
  article {
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: 0.7rem;
  }
  span { color: var(--color-gold); font-size: 0.72rem; letter-spacing: 0.12em; padding-top: 0.35rem; }
  h3 { font-size: 1.35rem; margin-bottom: 0.3rem; }
  p { color: var(--color-ink-soft); font-weight: 300; font-size: 0.92rem; }
  @media (max-width: 800px) { .list { grid-template-columns: 1fr 1fr; } }
</style>
