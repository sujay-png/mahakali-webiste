---
import Icon from "../global/UI/Icon.astro";
import type { aboutStory as AboutStoryType } from "../../data/about/story";

export interface Props {
  data: typeof AboutStoryType;
}

const { data } = Astro.props;
---

<section class="section about">
  <div class="wrap about__grid">
    <div class="about__collage" data-reveal="left">
      <img
        class="about__main"
        src={data.images[0].src}
        alt={data.images[0].alt}
        width="640"
        height="760"
        loading="lazy"
      />
      <img
        class="about__float about__float--1"
        src={data.images[1].src}
        alt={data.images[1].alt}
        width="220"
        height="180"
        loading="lazy"
      />
      <img
        class="about__float about__float--2"
        src={data.images[2].src}
        alt={data.images[2].alt}
        width="240"
        height="200"
        loading="lazy"
      />
      <span class="about__badge">
        <Icon name="medal" class="icon-22" />
        <span set:html={data.badge.replace(' ', ' <br/> ')} />
      </span>
    </div>

    <div class="about__copy" data-reveal="right">
      <p class="eyebrow">{data.eyebrow}</p>
      <h2>
        {data.title} <span class="accent">{data.titleAccent}</span> {data.titleTail}
      </h2>
      <p class="about__lead">
        {data.copy}
      </p>

      <ul class="about__bullets mt-4">
        {data.bullets.map((bullet) => (
          <li>
            <Icon name="tag" class="icon-16" />
            {bullet}
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .mt-4 { margin-top: 1.5rem; }
  
  .about__grid {
    display: grid;
    grid-template-columns: 0.95fr 1.05fr;
    gap: clamp(3rem, 6vw, 5rem);
    align-items: center;
  }

  .about__collage {
    position: relative;
    padding: 1.5rem 2.5rem 2.5rem 0;
  }
  .about__main {
    width: 100%;
    aspect-ratio: 4/5;
    object-fit: cover;
    box-shadow: var(--shadow-lg);
  }
  .about__float {
    position: absolute;
    box-shadow: var(--shadow-md);
    object-fit: cover;
    border: 5px solid var(--color-surface);
  }
  .about__float--1 {
    top: 0;
    right: 0;
    width: 42%;
    aspect-ratio: 5/4;
  }
  .about__float--2 {
    bottom: 0;
    right: 1rem;
    width: 46%;
    aspect-ratio: 6/5;
  }

  .about__badge {
    position: absolute;
    left: -0.5rem;
    top: 2.5rem;
    background: var(--color-gold);
    color: var(--color-walnut);
    font-weight: 700;
    font-size: 0.82rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1rem;
    box-shadow: var(--shadow-md);
    text-align: left;
    line-height: 1.3;
  }
  .icon-22 {
    width: 20px;
    height: 20px;
  }

  .about__lead {
    margin-top: 1.1rem;
    color: var(--color-ink-soft);
    max-width: 58ch;
  }
  .about__bullets {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.8rem 1.5rem;
  }
  .about__bullets li {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    font-weight: 600;
    font-size: 0.92rem;
    color: var(--color-walnut);
    text-align: left;
  }
  .icon-16 {
    width: 15px;
    height: 15px;
    color: var(--color-primary);
    flex-shrink: 0;
    margin-top: 2px;
  }

  @media (max-width: 900px) {
    .about__grid {
      grid-template-columns: 1fr;
      gap: clamp(1.5rem, 4vw, 2.5rem);
    }
    .about__collage {
      padding: 0;
      margin-inline: 0;
      width: 100%;
    }
    .about__main {
      width: 100%;
      aspect-ratio: 1/1.3;
      min-height: 600px;
    }
    .about__float {
      display: none;
    }
    .about__badge {
      display: none;
    }
    .about__copy {
      padding: 1rem 0 0 0;
    }
    .about__bullets {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 480px) {
    .about__grid {
      gap: 1rem;
    }
    .about__lead {
      font-size: 0.95rem;
      margin-top: 0.75rem;
    }
    .about__bullets li {
      font-size: 0.88rem;
      gap: 0.4rem;
    }
  }
</style>
