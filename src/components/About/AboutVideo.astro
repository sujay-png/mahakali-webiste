---
import type { videoData as AboutVideoType } from "../../data/about/video";

export interface Props {
  data: typeof AboutVideoType;
}

const { data } = Astro.props;
---

<section class="film section">
  <div class="wrap wrap--wide grid" data-reveal-group>
    <div class="copy" data-reveal="up">
      <p class="eyebrow">Our Video</p>
      <h2 class="font-display">Let's check our latest <br/><em class="accent">videos</em></h2>
    </div>
    <div class="video-section" data-reveal="fade" data-embed={data.embedUrl} role="button" tabindex="0" aria-label="Play latest video">
      <div class="video-bg" style={`background-image: url('${data.image}')`}></div>
      <span class="play-btn" aria-hidden="true">
        <span class="play-triangle"></span>
      </span>
    </div>
  </div>
</section>

<script>
  function bindVideos() {
    document.querySelectorAll(".video-section").forEach((section) => {
      if (!(section instanceof HTMLElement) || section.dataset.bound === "true") return;
      section.dataset.bound = "true";

      const play = () => {
        const embedUrl = section.getAttribute("data-embed");
        if (!embedUrl) return;
        const autoplayUrl = embedUrl.includes("?")
          ? `${embedUrl}&autoplay=1`
          : `${embedUrl}?autoplay=1`;
        section.innerHTML = `
          <iframe
            src="${autoplayUrl}"
            title="YouTube video player"
            frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen
            style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: none;"
          ></iframe>
        `;
      };

      section.addEventListener("click", play);
      section.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          play();
        }
      });
    });
  }

  bindVideos();
  document.addEventListener("astro:page-load", bindVideos);
</script>

<style>
  .film { padding-block: clamp(5rem, 10vw, 8rem); background: var(--color-surface); }
  .grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }
  h2 { max-width: 14ch; margin: 1rem 0 1.5rem; font-size: clamp(2.5rem, 4vw, 3.2rem); line-height: 1.1; }
  .copy p:last-child { color: var(--color-ink-soft); font-weight: 300; font-size: 1.1rem; line-height: 1.6; max-width: 32ch; }
  .video-section {
    position: relative;
    aspect-ratio: 16/9;
    overflow: hidden;
    background: var(--color-ink);
    cursor: pointer;
    display: grid;
    place-items: center;
    border-radius: 12px;
    box-shadow: 0 30px 60px rgba(0,0,0,0.1);
  }
  .video-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    transition: transform 1s var(--ease);
  }
  .video-section:hover .video-bg {
    transform: scale(1.05);
  }
  .play-btn {
    position: relative;
    z-index: 2;
    width: 5rem;
    height: 5rem;
    border-radius: 50%;
    background: rgba(255,255,255,0.1);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(255,255,255,0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.4s var(--ease), background 0.4s var(--ease);
  }
  .video-section:hover .play-btn {
    transform: scale(1.1);
    background: rgba(255,255,255,0.2);
  }
  .play-triangle {
    width: 0; 
    height: 0; 
    border-top: 8px solid transparent;
    border-bottom: 8px solid transparent;
    border-left: 14px solid #fff;
    margin-left: 4px;
  }
  
  @media (max-width: 900px) { 
    .grid { grid-template-columns: 1fr; gap: 3rem; } 
    .video-section { margin: 0 -1.5rem; border-radius: 0; }
  }
</style>
