---
import type { expertiseData as AboutExpertiseType } from "../../data/about/expertise";

export interface Props {
  data: typeof AboutExpertiseType;
}

const { data } = Astro.props;
---

<section class="section">
  <div class="wrap wrap--wide">
    <div class="intro">
      <p class="eyebrow">Why families return</p>
      <h2>A quieter way to furnish a home.</h2>
    </div>
    <ol data-reveal-group>
      {data.map((item, index) => (
        <li data-reveal>
          <span>{String(index + 1).padStart(2, "0")}</span>
          <div>
            <h3 class="font-display">{item.title}</h3>
            <p>{item.copy}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .intro { margin-bottom: 3.5rem; max-width: 18ch; }
  ol { display: grid; gap: 0; }
  li {
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    gap: 1.5rem;
    padding: 2rem 0;
    border-top: 1px solid var(--color-line);
  }
  li:last-child { border-bottom: 1px solid var(--color-line); }
  span {
    font-family: var(--font-display);
    font-size: 1.4rem;
    color: var(--color-gold);
  }
  h3 { font-size: 1.8rem; max-width: 18ch; margin-bottom: 0.6rem; }
  p { color: var(--color-ink-soft); font-weight: 300; max-width: 48ch; }
  @media (max-width: 640px) {
    li { grid-template-columns: 1fr; gap: 0.5rem; }
  }
</style>
