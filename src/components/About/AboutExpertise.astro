---
import type { expertiseData as AboutExpertiseType } from "../../data/about/expertise";

export interface Props {
  data: typeof AboutExpertiseType;
}

const { data } = Astro.props;
---

<section class="wrap">
  <div class="expertise-grid">
    {data.map((item, index) => (
      <div class="expertise-card" data-reveal="fade" style={`--d: ${index * 0.1}s`}>
        <div class="expertise-icon-wrapper">
          <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">{item.icon}</span>
        </div>
        <h3 class="expertise-title">{item.title}</h3>
        <p class="expertise-copy">{item.copy}</p>
      </div>
    ))}
  </div>
</section>

<style>
  .expertise-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    padding-bottom: 4rem;
  }
  @media (min-width: 768px) {
    .expertise-grid { grid-template-columns: repeat(2, 1fr); }
  }
  .expertise-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-cream);
    border-radius: 0.5rem;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
    box-shadow: var(--shadow-sm);
    transition: box-shadow 0.3s var(--ease);
    height: 100%;
  }
  .expertise-card:hover {
    box-shadow: var(--shadow-md);
  }
  .expertise-icon-wrapper {
    width: 3rem;
    height: 3rem;
    border-radius: 9999px;
    background-color: var(--color-gold);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-walnut);
  }
  .expertise-title {
    font-size: 1.5rem;
    color: var(--color-primary);
    font-family: var(--font-display);
    margin: 0;
  }
  .expertise-copy {
    font-size: 1rem;
    color: var(--color-ink-soft);
    margin: 0;
    line-height: 1.6;
  }
</style>
