---
import type { expertiseData as AboutExpertiseType } from "../../data/about/expertise";

export interface Props {
  data: typeof AboutExpertiseType;
}

const { data } = Astro.props;
---

<section class="expertise">
  <div class="wrap wrap--wide">
    <div class="intro">
      <p class="eyebrow">Why families return</p>
      <h2>A quieter way to furnish a home.</h2>
    </div>
    <ol>
      {data.map((item, index) => (
        <li>
          <span>{String(index + 1).padStart(2, "0")}</span>
          <h3 class="font-display">{item.title}</h3>
          <p>{item.copy}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .expertise { padding-block: clamp(3.5rem, 7vw, 6rem); }
  .intro { margin-bottom: 2.5rem; max-width: 16ch; }
  ol {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    border-top: 1px solid var(--color-line);
  }
  li {
    padding: 2rem 2.2rem 2rem 0;
    border-bottom: 1px solid var(--color-line);
  }
  li:nth-child(odd) { padding-right: 2.5rem; border-right: 1px solid var(--color-line); }
  li:nth-child(even) { padding-left: 2.5rem; }
  span { color: var(--color-gold); font-size: 0.72rem; letter-spacing: 0.16em; }
  h3 { font-size: 1.7rem; max-width: 16ch; margin: 0.6rem 0 0.7rem; }
  p { color: var(--color-ink-soft); font-weight: 300; max-width: 40ch; }
  @media (max-width: 800px) {
    ol { grid-template-columns: 1fr; }
    li:nth-child(odd), li:nth-child(even) { padding: 1.5rem 0; border-right: none; }
  }
</style>
