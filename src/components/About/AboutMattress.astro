---
import type { aboutMattress as AboutMattressType } from "../../data/about/mattress";

export interface Props {
  data: typeof AboutMattressType;
}

const { data } = Astro.props;
---

<section class="mattress">
  <div class="wrap wrap--wide grid">
    <figure data-media data-reveal="left">
      <img src={data.image} alt="" loading="lazy" />
    </figure>
    <div data-reveal="right">
      <p class="eyebrow">Rest</p>
      <h2>{data.title}</h2>
      <p class="lead">{data.lead}</p>
      <ol>
        {data.bullets.map((bullet, i) => (
          <li>
            <span>{String(i + 1).padStart(2, "0")}</span>
            {bullet}
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .mattress {
    background: var(--color-walnut);
    color: #f4efe8;
    padding-block: clamp(5rem, 10vw, 8.5rem);
  }
  .grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }
  figure { margin: 0; aspect-ratio: 4/5; }
  h2 { color: #fff; max-width: 14ch; margin: 0.8rem 0 1.2rem; }
  .lead { color: rgba(244,239,232,0.72); font-weight: 300; max-width: 42ch; margin-bottom: 2rem; }
  ol { display: grid; gap: 1.1rem; }
  li {
    display: grid;
    grid-template-columns: 2.4rem 1fr;
    gap: 0.8rem;
    color: rgba(244,239,232,0.88);
    font-weight: 300;
  }
  span { color: #e4c9a4; font-size: 0.78rem; letter-spacing: 0.12em; padding-top: 0.2rem; }
  @media (max-width: 800px) { .grid { grid-template-columns: 1fr; } }
</style>
