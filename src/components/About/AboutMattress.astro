---
import type { aboutMattress as AboutMattressType } from "../../data/about/mattress";

export interface Props {
  data: typeof AboutMattressType;
}

const { data } = Astro.props;
---

<section class="mattress section">
  <div class="wrap wrap--wide grid" data-reveal-group>
    <div class="intro" data-reveal="up">
      <p class="eyebrow light">Mattresses</p>
      <h2 class="font-display">{data.title}</h2>
      <p class="lead">{data.lead}</p>
    </div>
    <ol class="mattress-list">
      {data.bullets.map((bullet, i) => (
        <li data-reveal="up" style={`transition-delay: ${i * 0.15}s`}>
          <span class="font-display">{String(i + 1).padStart(2, "0")}</span>
          <p>{bullet}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .mattress {
    background: var(--color-walnut);
    color: #f4efe8;
    padding-block: clamp(5rem, 10vw, 8rem);
    position: relative;
    overflow: hidden;
  }
  .grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(4rem, 8vw, 6rem);
    align-items: center;
    position: relative;
    z-index: 2;
  }
  .intro h2 { 
    color: #fff; 
    max-width: 14ch; 
    margin: 1.5rem 0 1.5rem; 
    font-size: clamp(2.5rem, 4.5vw, 4rem); 
    line-height: 1.1;
  }
  .lead { 
    color: rgba(244,239,232,0.8); 
    font-weight: 300; 
    max-width: 35ch; 
    font-size: 1.15rem;
    line-height: 1.7;
  }
  .eyebrow.light { color: #e4c9a4; }
  .eyebrow.light::before { background: #e4c9a4; }
  
  .mattress-list { 
    display: flex;
    flex-direction: column;
    gap: 0; 
  }
  li {
    display: flex;
    align-items: flex-start;
    gap: 2rem;
    padding: 2.5rem 0;
    border-top: 1px solid rgba(244,239,232,0.1);
    color: rgba(244,239,232,0.9);
  }
  li:last-child { border-bottom: 1px solid rgba(244,239,232,0.1); }
  
  li span { 
    color: #e4c9a4; 
    font-size: 2rem; 
    line-height: 1;
    font-weight: 400;
  }
  li p {
    font-weight: 300;
    font-size: 1.05rem;
    line-height: 1.6;
    max-width: 40ch;
  }
  
  @media (max-width: 900px) { 
    .grid { grid-template-columns: 1fr; gap: 4rem; } 
    li { padding: 2rem 0; }
  }
</style>
