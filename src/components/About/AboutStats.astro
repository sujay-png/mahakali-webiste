---
import type { statsData as AboutStatsType } from "../../data/about/stats";

export interface Props {
  data: typeof AboutStatsType;
}

const { data } = Astro.props;
---

<section class="stats">
  <div class="wrap wrap--wide row" data-reveal-group>
    {data.map((stat) => (
      <div class="stat-item" data-reveal>
        <span class="stat-value font-display">{stat.value}</span>
        <span class="stat-label">{stat.label}</span>
      </div>
    ))}
  </div>
</section>

<style>
  .stats {
    background: var(--color-cream);
    padding-block: clamp(4rem, 8vw, 6.5rem);
  }
  .row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
  }
  .stat-item { display: grid; gap: 0.5rem; }
  .stat-value { font-size: clamp(2.6rem, 5vw, 4.2rem); color: var(--color-walnut); }
  .stat-label {
    font-size: 0.68rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-ink-soft);
  }
  @media (max-width: 800px) { .row { grid-template-columns: 1fr 1fr; } }
</style>
