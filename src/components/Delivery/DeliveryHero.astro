---
export interface Props {
  title: string;
  subtitle: string;
  image?: string;
}
const { title, subtitle, image = "/images/gallery/gallery-cta-1.jpg" } = Astro.props;
---

<section class="page-hero" aria-label="Delivery">
  <img src={image} alt="" />
  <div class="veil"></div>
  <div class="wrap copy">
    <p class="eyebrow light">Policies</p>
    <h1>{title}</h1>
    <p>{subtitle}</p>
  </div>
</section>
