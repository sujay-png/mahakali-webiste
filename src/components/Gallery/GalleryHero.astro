---
import { galleryHero } from "../../data/gallery/hero";
export interface Props { data: typeof galleryHero; }
const { data } = Astro.props;
---

<section class="page-hero" aria-label="Gallery">
  <img src={data.image} alt="" />
  <div class="veil"></div>
  <div class="wrap copy">
    <p class="eyebrow light">Gallery</p>
    <h1>{data.title}</h1>
    <p>{data.subtitle}</p>
  </div>
</section>

<style>
  @media (max-width: 640px) {
    .page-hero { min-height: 52vh; }
    .page-hero .copy { padding: 4rem var(--gutter) 2.75rem; }
    .page-hero h1 { margin: 0.65rem 0 0.75rem; }
    .page-hero p { line-height: 1.5; }
  }
</style>
