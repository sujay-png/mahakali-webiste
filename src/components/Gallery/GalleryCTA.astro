---
import { galleryCTA } from "../../data/gallery/cta";
import Icon from "../global/UI/Icon.astro";

export interface Props {
  data: typeof galleryCTA;
}

const { data } = Astro.props;
---

<section class="gallery-cta section section--ink">
  <div class="wrap wrap--wide cta-grid">
    <div class="cta-content">
      <p class="eyebrow light">Consultation</p>
      <h2>{data.title}</h2>
      <p class="lead">{data.subtitle}</p>
      <a class="btn btn-ghost-light" href="/contact">
        Schedule consultation
        <Icon name="arrow-right" />
      </a>
    </div>

    <div class="cta-slider-container">
      <div class="slider-wrapper" id="cta-slider">
        {data.images.map((img) => (
          <div class="slide">
            <img src={img} alt="Gallery Showcase" />
          </div>
        ))}
      </div>

      <div class="slider-nav">
        <button class="nav-btn" type="button" aria-label="Previous image" id="cta-prev">
          <Icon name="chevron-left" />
        </button>
        <button class="nav-btn" type="button" aria-label="Next image" id="cta-next">
          <Icon name="chevron-right" />
        </button>
      </div>
    </div>
  </div>
</section>

<script>
  function bindCtaSlider() {
    const slider = document.getElementById("cta-slider");
    const prev = document.getElementById("cta-prev");
    const next = document.getElementById("cta-next");
    if (!(slider instanceof HTMLElement) || slider.dataset.bound === "true") return;
    slider.dataset.bound = "true";
    prev?.addEventListener("click", () => {
      slider.scrollBy({ left: -slider.clientWidth, behavior: "smooth" });
    });
    next?.addEventListener("click", () => {
      slider.scrollBy({ left: slider.clientWidth, behavior: "smooth" });
    });
  }
  bindCtaSlider();
  document.addEventListener("astro:page-load", bindCtaSlider);
</script>

<style>
  .cta-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }
  .cta-content { display: grid; gap: 1.2rem; justify-items: start; }
  .cta-content h2 { color: #fff; max-width: 10ch; }
  .cta-content .lead { color: rgba(244,239,232,0.72); font-weight: 300; max-width: 36ch; }
  .cta-slider-container { position: relative; aspect-ratio: 4/3; overflow: hidden; }
  .slider-wrapper {
    display: flex;
    height: 100%;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .slider-wrapper::-webkit-scrollbar { display: none; }
  .slide { min-width: 100%; height: 100%; scroll-snap-align: start; }
  .slide img { width: 100%; height: 100%; object-fit: cover; }
  .slider-nav {
    position: absolute;
    inset: auto 1rem 1rem auto;
    display: flex;
    gap: 0.5rem;
  }
  .nav-btn {
    width: 44px;
    height: 44px;
    border: 1px solid rgba(255,255,255,0.5);
    color: #fff;
    display: grid;
    place-items: center;
  }
  @media (max-width: 800px) { .cta-grid { grid-template-columns: 1fr; } }
</style>
