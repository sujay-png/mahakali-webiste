---
import { galleryCategories } from "../../data/gallery/catalog";

export interface Props {
  data: typeof galleryCategories;
}

const { data } = Astro.props;
---

<section class="gallery-catalog wrap wrap--wide section">
  <div class="catalog-container">
    <div class="grid" data-reveal-group>
      {data.flatMap(category => category.items).map((item) => (
        <div class={`gallery-card ${item.colSpan === 4 ? "col-span-full" : ""}`} data-reveal="up">
          {!item.action ? (
            <>
              <div class="image-wrapper" data-media>
                <img src={item.image} alt={item.name} class="gallery-image" />
              </div>
              <div class="card-content">
                <h3 class="font-display">{item.name}</h3>
                <p>{item.category}</p>
              </div>
            </>
          ) : (
            <div class="card-content centered-content">
              {item.image && (
                <div class="hover-bg" style={`background-image: url('${item.image}')`}></div>
              )}
              <h3 class="font-display action-title">{item.name}</h3>
              <p class="action-text">{item.action}</p>
            </div>
          )}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .catalog-container { display: flex; flex-direction: column; gap: 5.5rem; }
  .category-title { margin: 0.6rem 0 2.2rem; max-width: 14ch; }
  
  .grid {
    column-count: 2;
    column-gap: 1rem;
  }
  @media (min-width: 768px) {
    .grid { column-count: 3; column-gap: 1.5rem; }
  }
  @media (min-width: 1024px) {
    .grid { column-count: 4; column-gap: 2rem; }
  }
  
  .gallery-card { 
    display: flex; 
    flex-direction: column; 
    cursor: pointer; 
    break-inside: avoid;
    margin-bottom: 2rem;
  }
  .gallery-card.col-span-full { 
    /* Col-span doesn't work well with column-count, so we'll just style the card nicely */
  }
  
  .image-wrapper { 
    overflow: hidden; 
    background: var(--color-cream); 
    border-radius: 16px;
    /* Use a slightly varying aspect ratio based on child elements if needed, 
       but removing the fixed aspect ratio allows natural image heights */
  }
  .gallery-image { 
    width: 100%; 
    height: auto;
    object-fit: cover; 
    display: block;
    max-height: 500px; /* Limit height to prevent huge images */
  }
  
  .card-content { padding: 0.8rem 0 0; }
  .card-content h3 { font-size: 1.25rem; margin-bottom: 0.15rem; }
  .card-content p { color: var(--color-ink-soft); font-weight: 300; font-size: 0.9rem; }
  
  .centered-content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    min-height: 180px;
    padding: 2rem;
    position: relative;
    overflow: hidden;
    background: var(--color-cream);
    border-radius: 16px;
  }
  .hover-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    opacity: 0;
    transition: opacity 0.5s var(--ease);
  }
  .hover-bg::after {
    content: "";
    position: absolute;
    inset: 0;
    background: rgba(36, 28, 24, 0.55);
  }
  .gallery-card:hover .hover-bg { opacity: 1; }
  .action-title, .action-text { position: relative; z-index: 2; transition: color 0.4s var(--ease); }
  .centered-content .action-title { font-size: 1.5rem; }
  .centered-content .action-text {
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin-top: 0.5rem;
  }
  .gallery-card:hover .centered-content .action-title,
  .gallery-card:hover .centered-content .action-text { color: #fff; }
  
  .load-more { text-align: left; margin-top: 1rem; }

  @media (max-width: 640px) {
    .catalog-container { gap: 3rem; }
    .grid { column-gap: 0.75rem; }
    .gallery-card { margin-bottom: 1.35rem; }
    .image-wrapper,
    .centered-content { border-radius: 12px; }
    .card-content { padding-top: 0.55rem; }
    .card-content h3 { font-size: 1.05rem; line-height: 1.05; }
    .card-content p { font-size: 0.78rem; line-height: 1.35; }
  }
</style>
