---
import { galleryCategories } from "../../data/gallery/catalog";

export interface Props {
  data: typeof galleryCategories;
}

const { data } = Astro.props;
---

<section class="gallery-catalog wrap wrap--wide section">
  <div class="catalog-container">
    {data.map((category) => (
      <div class="category-section">
        <p class="eyebrow">{category.title}</p>
        <h2 class="font-display category-title">{category.title}</h2>

        <div class="grid" data-reveal-group>
          {category.items.map((item) => (
            <div class={`gallery-card ${item.colSpan === 4 ? "col-span-full" : ""}`} data-reveal>
              {!item.action ? (
                <>
                  <div class="image-wrapper" data-media>
                    <img src={item.image} alt={item.name} class="gallery-image" />
                  </div>
                  <div class="card-content">
                    <h3 class="font-display">{item.name}</h3>
                    <p>{item.category}</p>
                  </div>
                </>
              ) : (
                <div class="card-content centered-content">
                  {item.image && (
                    <div class="hover-bg" style={`background-image: url('${item.image}')`}></div>
                  )}
                  <h3 class="font-display action-title">{item.name}</h3>
                  <p class="action-text">{item.action}</p>
                </div>
              )}
            </div>
          ))}
        </div>
      </div>
    ))}

    <div class="load-more">
      <button class="btn btn-outline" type="button">
        Load more catalog items
      </button>
    </div>
  </div>
</section>

<style>
  .catalog-container { display: flex; flex-direction: column; gap: 5.5rem; }
  .category-title { margin: 0.6rem 0 2.2rem; max-width: 14ch; }
  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.6rem;
  }
  @media (min-width: 768px) {
    .grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1024px) {
    .grid { grid-template-columns: repeat(4, 1fr); }
    .category-section:nth-child(1) .grid,
    .category-section:nth-child(2) .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .gallery-card { display: flex; flex-direction: column; cursor: pointer; }
  .gallery-card.col-span-full { }
  @media (min-width: 1024px) {
    .gallery-card.col-span-full { grid-column: span 4; }
  }
  .image-wrapper { overflow: hidden; aspect-ratio: 4/5; background: var(--color-cream); }
  .gallery-image { width: 100%; height: 100%; object-fit: cover; }
  .card-content { padding: 1.1rem 0 0; }
  .card-content h3 { font-size: 1.45rem; margin-bottom: 0.25rem; }
  .card-content p { color: var(--color-ink-soft); font-weight: 300; }
  .centered-content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 180px;
    padding: 2rem;
    position: relative;
    overflow: hidden;
    background: var(--color-cream);
  }
  .hover-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    opacity: 0;
    transition: opacity 0.5s var(--ease);
  }
  .hover-bg::after {
    content: "";
    position: absolute;
    inset: 0;
    background: rgba(36, 28, 24, 0.55);
  }
  .gallery-card:hover .hover-bg { opacity: 1; }
  .action-title, .action-text { position: relative; z-index: 2; }
  .centered-content .action-text {
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .gallery-card:hover .centered-content .action-title,
  .gallery-card:hover .centered-content .action-text { color: #fff; }
  .load-more { text-align: left; margin-top: 1rem; }
</style>
