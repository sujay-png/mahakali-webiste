---
import Layout from "../../layouts/Layout.astro";
import CollectionHero from "../../components/Products/CollectionHero.astro";
import ProductToolbar from "../../components/Products/ProductToolbar.astro";
import ProductGrid from "../../components/Products/ProductGrid.astro";
import CollectionCTA from "../../components/Products/CollectionCTA.astro";
import ProductSidebar from "../../components/Products/ProductSidebar.astro";

import { upholsteredHero, upholsteredFilters, upholsteredProducts } from "../../data/products/upholstered";
---

<Layout 
  title={`${upholsteredHero.title} | Mahakali Interiors`}
  description={upholsteredHero.description}
>
  <main class="collection-page">
    <CollectionHero 
      label={upholsteredHero.label}
      title={upholsteredHero.title}
      description={upholsteredHero.description}
      image={upholsteredHero.image}
    />
    
    <div class="content-wrapper">
      <div class="sidebar-column">
        <ProductSidebar />
      </div>
      
      <div class="main-column">
        <ProductToolbar 
          categoryName="Upholstered"
          totalResults={upholsteredFilters.totalResults}
          categories={upholsteredFilters.categories}
        />
        
        <ProductGrid products={upholsteredProducts} />
      </div>
    </div>
    
    <CollectionCTA />
  </main>
</Layout>

<style>
  .collection-page {
    /* Accounts for the fixed header height so it doesn't jump */
    /* Header is sticky so padding is not strictly required here if hero handles it, but good practice if needed */
  }

  .content-wrapper {
    max-width: 1450px;
    margin: 2rem auto;
    padding: 0 var(--gutter);
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 1024px) {
    .content-wrapper {
      grid-template-columns: 320px 1fr;
      gap: 3rem;
    }
  }

  .sidebar-column {
    /* Optional: position sticky if we want sidebar to scroll */
  }

  .main-column {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
</style>
