---
export const prerender = false;

import Layout from "../../../layouts/Layout.astro";
import ProductBreadcrumbs from "../../../components/Products/ProductDetails/ProductBreadcrumbs.astro";
import ProductInfo from "../../../components/Products/ProductDetails/ProductInfo.astro";
import ProductSpecs from "../../../components/Products/ProductDetails/ProductSpecs.astro";
import RelatedProducts from "../../../components/Products/ProductDetails/RelatedProducts.astro";
import ProductGallery from "../../../components/Products/ProductDetails/ProductGallery.tsx";
import Testimonials from "../../../components/Home/Testimonials.astro";
import { testimonials } from "../../../data/home";
import {
  getCategoryBySlug,
  categoryPath,
} from "../../../lib/woocommerce/categories";
import {
  getProductBySlug,
  getRelatedProducts,
} from "../../../lib/woocommerce/catalog";
import { featuresFromProduct } from "../../../lib/woocommerce/mappers";
import { stripHtml } from "../../../lib/woocommerce/format";
import { whatsappEnquire } from "../../../lib/enquire";
import { siteInfo } from "../../../data/site";

const categorySlug = Astro.params.category ?? "";
const slug = Astro.params.slug ?? "";
const category = getCategoryBySlug(categorySlug);
const product = await getProductBySlug(slug);

if (!category || !product) {
  return Astro.redirect(category ? categoryPath(category.slug) : "/products");
}

const features = featuresFromProduct(product);
const specifications = [
  { label: "Collection", value: category.name },
  { label: "SKU", value: product.sku },
  ...product.attributes,
  { label: "Availability", value: product.stockStatus },
];

const pageUrl = `${siteInfo.url}/products/${category.slug}/${product.slug}`;
const whatsappHref = whatsappEnquire(product.name, pageUrl);
const description =
  stripHtml(product.shortDescriptionHtml || product.descriptionHtml).slice(
    0,
    180,
  ) || product.name;

const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: product.name,
  sku: product.sku,
  image: product.images.map((img) => img.src),
  description,
  brand: { "@type": "Brand", name: siteInfo.legalName },
  offers: {
    "@type": "Offer",
    priceCurrency: "INR",
    price: product.rawPrice || undefined,
    availability: "https://schema.org/InStoreOnly",
    url: pageUrl,
  },
};
---

<Layout
  title={product.name}
  description={description}
  image={product.image}
  path={`/products/${category.slug}/${product.slug}`}
>
  <Fragment slot="head">
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(productSchema)}
    />
  </Fragment>

  <main class="product-details-page">
    <div class="content-wrapper">
      <ProductBreadcrumbs
        items={[
          { label: "Home", link: "/" },
          { label: "Collections", link: "/products" },
          { label: category.name, link: categoryPath(category.slug) },
          { label: product.name },
        ]}
      />

      <div class="product-grid-layout">
        <div class="gallery-column">
          <ProductGallery
            client:load
            images={product.images}
            title={product.name}
          />
        </div>
        <div class="info-column">
          <ProductInfo
            title={product.name}
            rating={product.stars}
            stars={product.stars}
            ratingCount={product.ratingCount}
            currentPrice={product.price}
            originalPrice={product.regularPrice}
            discountText={product.discountText}
            discountLabel={product.discountLabel}
            sku={product.sku}
            stockStatus={product.stockStatus}
            categoryName={category.name}
            categoryHref={categoryPath(category.slug)}
            whatsappHref={whatsappHref}
            excerptHtml={product.shortDescriptionHtml}
          >
            <ProductSpecs
              features={features}
              specifications={specifications}
              descriptionHtml={product.descriptionHtml}
              productCodeRef={product.sku}
            />
          </ProductInfo>
        </div>
      </div>

      <RelatedProducts server:defer product={product}>
        <div slot="fallback" class="related-masterpieces" style="margin-top: 5.5rem; padding-top: 3.5rem; border-top: 1px solid var(--color-line);">
          <p class="eyebrow" style="margin-bottom: 0.7rem;">Continue looking</p>
          <div class="skeleton-box" style="margin: 0.7rem 0 2.2rem; width: 200px; height: 40px;"></div>
          <div class="skeleton-related-grid">
            {Array.from({ length: 3 }).map(() => (
              <div class="related-card" style="display: grid; gap: 0.9rem;">
                <span class="skeleton-box" style="aspect-ratio: 4/5; width: 100%;"></span>
                <div class="related-info">
                  <div class="skeleton-box" style="width: 60%; height: 24px; margin-bottom: 8px;"></div>
                  <br />
                  <div class="skeleton-box" style="width: 30%; height: 16px;"></div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </RelatedProducts>
    </div>
    <Testimonials data={testimonials} />
  </main>
</Layout>

<style>
  .product-details-page {
    padding-top: 2rem;
    padding-bottom: 7rem;
  }
  .content-wrapper {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--gutter);
  }
  .product-grid-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: start;
  }
  @media (min-width: 1024px) {
    .product-grid-layout {
      grid-template-columns: 1.15fr 0.85fr;
      gap: 3.5rem;
    }
    .info-column {
      position: sticky;
      top: 6.5rem;
    }
  }

  .skeleton-related-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem 1rem;
  }
  @media (min-width: 768px) {
    .skeleton-related-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.6rem;
    }
  }
</style>
